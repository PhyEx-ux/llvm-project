      0004F2 E5 35            [12]  248         mov a,S_SEL
      0004F4 60 05            [24]  249         jz _tpu_add_lo
      0004F6 90 01 1F         [24]  250         mov dptr,#(_tpu_add_sled)
      0004F9 80 03            [24]  251         sjmp _tpu_add_go
      0004FB                        252 _tpu_add_lo:
      0004FB 90 01 30         [24]  253         mov dptr,#(_tpu_add_sled+TPU_SLED_LO)
      0004FE                        254 _tpu_add_go:
      0004FE E5 34            [12]  255         mov a,S_A
      000500 75 ED 1C         [24]  256         mov DMAIR,#0x1c
      000503 73               [24]  257         jmp @a+dptr
      000504                        258 _tpu_add_done:
      000504 75 3A 12         [24]  259         mov S_MARK,#0x12
      000507                        260         RESTREG
      000507 DA EB            [24]    1         pop dpx
      000509 DA 3B            [24]    2         pop dr12
      00050B DA 2B            [24]    3         pop dr8
      00050D DA 1B            [24]    4         pop dr4
      00050F DA 0B            [24]    5         pop dr0
      000511 D0 D1            [24]    6         pop PSW1
      000513 D0 D0            [24]    7         pop PSW
      000515 AA               [24]  261         eret
