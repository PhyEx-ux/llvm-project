                                    167 ; --- one multiply with a generous wait, then read the status --------------
                                    168 ; Also acts as the TFPU-presence discriminator: if the part does not implement
                                    169 ; TFPU, R4..R7 stay exactly as loaded (0x4079999A) instead of becoming
                                    170 ; 0x419F1EB8.  The second 0x33 is issued *after* the product was read out, so
                                    171 ; it shows the status at the "result consumed" moment.
      0003E1                        172 _tpu_mul_once:
      0003E1                        173         SAVEREGS
      0003E1 C0 D0            [24]    1         push PSW
      0003E3 C0 D1            [24]    2         push PSW1
      0003E5 CA 0B            [12]    3         push dr0
      0003E7 CA 1B            [12]    4         push dr4
      0003E9 CA 2B            [12]    5         push dr8
      0003EB CA 3B            [12]    6         push dr12
      0003ED CA EB            [12]    7         push dpx
      0003EF 7E 04 40 A3      [12]  174         mov wr0,#0x40A3         ; BR = 5.1f
      0003F3 7E 14 33 33      [12]  175         mov wr2,#0x3333
      0003F7 7E 24 40 79      [12]  176         mov wr4,#0x4079         ; AR = 3.9f
      0003FB 7E 34 99 9A      [12]  177         mov wr6,#0x999A
      0003FF 75 ED 1E         [24]  178         mov DMAIR,#0x1e
                                    179         .rept 64
                                    180         nop
                                    181         .endm
