                                      1 ; ---------------------------------------------------------------------------
                                      2 ; TFPU status / completion probe for STC32G12K128.
                                      3 ;
                                      4 ; WHY THIS EXISTS
                                      5 ; The manual documents command 0x33 as "read status register, result saved to
                                      6 ; R7" but never defines the status bit layout, and the official
                                      7 ; AI8051U_32_TFPU.LIB disassembles to "MOV DMAIR,#cmd ; RET" (zero wait).
                                      8 ; This module collects the raw evidence on real silicon:
                                      9 ;
                                     10 ;   * raw R7 / SFR 0xEF / SFR 0xFF before any TFPU command
                                     11 ;   * R7 after 0x33 at four moments: clean, after 0x31, after 0x32, after a
                                     12 ;     multiply (and again once the product has been read out)
                                     13 ;   * SFR 0xEF and 0xFF at the same moments
                                     14 ;   * the first NOP count n at which R4..R7 hold the correct IEEE-754 result
                                     15 ;     for mul (0x1E), add (0x1C) and sin (0x2D)
                                     16 ;
                                     17 ; IMPORTANT CORRECTION TO THE BRIEF
                                     18 ; The bytes following "MOV DMAIR,#0x33" in the official library are
                                     19 ;     A5 EF  ->  MOV A,R7    (Source-mode MOV A,Rn = [A5][E8+rn]; rn=7 -> EF)
                                     20 ;     A5 FF  ->  MOV R7,A    (Source-mode MOV Rn,A = [A5][F8+rn]; rn=7 -> FF)
                                     21 ; They are NOT reads of SFR 0xEF / 0xFF.  On this part 0xEF is AUXINTIF and
                                     22 ; 0xFF is RSTCFG; the official library touches neither.  The probe still samples
                                     23 ; both, purely as a control that they do not move.
                                     24 ;
                                     25 ; ORDERING CONTRACT (user requirement)
                                     26 ; Every TFPU action -- the 0x3E clock select and 0x31/0x32 included -- happens
                                     27 ; strictly after the first UART output.  main.c owns UART and prints a heartbeat
                                     28 ; before and after each stage; this module only issues a TFPU command when
                                     29 ; called from C.
                                     30 ;
                                     31 ; REGISTER BANKS
                                     32 ; Bank 0 is the reset default and is what the C compiler uses, so R0..R7 map to
                                     33 ; DATA 0x00..0x07 (BR = R0..R3 with MSB in R0, AR = R4..R7 with MSB in R4).  No
                                     34 ; bank switch is performed: the compiler is not running inside the timed window
                                     35 ; and every entry point saves/restores R0..R15, PSW, PSW1 and DPX.
                                     36 ;
                                     37 ; LATENCY MEASUREMENT
                                     38 ; Each command owns one shared run of TPU_SLED NOPs (see gen-sled.py).  The
                                     39 ; dispatcher jumps into that run so that exactly n NOPs execute before the
                                     40 ; snapshot: PC = sled + (TPU_SLED - n).  Since A is only 8 bits wide, two DPTR
                                     41 ; bases are used (lo: n <= 255, hi: n > 255); main.c pre-computes A and the
                                     42 ; selector.  Only "JMP @A+DPTR" sits between the DMAIR trigger and the sled, so
                                     43 ; the residual fixed overhead is a single instruction (documented, constant,
                                     44 ; and small relative to the 26..270-clock commands under test).
                                     45 ; ---------------------------------------------------------------------------
                                     46         .module mcs251_tfpu_probe
                                     47         .source
                                     48         .optsdcc stc32-mcs251 abi-major=1 abi-minor=0 target=mcs251 model=small stack-auto=0 xstack=0 intlong-reent=0 float-reent=0 reg-params=1 all-callee-saves=0 sdcccall=2 regset=r0-r9,r12-r15 compiler-build=mcs251-abi1.0-r1
                                     49         .globl _main, _start
                                     50         .globl _tpu_clk_sys, _tpu_init, _tpu_clr_exc
                                     51         .globl _tpu_raw, _tpu_read_state, _tpu_mul_once
                                     52         .globl _tpu_mul_at_n, _tpu_add_at_n, _tpu_sin_at_n
                                     53 
                                     54 ; SFRs
                           0000A8    55 IE      = 0xa8
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Intel MCS-251 (Source mode))       Page 2
Hexadecimal [24-Bits]



                           000088    56 TCON    = 0x88
                           0000D0    57 PSW     = 0xd0
                           0000D1    58 PSW1    = 0xd1
                           0000ED    59 DMAIR   = 0xed
                                     60 
                                     61 ; EDATA scratch / observation slots shared with main.c.  Fixed addresses only,
                                     62 ; so there are no C globals and therefore no XINIT / CRT data copy.
                                     63 ; 0x00..0x1F is the register bank and 0x20..0x2F is the bit-addressable area,
                                     64 ; hence the slots start at 0x0030.
                           000030    65 S_R7RAW = 0x0030        ; R7 read directly, no 0x33 issued
                           000031    66 S_R7    = 0x0031        ; R7 after 0x33
                           000032    67 S_EF    = 0x0032        ; SFR 0xEF (AUXINTIF)
                           000033    68 S_FF    = 0x0033        ; SFR 0xFF (RSTCFG)
                           000034    69 S_A     = 0x0034        ; dispatch byte for JMP @A+DPTR
                           000035    70 S_SEL   = 0x0035        ; 0 = lo sled base, 1 = hi sled base
                           000036    71 S_L4    = 0x0036        ; snapshot of R4..R7 (MSB first)
                           000037    72 S_L5    = 0x0037
                           000038    73 S_L6    = 0x0038
                           000039    74 S_L7    = 0x0039
                           00003A    75 S_MARK  = 0x003a        ; written last by each entry: completion witness
                                     76 
                                     77 ; Known operands and expected IEEE-754 single results (big-endian per window):
                                     78 ;   3.9f = 0x4079999A   5.1f = 0x40A33333   1.0f = 0x3F800000
                                     79 ;   mul  = 0x419F1EB8   add  = 0x41100000   sin(1.0f) = 0x3F576AA4
                                     80 
                                     81         .area HOME (CODE)
      000000 02 03 5D         [24]   82         ljmp _start
                                     83 
                                     84         .area VECS (CODE)
      000000                         85         .ds 8
                                     86 
                                     87         .area CSEG (CODE)
                                     88 
                                     89 ; Sled geometry and bodies.  Included here, before the dispatchers, because
                                     90 ; sdas251 resolves #(...) expressions where they appear: both the TPU_SLED*
                                     91 ; constants and the sled labels must already be known at the dispatch sites.
