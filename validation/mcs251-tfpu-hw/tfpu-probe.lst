                                    199 ; --- latency scans --------------------------------------------------------
                                    200 ; Operand windows: BR = R0..R3 (5.1f), AR = R4..R7 (3.9f or 1.0f).
                                    201 ; The dispatch byte/selector are computed in C *before* the call; the trigger
                                    202 ; is issued immediately before JMP @A+DPTR so nothing but the jump separates
                                    203 ; the command from the sled.
      000476                        204 _tpu_mul_at_n:
      000476                        205         SAVEREGS
      000476 C0 D0            [24]    1         push PSW
      000478 C0 D1            [24]    2         push PSW1
      00047A CA 0B            [12]    3         push dr0
      00047C CA 1B            [12]    4         push dr4
      00047E CA 2B            [12]    5         push dr8
      000480 CA 3B            [12]    6         push dr12
      000482 CA EB            [12]    7         push dpx
      000484 7E 04 40 A3      [12]  206         mov wr0,#0x40A3
      000488 7E 14 33 33      [12]  207         mov wr2,#0x3333
      00048C 7E 24 40 79      [12]  208         mov wr4,#0x4079
      000490 7E 34 99 9A      [12]  209         mov wr6,#0x999A
      000494 80 38            [24]  210         sjmp _tpu_dispatch_mul
                                    211 
      000496                        212 _tpu_add_at_n:
      000496                        213         SAVEREGS
      000496 C0 D0            [24]    1         push PSW
      000498 C0 D1            [24]    2         push PSW1
      00049A CA 0B            [12]    3         push dr0
      00049C CA 1B            [12]    4         push dr4
      00049E CA 2B            [12]    5         push dr8
      0004A0 CA 3B            [12]    6         push dr12
      0004A2 CA EB            [12]    7         push dpx
      0004A4 7E 04 40 A3      [12]  214         mov wr0,#0x40A3
      0004A8 7E 14 33 33      [12]  215         mov wr2,#0x3333
      0004AC 7E 24 40 79      [12]  216         mov wr4,#0x4079
      0004B0 7E 34 99 9A      [12]  217         mov wr6,#0x999A
      0004B4 80 3C            [24]  218         sjmp _tpu_dispatch_add
                                    219 
      0004B6                        220 _tpu_sin_at_n:
      0004B6                        221         SAVEREGS
      0004B6 C0 D0            [24]    1         push PSW
      0004B8 C0 D1            [24]    2         push PSW1
      0004BA CA 0B            [12]    3         push dr0
      0004BC CA 1B            [12]    4         push dr4
      0004BE CA 2B            [12]    5         push dr8
