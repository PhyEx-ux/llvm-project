                                    225 
                                    226 ; Dispatch: S_SEL picks the DPTR base (lo covers n <= 255, hi covers the rest),
                                    227 ; S_A carries the entry offset.  The DMAIR trigger is issued immediately before
                                    228 ; JMP @A+DPTR so only that single jump separates the command from the sled.
                                    229 ; Written out per command rather than macro-generated: sdas251 concatenates
                                    230 ; macro arguments with an apostrophe, which does not work inside #(...).
      0004CE                        231 _tpu_dispatch_mul:
      0004CE E5 35            [12]  232         mov a,S_SEL
      0004D0 60 05            [24]  233         jz _tpu_mul_lo
      0004D2 90 00 00         [24]  234         mov dptr,#(_tpu_mul_sled)
      0004D5 80 03            [24]  235         sjmp _tpu_mul_go
      0004D7                        236 _tpu_mul_lo:
      0004D7 90 00 11         [24]  237         mov dptr,#(_tpu_mul_sled+TPU_SLED_LO)
      0004DA                        238 _tpu_mul_go:
      0004DA E5 34            [12]  239         mov a,S_A
      0004DC 75 ED 1E         [24]  240         mov DMAIR,#0x1e
      0004DF 73               [24]  241         jmp @a+dptr
      0004E0                        242 _tpu_mul_done:
      0004E0 75 3A 11         [24]  243         mov S_MARK,#0x11
      0004E3                        244         RESTREG
      0004E3 DA EB            [24]    1         pop dpx
      0004E5 DA 3B            [24]    2         pop dr12
      0004E7 DA 2B            [24]    3         pop dr8
      0004E9 DA 1B            [24]    4         pop dr4
      0004EB DA 0B            [24]    5         pop dr0
      0004ED D0 D1            [24]    6         pop PSW1
      0004EF D0 D0            [24]    7         pop PSW
      0004F1 AA               [24]  245         eret
                                    246 
