; Strict SDLD command file for an MCS-251 validation image.
; Replace @OUTPUT_IHX@ and the four @...REL@ tokens before invoking sdld.
; SDLD command files use ; for comments; keep these explanations beside the
; switches and do not remove the ABI signature without updating every module.
-muwx
; -i selects Intel-Hex output.  sdld may append .ihx; rename/copy it to .hex
; before passing the image to QEMU (the MCS-251 loader keys on that suffix).
-i @OUTPUT_IHX@
; -M emits the memory allocation map, useful when diagnosing an overlap.
-M
; -I reserves the low internal address range used by the board monitor.
-I 0x0100
; -b fixes the logical memory areas to the STC32/QEMU memory map.
-b HOME = 0xff0000
-b XSEG = 0x10000
-b PSEG = 0x10000
-b ISEG = 0x0000
-b BSEG = 0x0000
; -A records and checks the complete compiler/target ABI signature.
-A stc32-mcs251 abi-major=1 abi-minor=0 target=mcs251 model=small stack-auto=0 xstack=0 intlong-reent=0 float-reent=0 reg-params=1 all-callee-saves=0 sdcccall=2 regset=r0-r9,r12-r15 compiler-build=mcs251-abi1.0-r1
; GSINIT0 must match crt0.asm's startup entry and is where reset reaches it.
-b GSINIT0 = 0xfc2800
; Inputs: self-maintained startup, C harness, optional LLVM module, provider.
@CRT0_REL@
@HARNESS_REL@
@MODULE_REL@
@PROVIDER_REL@
; -e terminates the command file and starts the link.
-e
