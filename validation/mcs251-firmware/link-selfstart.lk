; mcs251_ld.py command-file template for self-hosted startup images.
; Companion to crt-selfstart.asm; replaces link-template.lk for images that
; carry no SDCC-generated startup glue.  Substitute the three placeholder
; LINES at the bottom (output stem, crt .rel, module .rel) with real paths
; before invoking - keep substitutions off the comment lines:
;   python3 validation/mcs251-ld/mcs251_ld.py --mcs251-abi -f image.lk
; Grammar notes: one directive per line, ';' comments, no EMPTY lines (the
; sdld-family parser treats them as EOF), '-e' terminates.  mcs251_ld.py
; writes the output stem's .hex directly (the QEMU loader keys on that
; suffix).
-muwx
-i @OUTPUT_STEM@
-I 0x0100
; Vector-first layout.  HOME is a bare 3-byte reset trampoline; VECS is the
; 8-slot default-vector table at 0xFF0003+n*8; BOOT and CSEG follow in the
; same 64K bank.  ECALL/EJMP are 24-bit, so bank placement of CSEG is a
; readability choice, not a reachability requirement.
-b HOME = 0xff0000
-b VECS = 0xff0003
-b XINIT = 0xfe0000
-b BOOT = 0xff0100
-b CSEG = 0xff0200
; All code areas MUST be based explicitly: unbased CODE areas allocate from
; address 0, and QEMU stc32g144k246 forbids fetches below 0x800000. The crt
; always defines XINIT, even when empty, so its load-image base is unconditional.
; Do not add -b for other areas no module defines (e.g. XSEG/PSEG in a data-less
; image): mcs251_ld.py rejects bases for undefined areas.
-A stc32-mcs251 abi-major=1 abi-minor=0 target=mcs251 model=small stack-auto=0 xstack=0 intlong-reent=0 float-reent=0 reg-params=1 all-callee-saves=0 sdcccall=2 regset=r0-r9,r12-r15 compiler-build=mcs251-abi1.0-r1
@CRT_REL@
@MODULE_REL@
; Multi-module images: insert additional module .rel paths here, before -e.
-e
