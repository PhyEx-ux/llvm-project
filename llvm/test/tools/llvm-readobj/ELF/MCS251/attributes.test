# RUN: split-file %s %t
# RUN: yaml2obj %t/valid.yaml -o %t.valid.o
# RUN: llvm-readobj -A %t.valid.o 2>&1 | FileCheck %s --check-prefix=VALID
# RUN: yaml2obj %t/badvendor.yaml -o %t.badvendor.o
# RUN: llvm-readobj -A %t.badvendor.o 2>&1 | FileCheck %s --check-prefix=BADVENDOR
# RUN: yaml2obj %t/minor2.yaml -o %t.minor2.o
# RUN: llvm-readobj -A %t.minor2.o 2>&1 | FileCheck %s --check-prefix=MINOR2
# RUN: yaml2obj %t/missing27.yaml -o %t.missing.o
# RUN: llvm-readobj -A %t.missing.o 2>&1 | FileCheck %s --check-prefix=MISSING
#
# A4/W5 (design §8.3): llvm-readobj dumps the `.mcs251.attributes` carrier
# record by record -- envelope numbers, tag names, Critical bits, value
# types, lengths and values, MIX atoms included -- through the strict codec,
# and reports every malformed input as a warning carrying the codec's
# diagnostic instead of guessing.

# VALID:      MCS251Attributes {
# VALID-NEXT:   FormatVersion: 0x41
# VALID-NEXT:   VendorSize: 0xB2
# VALID-NEXT:   ScopeSize: 0xA7
# VALID-NEXT:   Records [
# VALID-NEXT:     Tag {
# VALID-NEXT:       Tag: 4
# VALID-NEXT:       Name: object_protocol_version
# VALID-NEXT:       Critical: Yes
# VALID-NEXT:       ValueType: U32 (1)
# VALID-NEXT:       Length: 4
# VALID-NEXT:       Value: 0x2
# VALID:           Name: call_abi_minor
# VALID-NEXT:       Critical: Yes
# VALID:           Value: 0x1
# VALID:           Name: register_parameter_variant
# VALID:           Value: 0x3
# VALID:           Name: general_register_set
# VALID:           Value: 0xF3FF
# VALID:           Name: as_layout_version
# VALID:           Value: 0x2
# VALID:           Name: default_placement
# VALID:           Value: 0x8
# VALID:           Name: init_protocol_version
# VALID:           Value: 0x2
# VALID:           Name: placement_protocol_version
# VALID:           Value: 0x2
# VALID:           Name: stack_contract_version
# VALID:           Value: 0x2
# VALID:           Name: function_contract_version
# VALID:           Value: 0x2
# VALID:           Name: required_capabilities_lo
# VALID:           Value: 0x0
# VALID:           Name: required_capabilities_hi
# VALID:           Value: 0x0
# VALID:           Name: abi_options
# VALID:           Value: 0x0
# VALID:           Name: memory_model_profile
# VALID:           ValueType: MIX (3)
# VALID-NEXT:       Length: 12
# VALID-NEXT:       Atoms [
# VALID-NEXT:         Atom {
# VALID-NEXT:           Type: U32 (1)
# VALID-NEXT:           Length: 4
# VALID-NEXT:           Value: 0x20
# VALID-NEXT:         }
# VALID-NEXT:         Atom {
# VALID-NEXT:           Type: U32 (1)
# VALID-NEXT:           Length: 4
# VALID-NEXT:           Value: 0x8
# VALID-NEXT:         }
# VALID-NEXT:       ]
# VALID:           Name: code_model_profile
# VALID:           Value: 0x1
# VALID:           Name: code_pointer_bits
# VALID:           Value: 0x20
# VALID:           Name: object_protocol_minor
# VALID:           Value: 0x0
# VALID-NEXT:     }
# VALID-NEXT:     Tag {
# VALID:           Tag: 28
# VALID-NEXT:       Name: function_signatures
# VALID-NEXT:       Critical: Yes
# VALID-NEXT:       ValueType: BYTES (4)
# VALID-NEXT:       Length: 4
# VALID-NEXT:       Value: (01 00 00 00)
# VALID-NEXT:     }
# VALID-NEXT:   ]
# VALID-NEXT: }

# BADVENDOR: warning: '{{.*}}': unable to decode the {{.*}}: MCS251 attributes: vendor is not exactly 7 bytes "MCS251\0"

# MINOR2: warning: '{{.*}}': unable to decode the {{.*}}: MCS251 attributes: call_abi_minor must be 1, got 2 (the A4-registered value is the only approved value)

# MISSING: warning: '{{.*}}': unable to decode the {{.*}}: MCS251 attributes: required object_protocol_minor(27) is missing
# RUN: yaml2obj %t/optu32.yaml -o %t.optu32.o
# RUN: llvm-readobj -A %t.optu32.o 2>&1 | FileCheck %s --check-prefix=OPTU32
# RUN: yaml2obj %t/optmix.yaml -o %t.optmix.o
# RUN: llvm-readobj -A %t.optmix.o 2>&1 | FileCheck %s --check-prefix=OPTMIX
#
# A4-FINAL-R1: unknown optional records are never schema-decoded, so they are
# displayed as raw bytes (never Scalar/MIX); the wrapping atom length in the
# MIX variant must terminate with finite output, and lld keeps accepting the
# object (unknown non-Critical tags stay skippable).

# OPTU32:        Tag: 256
# OPTU32-NEXT:   Name: <unallocated>
# OPTU32-NEXT:   Critical: No
# OPTU32-NEXT:   ValueType: U32 (1)
# OPTU32-NEXT:   Length: 4
# OPTU32-NEXT:   Value: (12 34 56 78)
# OPTU32-NEXT:   }
# OPTU32-NEXT: Tag {
# OPTU32:        Tag: 28
# OPTU32-NEXT:   Name: function_signatures
# OPTU32-NEXT:   Critical: Yes
# OPTU32-NEXT:   ValueType: BYTES (4)
# OPTU32-NEXT:   Length: 4
# OPTU32-NEXT:   Value: (01 00 00 00)
# OPTU32-NEXT:   }
# OPTU32-NEXT: ]
# OPTU32-NEXT: }
# OPTMIX:        Tag: 256
# OPTMIX-NEXT:   Name: <unallocated>
# OPTMIX-NEXT:   Critical: No
# OPTMIX-NEXT:   ValueType: MIX (3)
# OPTMIX-NEXT:   Length: 11
# OPTMIX-NEXT:   Value: (01 F5 FF FF FF FF FF FF FF FF 01)
# OPTMIX-NEXT:   }
# OPTMIX-NEXT: Tag {
# OPTMIX:        Tag: 28
# OPTMIX-NEXT:   Name: function_signatures
# OPTMIX-NEXT:   Critical: Yes
# OPTMIX-NEXT:   ValueType: BYTES (4)
# OPTMIX-NEXT:   Length: 4
# OPTMIX-NEXT:   Value: (01 00 00 00)
# OPTMIX-NEXT:   }
# OPTMIX-NEXT: ]
# OPTMIX-NEXT: }

#--- valid.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2MSB
  Type:    ET_REL
  Machine: EM_MCS251
Sections:
  - Name:  .mcs251.attributes
    Type:  0x70000003
    Content: 

