name: f
alignment: 1
tracksRegLiveness: true
constants:
  - id: 0
    value: 'i16 ptrtoint (ptr @flag to i16)'
    alignment: 1
body: |
  bb.0:
    ERET
...
;--- cp16-nested.mir
