  define void @f() { ret void }
...
---
name: f
alignment: 1
tracksRegLiveness: true
constants:
  - id: 0
    value: 'i16 add (i16 ptrtoint (ptr @flag to i16), i16 3)'
    alignment: 1
body: |
  bb.0:
    ERET
...

;--- inlineasm-c.mir
