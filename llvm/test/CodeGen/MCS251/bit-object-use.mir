  target triple = "mcs251"
  @flag = external global i8 #0
  attributes #0 = { "mcs251-bit-object" }
  define void @f() { ret void }
...
---
name: f
alignment: 1
tracksRegLiveness: true
body: |
  bb.0:
    INLINEASM &"mov wr0, #${0:c}", 1, 13, @flag
    ERET
...
