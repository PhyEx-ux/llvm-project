    MOV8id 8, $r0
    MOV8id 9, $r0
    MOV8id 10, $r0
    MOV8id 11, $r0
    MOV8id 12, $r0
    MOV8id 13, $r0
    MOV8id 14, $r0
    MOV8id 15, $r0
