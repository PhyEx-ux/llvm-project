#--- fwd127.mir
--- |
  target triple = "mcs251"
  define void @f() { ret void }
...
---
name: f
alignment: 1
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.2, %bb.1
    JB %bb.2, 0
    EJMP %bb.1
  bb.1:
    $r5 = MOV8ri 85
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
