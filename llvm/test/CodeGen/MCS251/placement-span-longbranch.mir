    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $r5 = ADD8ri $r5(tied-def 0), 1, implicit-def $psw
    $wr6 = MOV16ri 0
    MOV8mr $wr6, $r5
  bb.2:
    ERET
...

;--- placed.mir
--- |
  target triple = "mcs251-unknown-none"

  define void @lbf() addrspace(4) #0 {
  entry:
    ret void
  }

  !mcs251.signatures = !{!10000}
  !10000 = !{!"_lbf", i32 1, i32 0, i32 0}

  attributes #0 = { "mcs251-place"="0xFC7200,code,function,owned,0" "mcs251-stable-symbol"="lbf" }
...
---
name:            lbf
alignment:       1
body:             |
  bb.0:
