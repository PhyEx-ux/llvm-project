# RUN: split-file %s %t
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/all.mir -o %t/all.o
# RUN: llvm-objcopy --dump-section=.text=%t/all.bin %t/all.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert len(b) == 1000, 'full-corpus .text = %d bytes, expected 1000' % len(b)" %t/all.bin
#
# E2 (size-table audit): every opcode shape in
# MCS251InstrInfo::getInstSizeInBytes is emitted once here, so the AsmPrinter
# exact-size verification (target opt-in through getInstSizeVerifyMode: the
# MCS251 target returns ExactSizeAlways, the one mode that also runs in
# release builds, where upstream's ExactSize is compiled out under NDEBUG)
# cross-checks every declared size against the bytes the MC emitter actually
# produces.  The total-length assertion above is the NDEBUG-independent coarse
# net; the byte-exact pins below are the NDEBUG-independent fine net for the
# shapes this round fixed:
#
#   ECALLr           1 -> 2  (0x199 + specifier byte)
#   MOVAI            3 -> 2  (0x74 imm8; low nibble < 6, no A5 escape)
#   OR8a             3 -> 2  (native 0x4c + specifier byte)
#   MOV8a  r0-r7     1 -> 2  (classic form is A5-escaped: "mov a,r4" = A5 EC)
#   MOV8ra r0-r7     1 -> 2  (classic form is A5-escaped: "mov r3,a" = A5 FB)
#   MOV16mrS disp=0  4 -> 3  (short form; the size hook read the wrong
#                             displacement operand -- it is operand 1)
#
# RETI is not in the corpus because PEI wraps ISR functions in the fixed A6
# frame; its encoding is byte-pinned by isr-instructions.mir.
#
# The assertions run llc with -verify-machineinstrs; every scaffold register
# is defined before use and every result is sunk by a CMP, so RA cannot
# delete (rematerialize away) any instruction and shift the measurement.
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/mov8a_r4.mir -o %t/mov8a_r4.o
# RUN: llvm-objcopy --dump-section=.text=%t/mov8a_r4.bin %t/mov8a_r4.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7e405aa5eca5ffbe7001aa', b.hex()" %t/mov8a_r4.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/mov8ra_r3.mir -o %t/mov8ra_r3.o
# RUN: llvm-objcopy --dump-section=.text=%t/mov8ra_r3.bin %t/mov8ra_r3.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7441a5fbbe3001aa', b.hex()" %t/mov8ra_r3.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/ecallr.mir -o %t/ecallr.o
# RUN: llvm-objcopy --dump-section=.text=%t/ecallr.bin %t/ecallr.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7e0812349908aa', b.hex()" %t/ecallr.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/movai.mir -o %t/movai.o
# RUN: llvm-objcopy --dump-section=.text=%t/movai.bin %t/movai.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7455a5ffbe7001aa', b.hex()" %t/movai.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/or8a.mir -o %t/or8a.o
# RUN: llvm-objcopy --dump-section=.text=%t/or8a.bin %t/or8a.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7e205a4c2bbe2001aa', b.hex()" %t/or8a.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/mov16mrs_disp0.mir -o %t/mov16mrs_disp0.o
# RUN: llvm-objcopy --dump-section=.text=%t/mov16mrs_disp0.bin %t/mov16mrs_disp0.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7e0412347e1412341bfa10bd10aa', b.hex()" %t/mov16mrs_disp0.bin
# RUN: llc -mtriple=mcs251 -verify-machineinstrs -start-after=finalize-isel -mcs251-object-format=elf -filetype=obj %t/mov16mrs_disp4.mir -o %t/mov16mrs_disp4.o
# RUN: llvm-objcopy --dump-section=.text=%t/mov16mrs_disp4.bin %t/mov16mrs_disp4.o
# RUN: %python -c "import pathlib,sys; b=pathlib.Path(sys.argv[1]).read_bytes(); assert b.hex() == '7e0412347e141234791f0004bd10aa', b.hex()" %t/mov16mrs_disp4.bin

