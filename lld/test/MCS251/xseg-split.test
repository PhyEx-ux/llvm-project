    Type: STT_OBJECT
    Section: .mcs251.XSEG._big
#--- base65535.yaml
# G-T11-BASE base object: UNFLAGGED XSEG (v1 identity stays), patched to
# {65536, 65537, 131072} by matrix.py before each link.  The v1 identity
# carrier (the frozen 52-byte note) is required so the link reaches the
# G13b size gate instead of stopping at identity validation; the record
# section is deliberately absent -- the gate fires in layout, before any
# record parsing (design section 2.7.5 fixture shape).
--- !ELF
