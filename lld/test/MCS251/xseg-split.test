#--- unknownbit.yaml
# SM3 negative: an extra unknown ALLOC flag next to the split bit.
# The victim bit is 0x08000000, a processor-range bit that has no yaml2obj
# key for EM_MCS251; a `Flags:` list only accepts REGISTERED bit names (a
# raw number fails parsing with "unknown bit value"), so the raw sh_flags
# word is supplied through the ShFlags override -- the yaml2obj mechanism
# for hand-built invalid objects (ShFlags and Flags are mutually exclusive).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcs251.XSEG._big
    Type: SHT_NOBITS
    ShFlags: 0x48000003
    AddressAlign: 1
    Size: 65536
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  - Name: _big
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG._big
#--- overlaybit.yaml
# SM3 negative: OVERLAY rides next to the split bit.  ShFlags is used for
# the same reason as in unknownbit.yaml: the victim combination must be an
# exact raw word, and OVERLAY is expressible as a key name either way, but
# spelling the whole word keeps the shape identical to its sibling case.
--- !ELF
