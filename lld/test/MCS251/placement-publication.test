# SYMLINK-DANGLING: the same for a DANGLING link (design 9.2: the link
# itself is saved and restored, target content notwithstanding).
# RUN: mkdir -p i2 && cd i2 && ln -s gone.target out.map
# RUN: env FSFAIL='rename:out.report:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf
# RUN: test -L out.map && readlink out.map | FileCheck %s --check-prefix=DLNK && cd ..
# DLNK: gone.target

# SYMLINK-BK (R5-6): the backup creates a PERSISTENT copy of the old link
# before publishing, so a symlink() failure during backup is a clean
# pre-publication failure: every final keeps its old state and the link at the
# map path still points at its target.
# RUN: mkdir -p i3 && cd i3 && printf 'OLD-MAP-MMMM' > map.target && ln -s map.target out.map && printf 'OLD-REP-RRRR' > out.report
# RUN: env FSFAIL='symlink:' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WBKSYM
# RUN: test -L out.map && readlink out.map | FileCheck %s --check-prefix=DLNK2 && printf 'OLD-REP-RRRR' > r.ref && cmp out.report r.ref && ls | not grep -E '\.tmp$|\.pubbk\.' && cd ..
# DLNK2: map.target
# WBKSYM: cannot back up map
# SYMLINK-RESTORE-FAIL (R5-6): when the restore rename itself fails, the
# persistent backup is RETAINED and its path is reported (it is a symlink
# carrying the old target), so the user can recover the old state.
# RUN: mkdir -p i4 && cd i4 && printf 'OLD-MAP-MMMM' > map.target && ln -s map.target out.map && printf 'OLD-REP-RRRR' > out.report
# RUN: env FSFAIL='rename:out.report:1,rename:.pubbk.:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=ERESTSYM
# RUN: test -L .out.map.pubbk.* && readlink .out.map.pubbk.* | FileCheck %s --check-prefix=DLNK3 && cd ..
# DLNK3: map.target
# ERESTSYM: could not be fully restored
# ERESTSYM: out.map (backup:

# PRIV-CLOSE (R5-7): a CLOSE failure on a private audit file (the real
# descriptor is closed first, then EIO is reported, so no fd-lifetime
# artifact can be responsible) is a CONTROLLED error: rc=1, the private
# workspace is cleaned and every old final keeps its bytes.
# RUN: mkdir -p g1 && cd g1 && printf 'OLD-ELF-EEEE' > out.elf && printf 'OLD-REP-RRRR' > out.report && printf 'OLD-MAP-MMMM' > out.map
# RUN: env TMPDIR=. FSFAIL='close:out.elf:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WCLOSE
