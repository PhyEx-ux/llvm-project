# RMIX: cannot replace placement report

# CONFLICT keep-items (R3-4/R3-5 through the transaction path).
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=product --map=x.map -o product.tmp | FileCheck %s --check-prefix=CONF
# RUN: cp m.o source.tmp && %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 source.tmp --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=source --map=y.map -o z.elf | FileCheck %s --check-prefix=CONF
# RUN: cmp source.tmp m.o
# CONF: conflicts with another input or output

#--- fsfail.c
#define _GNU_SOURCE
#include <dlfcn.h>
#include <errno.h>
#include <fcntl.h>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define MAXTRK 128
#define MAXSPEC 16
struct spec { const char *op; const char *sub; int n; int used; };
static struct spec specs[MAXSPEC];
static int nspec;
static int trk_fd[MAXTRK];
static char trk_path[MAXTRK][4096];
static int ntrk;

__attribute__((constructor)) static void init(void) {
  const char *env = getenv("FSFAIL");
  if (!env || !*env)
    return;
  char *buf = strdup(env);
  for (char *tok = strtok(buf, ","); tok && nspec < MAXSPEC;
       tok = strtok(NULL, ",")) {
    char *c1 = strchr(tok, ':');
    if (!c1)
      continue;
    *c1 = 0;
    char *sub = c1 + 1;
    int n = 1;
    char *c2 = strchr(sub, ':');
    if (c2) {
      *c2 = 0;
      n = atoi(c2 + 1);
    }
    specs[nspec].op = strdup(tok);
    specs[nspec].sub = strdup(sub);
    specs[nspec].n = n < 1 ? 1 : n;
    specs[nspec].used = 0;
    nspec++;
  }
}

static int injected_errno(void) {
  const char *e = getenv("FSFAIL_ERRNO");
  return e && *e ? atoi(e) : 5;
}
static const char *op_family(const char *op) {
  if (strcmp(op, "unlink") == 0)
    return "remove";
  return op;
}
static int fail_call2(const char *op, const char *a, const char *b) {
  if (!nspec)
    return 0;
  const char *fam = op_family(op);
  for (int i = 0; i < nspec; i++) {
    if (strcmp(op_family(specs[i].op), fam) != 0)
      continue;
    int hit = (a && strstr(a, specs[i].sub)) || (b && strstr(b, specs[i].sub));
    if (!hit)
      continue;
    specs[i].used++;
    if (specs[i].used == specs[i].n)
      return 1;
  }
  return 0;
}
static int want_track(const char *path) {
  for (int i = 0; i < nspec; i++)
    if ((strcmp(specs[i].op, "write") == 0 || strcmp(specs[i].op, "close") == 0)
        && path && strstr(path, specs[i].sub))
      return 1;
  return 0;
}
static void track(int fd, const char *path) {
  if (fd < 0 || !want_track(path) || ntrk >= MAXTRK)
    return;
  trk_fd[ntrk] = fd;
  snprintf(trk_path[ntrk], sizeof(trk_path[ntrk]), "%s", path);
  ntrk++;
}
static const char *lookup(int fd) {
  for (int i = 0; i < ntrk; i++)
    if (trk_fd[i] == fd)
      return trk_path[i];
  return NULL;
}
int open(const char *path, int flags, ...) {
  static int (*real)(const char *, int, ...);
  if (!real)
    real = dlsym(RTLD_NEXT, "open");
  mode_t mode = 0;
  if (flags & O_CREAT) {
    va_list ap;
    va_start(ap, flags);
    mode = (mode_t)va_arg(ap, int);
    va_end(ap);
  }
  if (fail_call2("open", path, NULL)) {
    errno = injected_errno();
    return -1;
  }
  int fd = real(path, flags, mode);
  track(fd, path);
  return fd;
}
ssize_t write(int fd, const void *buf, size_t n) {
  static ssize_t (*real)(int, const void *, size_t);
  if (!real)
    real = dlsym(RTLD_NEXT, "write");
  const char *p = lookup(fd);
  if (p && fail_call2("write", p, NULL)) {
    errno = injected_errno();
    return -1;
  }
  return real(fd, buf, n);
}
int close(int fd) {
  static int (*real)(int);
  if (!real)
    real = dlsym(RTLD_NEXT, "close");
  const char *p = lookup(fd);
  if (p && fail_call2("close", p, NULL)) {
    // R5-7: close the REAL descriptor first, then report EIO, so the test
    // proves the error path itself (an unclosed fd cannot be the cause).
    real(fd);
    errno = injected_errno();
    return -1;
  }
  return real(fd);
}
int symlink(const char *target, const char *linkpath) {
  static int (*real)(const char *, const char *);
  if (!real)
    real = dlsym(RTLD_NEXT, "symlink");
  if (fail_call2("symlink", target, linkpath)) {
    errno = injected_errno();
    return -1;
  }
  return real(target, linkpath);
}
int rename(const char *old, const char *new) {
  static int (*real)(const char *, const char *);
  if (!real)
    real = dlsym(RTLD_NEXT, "rename");
  if (fail_call2("rename", old, new)) {
    errno = injected_errno();
    return -1;
  }
  return real(old, new);
}
int link(const char *old, const char *new) {
  static int (*real)(const char *, const char *);
  if (!real)
    real = dlsym(RTLD_NEXT, "link");
  if (fail_call2("link", old, new)) {
    errno = injected_errno();
    return -1;
  }
  return real(old, new);
}
int unlink(const char *path) {
  static int (*real)(const char *);
  if (!real)
    real = dlsym(RTLD_NEXT, "unlink");
  if (fail_call2("unlink", path, NULL)) {
    errno = injected_errno();
    return -1;
  }
  return real(path);
}
int remove(const char *path) {
  static int (*real)(const char *);
  if (!real)
    real = dlsym(RTLD_NEXT, "remove");
  if (fail_call2("remove", path, NULL)) {
    errno = injected_errno();
    return -1;
  }
  return real(path);
}

#--- v2.py
import sys
for name in sys.argv[1:]:
    b = bytearray(open(name, 'rb').read())
    b[36:40] = bytes.fromhex('00000102')
    open(name, 'wb').write(bytes(b))

#--- obj.yaml
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:  []
