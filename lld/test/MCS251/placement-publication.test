# WBKO: cannot back up output out.elf

# MIXED: only the map pre-exists; the report publish fails -> the map is
# restored and the never-existing artifacts stay absent.
# RUN: mkdir -p l1 && cd l1 && printf 'OLD-MAP-MMMM' > out.map
# RUN: env FSFAIL='rename:out.report:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=RMIX
