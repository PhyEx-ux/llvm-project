# RUN: env TMPDIR=. FSFAIL='close:out.placement.tmp:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WCLOSE2
# RUN: printf 'OLD-ELF-EEEE' > a.ref && cmp out.elf a.ref && ls | not grep -E 'mcs251-placement-audit|\.tmp$|\.pubbk\.' && cd ..
# WCLOSE2: cannot write temporary placement report
# RUN: mkdir -p g3 && cd g3 && printf 'OLD-ELF-EEEE' > out.elf && printf 'OLD-REP-RRRR' > out.report && printf 'OLD-MAP-MMMM' > out.map
# RUN: env TMPDIR=. FSFAIL='close:out.map.tmp:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WCLOSE3
# RUN: printf 'OLD-ELF-EEEE' > a.ref && cmp out.elf a.ref && ls | not grep -E 'mcs251-placement-audit|\.tmp$|\.pubbk\.' && cd ..
