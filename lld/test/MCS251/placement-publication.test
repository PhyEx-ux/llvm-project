# BK-LINKFAIL: hard-link backup unavailable -> the byte-copy fallback
# completes BEFORE publication and the run SUCCEEDS cleanly.
# RUN: mkdir -p k1 && cd k1 && printf 'OLD-ELF-EEEE' > out.elf
# RUN: env FSFAIL='link:.pubbk' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf
# RUN: cmp out.elf ../ok.elf && ls | not grep -E '\.tmp$|\.pubbk\.|\.probe\.' && cd ..
# BK-OPENFAIL: even the unique backup NAME cannot be created -> failure
# BEFORE the first replacement; the old bytes survive untouched.
