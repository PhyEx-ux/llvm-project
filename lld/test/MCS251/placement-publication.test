# G11-D2 (design section 9.5 / 11.5): the audit publication transaction,
# resident end-to-end on the real file system.  Fixed-point operation
# failures (rename/unlink/write at an exact ordinal) are injected through
# fsfail.so, a TEST-ONLY LD_PRELOAD shim compiled by this test; no
# production environment switch exists.  Every restore assertion is a BYTE
# comparison against the old content, never a mere path check.
#
# The shim needs a host C compiler (cc); it fails loudly if none exists.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: cc -shared -fPIC -o fsfail.so fsfail.c -ldl
# RUN: yaml2obj obj.yaml -o t.o && %python v2.py t.o && mv t.o m.o

# W: the window set every link uses.
# SUCCESS: all three artifacts publish; a second run in another directory
# produces byte-identical artifacts (deterministic carrier), and no temp,
# backup or probe residue is left behind.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=ok.placement --map=ok.map -o ok.elf
# RUN: mkdir -p d2 && cp m.o d2/m.o && cd d2 && %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=ok.placement --map=ok.map -o ok.elf && cd ..
# RUN: cmp ok.elf d2/ok.elf && cmp ok.map d2/ok.map && cmp ok.placement d2/ok.placement
# RUN: ls | not grep -E '\.tmp$|\.pubbk\.|\.probe\.' 

# STG-FILE: a pre-existing ordinary report.tmp survives byte-exactly and the
# run fails before anything is published.
# RUN: mkdir -p s1 && cd s1 && printf 'PRE-EXISTING-TMP' > out.report.tmp && printf 'OLD-ELF-EEEE' > out.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=OPENTMP
# RUN: printf 'PRE-EXISTING-TMP' > a.ref && printf 'OLD-ELF-EEEE' > b.ref && cmp out.report.tmp a.ref && cmp out.elf b.ref && cd ..
# OPENTMP: cannot open temporary placement report

# STG-DIR: a directory parked at the staging path is refused up front and
# its content survives.
# RUN: mkdir -p s2/out.report.tmp/keep && cd s2 && echo keep > out.report.tmp/keep/x.orig && cp out.report.tmp/keep/x.orig out.report.tmp/keep/x && printf 'OLD-ELF-EEEE' > out.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=OPENTMP2
