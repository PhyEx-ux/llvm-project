# PROBE-RM (R5-8): a cleanup failure of THIS run's own pre-flight probe file
# is reported by name, never silently accepted as "no residue".
# RUN: mkdir -p g4 && cd g4 && printf 'OLD-ELF-EEEE' > out.elf
# RUN: env FSFAIL='remove:.probe.:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WPROBE
# RUN: printf 'OLD-ELF-EEEE' > a.ref && cmp out.elf a.ref && ls out.elf.probe.* && cd ..
# WPROBE: cannot remove the output probe file

# STG-WRITE: a write failure on the ELF staging file (design 9.5 final
# staging) -- nothing has been published yet, every final keeps its old
# bytes and no temp/backup residue survives.
# RUN: mkdir -p j1 && cd j1 && printf 'OLD-MAP-MMMM' > out.map && printf 'OLD-REP-RRRR' > out.report && printf 'OLD-ELF-EEEE' > out.elf
# RUN: env FSFAIL='write:out.elf.tmp' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WSTG
