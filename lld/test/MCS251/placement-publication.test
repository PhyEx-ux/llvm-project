# WBU: warning: cannot remove the publication backup

# SYMLINK: a symlink at the map final is restored AS A LINK (the link
# target keeps its old bytes).
# RUN: mkdir -p i1 && cd i1 && printf 'OLD-MAP-MMMM' > map.target && ln -s map.target out.map && printf 'OLD-REP-RRRR' > out.report
