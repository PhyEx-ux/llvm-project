# RUN: env FSFAIL='rename:out.elf:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=RELF
# RUN: printf 'OLD-MAP-MMMM' > a.ref && printf 'OLD-REP-RRRR' > b.ref && printf 'OLD-ELF-EEEE' > c.ref && cmp out.map a.ref && cmp out.report b.ref && cmp out.elf c.ref && cd ..
# RELF: cannot replace output

# REN-NONE: nothing pre-existed and the ELF publish fails -> NO artifact at
# all is left behind.
# RUN: mkdir -p r4 && cd r4
# RUN: env FSFAIL='rename:out.elf:1' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf
