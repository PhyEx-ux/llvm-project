# COMMIT-CLEANUP: the post-commit backup cleanup fails -> the run still
# SUCCEEDS with a warning and the backup is retained.
# RUN: mkdir -p f1 && cd f1 && printf 'OLD-ELF-EEEE' > out.elf
# RUN: env FSFAIL='remove:.pubbk.:2' LD_PRELOAD=../fsfail.so %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ../m.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=out.report --map=out.map -o out.elf | FileCheck %s --check-prefix=WBU
