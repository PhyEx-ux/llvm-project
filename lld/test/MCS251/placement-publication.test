# RUN: printf 'OLD-MAP-MMMM' > a.ref && printf 'OLD-REP-RRRR' > b.ref && printf 'OLD-ELF-EEEE' > c.ref && cmp out.map a.ref && cmp out.report b.ref && cmp out.elf c.ref && cd ..
# RREP: cannot replace placement report

# REN-ELF: the ELF publish rename fails -> map AND report are restored.
