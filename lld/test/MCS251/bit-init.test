#--- nit.yaml
# One automatic bit with a nonzero initial value: the synthesized XINIT record
# is 7 bytes and must be range-checked at XINIT=0xffffff.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.bit
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '0101010100000000'
  - Name: .rela.mcs251.bit
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.bit
    Relocations:
      - Offset: 0x4
        Type: 10
        Symbol: z
        Addend: 0
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: z
    Type: STT_OBJECT
    Binding: STB_GLOBAL
    Section: .mcs251.bit
    Value: 0x0
    Size: 1
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0
    Size: 0

#--- onebit.yaml
# One automatic bit with a nonzero initial value and NO __mcs251_globals_init:
# the value could never be applied, so the link must fail closed rather than
# silently emit a bit object whose declared initial value is unrealized.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
