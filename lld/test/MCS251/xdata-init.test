#--- roptr-notype.yaml
# X3-R8: roptr.yaml with the STT_OBJECT definition changed to STT_NOTYPE --
# a legal input form (loadFile accepts STT_NOTYPE).  The channel is decided
# by the target's definition section, not its symbol type.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.rodata
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .rodata
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: xobj
        Addend: -65536
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: xobj
    Binding: STB_GLOBAL
    Type: STT_NOTYPE
    Section: .mcs251.XSEG.xobj

#--- roptr-notype-alias.yaml
# X3-R8: the referenced STT_NOTYPE symbol shares the slice with a
# same-address STT_OBJECT definition of size 8.  The reference resolves to
# the NOTYPE symbol, so a type-based channel test skips the gate.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.rodata
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .rodata
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: xobj
        Addend: -65536
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: xobj
    Binding: STB_GLOBAL
    Type: STT_NOTYPE
    Section: .mcs251.XSEG.xobj
  - Name: real_object
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Size: 8
    Section: .mcs251.XSEG.xobj

#--- notype-def.yaml
# X3-R8 cross-TU definition side: an STT_NOTYPE global defined in the XSEG
# slice (the shape a second TU contributes for an alias-style reference).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _alias
    Binding: STB_GLOBAL
    Type: STT_NOTYPE
    Section: .mcs251.XSEG.xobj

#--- notype-use.yaml
# X3-R8 cross-TU use side, the exact llc-emitted shape: the read-only
# pointer container is a 4-byte STT_OBJECT in .text (the MCS251 backend
# places read-only globals in the text section), zero MSB at container
# offset 0 and the R_MCS251_24 field at offsets 1..3 against the UNDEF
# STT_NOTYPE _alias.  Wrong-bank addend, must fail closed.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.text
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: _alias
        Addend: -65536
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _p
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Size: 4
    Section: .text
  - Name: _alias
    Binding: STB_GLOBAL
    Type: STT_NOTYPE

#--- notype-use-ok.yaml
# X3-R8 positive twin of notype-use.yaml: the same executable-image
# container with an in-range addend (4 into the 8-byte slice at 0x010000).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.text
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: _alias
        Addend: 4
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _p
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Size: 4
    Section: .text
  - Name: _alias
    Binding: STB_GLOBAL
    Type: STT_NOTYPE
