    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.xdata_ini
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
