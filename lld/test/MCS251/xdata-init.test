#
# X3: `.mcs251.xdata_init` record validation matrix.
#  - legal records allocate in the XDATA_INIT CODE-class area with boundary
#    symbols s_XDATA_INIT/l_XDATA_INIT
#  - destination to the slice's last byte succeeds; beyond it fails
#  - a record spanning a 64K window boundary is rejected (belt-and-braces;
#    the allocator never produces such a placement)
#  - two records with overlapping destinations are rejected
#  - payload size must be 0 or the full object size
#  - truncated records are rejected
#  - pointer initial values through the 24-bit channel: a DSEG object
#    (XINIT payload) holding an XSEG pointer, and a CODE pointer table;
#    R_MCS251_16/J16 against an XSEG symbol is a hard truncation error
#  - X3-R2: a stored pointer is a BIG-ENDIAN 4-byte container whose low 24
#    bits are the canonical address -- literal zero most-significant byte
#    at the container start, R_MCS251_24 field at container offsets 1..3
#    (bank at 1, window big-endian at 2..3). A symbol at 0x011234 links to
#    00 01 12 34, and the X2 load sequence routes byte 1 to DPXL and bytes
#    2..3 to DPH:DPL.
#  - X3-R3: a stored pointer whose target is an XSEG object must resolve
#    inside that object's allocated slice; one-past-end is the last legal
#    value, wrong-bank and beyond-object addends are hard errors (in the
#    XINIT payload and in a CSEG read-only data image alike)
#  - X3-R8: the stored-pointer channel is identified by the target's final
#    belonging (its definition section resolves to XSEG), never by the
#    referenced symbol's STT type -- a NOTYPE definition, a same-address
#    STT_OBJECT alias and a cross-TU UNDEF NOTYPE resolution are gated
#    alike, and an llc-shaped container in the executable read-only image
#    (.text) with an in-range NOTYPE target still links
#
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: yaml2obj ok.yaml -o ok.o
# RUN: yaml2obj lastbyte.yaml -o lastbyte.o
# RUN: yaml2obj beyond.yaml -o beyond.o
# RUN: yaml2obj straddle.yaml -o straddle.o
# RUN: yaml2obj overlap.yaml -o overlap.o
# RUN: yaml2obj badpayload.yaml -o badpayload.o
# RUN: yaml2obj truncated.yaml -o truncated.o
# RUN: yaml2obj ptr.yaml -o ptr.o
# RUN: yaml2obj ptrbank.yaml -o ptrbank.o
# RUN: yaml2obj ptrpast.yaml -o ptrpast.o
# RUN: yaml2obj wrongptr.yaml -o wrongptr.o
# RUN: yaml2obj ptrbeyond.yaml -o ptrbeyond.o
# RUN: yaml2obj roptr.yaml -o roptr.o
# RUN: yaml2obj roptr-notype.yaml -o roptr-notype.o
# RUN: yaml2obj roptr-notype-alias.yaml -o roptr-notype-alias.o
# RUN: yaml2obj notype-def.yaml -o notype-def.o
# RUN: yaml2obj notype-use.yaml -o notype-use.o
# RUN: yaml2obj notype-use-ok.yaml -o notype-use-ok.o
# RUN: yaml2obj trunc16.yaml -o trunc16.o
# RUN: yaml2obj truncj16.yaml -o truncj16.o
# RUN: yaml2obj prefix.yaml -o prefix.o
# RUN: yaml2obj nearmiss1.yaml -o nearmiss1.o
# RUN: yaml2obj nearmiss2.yaml -o nearmiss2.o

# --- legal records: clear-only and payload forms; boundary symbols ---
# RUN: mcs251-lld ok.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 --map=%t/ok.map -o %t/ok.elf \
# RUN:   && test -f %t/ok.elf
# RUN: grep 's_XDATA_INIT = 0xff9000' %t/ok.map
# RUN: grep 'l_XDATA_INIT = 0x0016' %t/ok.map

# --- destination ending exactly at the slice's last byte succeeds ---
# RUN: mcs251-lld lastbyte.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/lb.elf && test -f %t/lb.elf

# --- destination ending one byte past the slice is rejected ---
# RUN: not mcs251-lld beyond.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/beyond.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BEYOND
# BEYOND: XDATA_INIT destination is not within one XSEG slice: [0x10010,0x10021) in .mcs251.xdata_init

# --- a hand-made record spanning a 64K window is rejected ---
# RUN: not mcs251-lld straddle.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x01ff00 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/strad.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=STRAD
# STRAD: XDATA_INIT record in .mcs251.xdata_init spans a 64K window boundary: [0x1fff8,0x20008)

# --- two records with overlapping destinations are rejected ---
# RUN: not mcs251-lld overlap.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/ovl.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=OVL
# OVL: XDATA_INIT record destinations overlap: [0x10000,0x10008) from .mcs251.xdata_init and [0x10004,0x1000c) from .mcs251.xdata_init

# --- payload size must be 0 or exactly the object size ---
# RUN: not mcs251-lld badpayload.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/bp.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BP
# BP: invalid XDATA_INIT record in .mcs251.xdata_init

# --- truncated record header is rejected ---
# RUN: not mcs251-lld truncated.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/tr.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=TR
# TR: truncated XDATA_INIT record in .mcs251.xdata_init

# --- pointer initializers: XINIT payload holds an XSEG pointer (R_MCS251_24);
# --- a CODE pointer table resolves in CSEG; both link and apply ---
# RUN: mcs251-lld ptr.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 --map=%t/ptr.map -o %t/ptr.elf \
# RUN:   && test -f %t/ptr.elf
# XINIT payload: the DSEG slot at 0x40 receives the pointer as the big-endian
# 4-byte container -- zero most-significant byte, then the 24-bit value of
# xobj (0x010000) as bank/window lanes.
# RUN: %python %S/Inputs/dump-elf-bytes.py %t/ptr.elf 0xff8000 10 | FileCheck %s --check-prefix=XPTR
# XPTR: 00 40 00 04 00 04 00 01 00 00
# CODE pointer table (the full 24-bit container and the byte-split form both
# resolve to the .text entry at 0xff0200, each with its zero MSB first).
# RUN: %python %S/Inputs/dump-elf-bytes.py %t/ptr.elf 0xff0201 8 | FileCheck %s --check-prefix=CPTR
# CPTR: 00 ff 02 00 00 ff 02 00

# --- lane comparison: the same container for an object at 0x011234 splits
# --- bank/window exactly the way the X2 load sequence consumes it: byte 0
# --- = 0 (bits [31:24]), byte 1 = 0x01 -> DPXL, bytes 2..3 = 0x12 0x34 ->
# --- DPH:DPL. The linked 24-bit value is 0x011234, never 0x123400.
# RUN: mcs251-lld ptrbank.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x011234 \
# RUN:   --area-start=XDATA_INIT=0xff9000 --map=%t/ptrbank.map -o %t/ptrbank.elf \
# RUN:   && test -f %t/ptrbank.elf
# RUN: grep 'XSEG.xobj 0x11234 +0x8' %t/ptrbank.map
# RUN: %python %S/Inputs/dump-elf-bytes.py %t/ptrbank.elf 0xff8000 10 | FileCheck %s --check-prefix=XPTRB
# XPTRB: 00 40 00 04 00 04 00 01 12 34

# --- one-past-end is the last legal stored pointer value (ruling): addend
# --- == object size links and serializes the slice end address ---
# RUN: mcs251-lld ptrpast.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/ptrpast.elf && test -f %t/ptrpast.elf
# RUN: %python %S/Inputs/dump-elf-bytes.py %t/ptrpast.elf 0xff8000 10 | FileCheck %s --check-prefix=XPAST
# XPAST: 00 40 00 04 00 04 00 01 00 08

# --- X3-R3 wrong bank: the XSEG object is allocated at 0x010000 but the
# --- stored pointer resolves to 0x000000 (addend -0x10000) -- a dangling
# --- wrong-bank value that no longer links silently ---
# RUN: not mcs251-lld wrongptr.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/wp.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=WPTR
# WPTR: stored XDATA pointer in .mcs251.xinit resolves outside the target object xobj: 0x0000 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R3 beyond one-past-end: addend 9 on an 8-byte object is rejected ---
# RUN: not mcs251-lld ptrbeyond.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/pb.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BPTR
# BPTR: stored XDATA pointer in .mcs251.xinit resolves outside the target object xobj: 0x10009 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R3 read-only data channel: an .rodata (CSEG) pointer table entry
# --- against an XSEG object with a wrong-bank addend is equally gated; a
# --- plain code R_MCS251_24 (call/EJMP, STT_FUNC target) is not ---
# RUN: not mcs251-lld roptr.o --area-start=CSEG=0xff0200 --area-start=DSEG=0x40 \
# RUN:   --area-start=XINIT=0xff8000 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/rp.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RPTR
# RPTR: stored XDATA pointer in .rodata resolves outside the target object xobj: 0x0000 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R8 NOTYPE direct reference: only the STT type differs from roptr
# --- above; the gate must not depend on it ---
# RUN: not mcs251-lld roptr-notype.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/rpn.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RPTRN
# RPTRN: stored XDATA pointer in .rodata resolves outside the target object xobj: 0x0000 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R8 same-address alias: the referenced NOTYPE symbol shares the
# --- slice with a same-address STT_OBJECT "real" object; still gated ---
# RUN: not mcs251-lld roptr-notype-alias.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/rpa.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RPTRA
# RPTRA: stored XDATA pointer in .rodata resolves outside the target object xobj: 0x0000 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R8 cross-TU: the use TU holds an llc-shaped read-only pointer
# --- container in .text (4-byte big-endian container, R_MCS251_24 at
# --- offset 1) referencing an UNDEF NOTYPE symbol; the definition TU
# --- provides the NOTYPE definition in its XSEG slice.  Two-object link
# --- fails closed instead of serializing 00 00 00 00 ---
# RUN: not mcs251-lld notype-use.o notype-def.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/rpx.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=RPTRX
# RPTRX: stored XDATA pointer in .text resolves outside the target object _alias: 0x0000 not in [0x10000,0x10008] (one-past-end is the last legal value)

# --- X3-R8 positive: the same executable-image container with an in-range
# --- NOTYPE XSEG target (addend 4 into [0x10000,0x10008)) still links and
# --- serializes the container 00 01 00 04 at the CSEG image ---
# RUN: mcs251-lld notype-use-ok.o notype-def.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/xok.elf && test -f %t/xok.elf
# RUN: %python %S/Inputs/dump-elf-bytes.py %t/xok.elf 0xff0200 4 | FileCheck %s --check-prefix=XOK
# XOK: 00 01 00 04

# --- R_MCS251_16 against an XSEG symbol: hard truncation error ---
# RUN: not mcs251-lld trunc16.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/t16.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=T16
# T16: XDATA symbol xobj truncated to 16 bits (use the 24-bit relocation channel) in .text

# --- J16 against an XSEG symbol: same gate ---
# RUN: not mcs251-lld truncj16.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/tj.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=TJ16
# TJ16: XDATA symbol xobj truncated to 16 bits (use the 24-bit relocation channel) in .text

# --- reserved boundary symbols: user definitions rejected, refs resolved ---
# RUN: yaml2obj def-s-xdi.yaml -o def-s-xdi.o
# RUN: not mcs251-lld def-s-xdi.o --area-start=CSEG=0xff0200 \
# RUN:   -o %t/ds.elf 2>&1 | FileCheck %s --check-prefix=RSX
# RSX: user definition of reserved symbol s_XDATA_INIT
# RUN: yaml2obj ref-xdi.yaml -o ref-xdi.o
# RUN: mcs251-lld ref-xdi.o --area-start=CSEG=0xff0200 \
# RUN:   --map=%t/rx.map -o %t/rx.elf && test -f %t/rx.elf
# RUN: grep 'l_XDATA_INIT' %t/rx.map

# --- section-name boundary: exactly ".mcs251.xdata_init" and names with the
# --- ".mcs251.xdata_init." prefix join the XDATA_INIT area; near-miss names
# --- are unknown ALLOC sections and fail closed ---
# RUN: mcs251-lld prefix.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 \
# RUN:   --area-start=XDATA_INIT=0xff9000 --map=%t/pfx.map -o %t/pfx.elf \
# RUN:   && test -f %t/pfx.elf
# Three 7-byte records (one per section): l_XDATA_INIT spans all of them.
# RUN: grep 'l_XDATA_INIT = 0x0015' %t/pfx.map
# RUN: not mcs251-lld nearmiss1.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/nm1.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NM1
# NM1: unsupported ALLOC section .mcs251.xdata_initx
# RUN: not mcs251-lld nearmiss2.o --area-start=CSEG=0xff0200 \
# RUN:   --area-start=XDATA_INIT=0xff9000 -o %t/nm2.elf 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NM2
# NM2: unsupported ALLOC section .mcs251.xdata_ini

#--- prefix.yaml
# Three XDATA_INIT-class sections: the exact base name, a "."-prefixed name
# and the bare trailing-dot name. Each carries one valid record; the two
# 8-byte XSEG slices a and b are pinned per-section.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.XSEG.a
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.XSEG.b
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.XSEG.c
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .mcs251.xdata_init.b
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000800080000'
  - Name: .mcs251.xdata_init.
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01001000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols: []

#--- nearmiss1.yaml
# One byte different in the name: not an XDATA_INIT section.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.xdata_initx
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols: []

