#--- ptr.yaml
# A DSEG slot at 0x40 initialized to the XSEG object through the 24-bit
# channel (XINIT record: dest 0x0040 size 4 payload 4; the payload is the
# big-endian pointer container -- literal zero MSB at record offset 6, the
# R_MCS251_24 field at 7..9) and a CODE pointer table (.rodata) resolving
# into .text. Section shapes mirror what the fixed emitter produces.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '0000000000000000'
  - Name: .rela.rodata
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .rodata
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: entry
        Addend: 0
      - Offset: 5
        Type: R_MCS251_HI8
        Symbol: entry
        Addend: 0
      - Offset: 6
        Type: R_MCS251_MID8
        Symbol: entry
        Addend: 0
      - Offset: 7
        Type: R_MCS251_LO8
        Symbol: entry
        Addend: 0
  - Name: .mcs251.dseg
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.xinit
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '00400004000400000000'
  - Name: .rela.mcs251.xinit
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .mcs251.xinit
    Relocations:
      - Offset: 0
        Type: R_MCS251_16
        Symbol: slot
        Addend: 0
      - Offset: 7
        Type: R_MCS251_24
        Symbol: xobj
        Addend: 0
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: entry
    Binding: STB_GLOBAL
    Type: STT_FUNC
    Section: .text
  - Name: slot
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.dseg
  - Name: xobj
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG.xobj
  - Name: __mcs251_globals_init
    Binding: STB_GLOBAL
    Type: STT_FUNC
    Section: .text

