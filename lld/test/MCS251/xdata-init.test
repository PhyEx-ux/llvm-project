    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '00400004000400000000'
  - Name: .rela.mcs251.xinit
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .mcs251.xinit
    Relocations:
      - Offset: 0
        Type: R_MCS251_16
        Symbol: slot
        Addend: 0
      - Offset: 7
        Type: R_MCS251_24
        Symbol: xobj
        Addend: -65536
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
