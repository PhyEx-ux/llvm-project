#--- ok.yaml
# Record 1 (7 bytes): clear-only 8-byte object at 0x010000.
# Record 2 (16 bytes): payload 8-byte object at 0x010008.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
