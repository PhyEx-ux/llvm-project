#--- roptr.yaml
# The read-only data channel: an .rodata (CSEG) pointer entry against an
# XSEG object with a wrong-bank addend. An STT_FUNC target in the same
# table stays a plain code pointer and is never interval-gated.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.rodata
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .rodata
    Relocations:
      - Offset: 1
        Type: R_MCS251_24
        Symbol: xobj
        Addend: -65536
  - Name: .mcs251.XSEG.xobj
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 8
  - Name: .mcs251.xdata_init
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '01000000080000'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: xobj
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG.xobj

