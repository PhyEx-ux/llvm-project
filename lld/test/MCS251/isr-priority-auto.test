# RUN: rm -rf %t && split-file %s %t

# 1. Compile C source with __attribute__((interrupt(N), mcs251_isr_priority(P)))
#    and verify `.mcs251.isr.priority` section bytes alongside untouched `.mcs251.isr`.
# RUN: clang --target=mcs251-unknown-none -O1 -c %t/isrs.c -o %t/isrs.o
# RUN: llvm-readobj --sections --section-data %t/isrs.o | FileCheck %s --check-prefix=OBJ
# OBJ: Name: .mcs251.isr
# OBJ: Size: 96
# OBJ: Name: .mcs251.isr.priority
# OBJ: Size: 8
# OBJ: 0000: 00010100 00040300

# 2. Link with frozen IRQ CRT: verify synthesized ___mcs251_isr_priority_init
#    machine bytes (IP=0x12 at 0xB8, IPH=0x10 at 0xB7 -> 75 B8 12 75 B7 10 AA)
#    plus --map-json and --link-facts reporting.
# RUN: yaml2obj %S/../../../validation/mcs251-elf/runtime/crt-irq-v2.yaml -o %t/crt.o
# RUN: %python %S/Inputs/isr-v2flags.py %t/crt.o
# RUN: lld -flavor mcs251 --keep-symbols --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 %t/crt.o %t/isrs.o -o %t/fw.elf --map-json=%t/fw.json --link-facts=%t/fw.facts
# RUN: %python %t/check_init.py %t/fw.elf %t/fw.json 75b81275b710aa
# RUN: FileCheck %s --check-prefix=FACTS < %t/fw.facts
# FACTS-DAG: isr_priority slot=1 pri=1 src=attribute name _isr_lo
# FACTS-DAG: isr_priority slot=4 pri=3 src=attribute name _isr_hi
# FACTS-DAG: isr_priority_sfr IP=0x12
# FACTS-DAG: isr_priority_sfr IPH=0x10

# 3. CLI --isr-priority override updates SFR bytes (slot 1 -> pri 2: IP=0x10, IPH=0x12).
# RUN: lld -flavor mcs251 --keep-symbols --isr-priority=1=2 --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 %t/crt.o %t/isrs.o -o %t/cli.elf --map-json=%t/cli.json
# RUN: %python %t/check_init.py %t/cli.elf %t/cli.json 75b81075b712aa

# 4. Automatic preemption-graph derivation: two ISRs at DIFFERENT priorities
#    with overlaid parameter slots fail WP2 reentrancy WITHOUT needing
#    --isr-preemption-config; equal priorities or --no-auto-isr-preemption
#    keep the link conditional (warning only, exit 0).
# RUN: yaml2obj %t/two-isr.yaml -o %t/two.o
# RUN: %python %S/Inputs/isr-v2flags.py %t/two.o
# RUN: not lld -flavor mcs251 --isr-priority=_irq1=1 --isr-priority=_irq2=3 --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 %t/crt.o %t/two.o -o %t/reent_fail.elf 2>&1 | FileCheck %s --check-prefix=REENT
# REENT: error: ISR reentrancy: proven static parameter-slot contract violation
# RUN: lld -flavor mcs251 --isr-priority=_irq1=2 --isr-priority=_irq2=2 --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 %t/crt.o %t/two.o -o %t/reent_eq.elf
# RUN: lld -flavor mcs251 --no-auto-isr-preemption --isr-priority=_irq1=1 --isr-priority=_irq2=3 --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 %t/crt.o %t/two.o -o %t/reent_noauto.elf

#--- isrs.c
extern void __mcs251_isr_priority_init(void);
volatile int g_cnt;
void __attribute__((interrupt(1), mcs251_isr_priority(1))) isr_lo(void) { g_cnt += 1; }
void __attribute__((interrupt(4), mcs251_isr_priority(3))) isr_hi(void) { g_cnt += 2; }
int main(void) {
  __mcs251_isr_priority_init();
  return g_cnt;
}

#--- check_init.py
import json, struct, sys
elf_path, json_path, expect_hex = sys.argv[1], sys.argv[2], sys.argv[3]
data = open(elf_path, "rb").read()
meta = json.load(open(json_path))
sym = next(s for s in meta["symbols"] if s["name"] == "___mcs251_isr_priority_init")
addr = sym["address"]
size = sym["size"]
e_phoff = struct.unpack_from(">I", data, 28)[0]
e_phentsize, e_phnum = struct.unpack_from(">HH", data, 42)
got = None
for i in range(e_phnum):
    p_type, p_off, p_vaddr, p_paddr, p_filesz, p_memsz, p_flags, p_align = struct.unpack_from(">8I", data, e_phoff + i * e_phentsize)
    if p_type == 1 and p_vaddr <= addr and addr + size <= p_vaddr + p_filesz:
        off = p_off + (addr - p_vaddr)
        got = data[off:off + size].hex()
        break
assert got == expect_hex, f"expected {expect_hex}, got {got}"

