#--- truncated.yaml
# '20 00' is a jb whose rel8 byte is missing: the stream ends mid-instruction.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'A20092002000'
  - Name: .mcs251.bit
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '0101000100000000'
  - Name: .rela.mcs251.bit
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.bit
    Relocations:
      - Offset: 0x4
        Type: 10
        Symbol: f
        Addend: 0
  - Name: .rela.text
    Type: SHT_RELA
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 0x1
        Type: 11
        Symbol: f
        Addend: 0
      - Offset: 0x5
        Type: 11
        Symbol: f
        Addend: 0
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: f
    Type: STT_OBJECT
    Binding: STB_GLOBAL
    Section: .mcs251.bit
    Value: 0x0
    Size: 1
