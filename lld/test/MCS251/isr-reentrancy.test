    Size: 5
  - Name: _irq2
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x5
    Size: 5
  - Name: helper
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0xA
    Size: 1
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
