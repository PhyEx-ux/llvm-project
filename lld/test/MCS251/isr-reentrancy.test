      - Offset: 0x24
        Type: R_MCS251_ISR_REF
        Symbol: _irq1
        Addend: 0
      - Offset: 0x3C
        Type: R_MCS251_ISR_REF
        Symbol: _irq2
        Addend: 0
      - Offset: 0x54
        Type: R_MCS251_ISR_REF
