#--- inner-labels.yaml
# Case (h): zz_loop is an interior STT_NOTYPE label inside _irq1 placed
# at/under the ecall call site (label 0x2, reloc 0x3).  Under
# last-symbol-wins lookup this label used to own the call site and mute
# the diagnosis entirely.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    # _irq1@0 (size 7): nop nop; zz_loop@2: ecall helper (reloc @0x3); reti@6
    # helper@7: ret (22)
    # _main@8 (size 5): ecall helper (reloc @0x9); ret@0xC
    Content: '00009A00000032229A00000022'
  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000100180101010100010001000000000000000000000000000100180201010100010001000000000000000000000000'
  - Name: .rela.text
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .text
    Relocations:
      - Offset: 0x3
        Type: R_MCS251_24
        Symbol: helper
        Addend: 0
      - Offset: 0x9
        Type: R_MCS251_24
        Symbol: helper
        Addend: 0
  - Name: .rela.mcs251.isr
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
    Info: .mcs251.isr
    Relocations:
      - Offset: 0xC
        Type: R_MCS251_ISR_REF
        Symbol: _irq1
        Addend: 0
      - Offset: 0x24
        Type: R_MCS251_ISR_REF
        Symbol: _irq1
        Addend: 0
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    Flags: [ ]
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _irq1
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x0
    Size: 7
  - Name: zz_loop
    Type: STT_NOTYPE
    Binding: STB_LOCAL
    Section: .text
    Value: 0x2
  - Name: helper
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x7
    Size: 1
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x8
    Size: 5
  - Name: text_section
    Type: STT_SECTION
    Binding: STB_LOCAL
    Section: .text
    Value: 0

