    AddressAlign: 1
    # _irq1@0: ecall helper; reti.  _irq2@5: ecall helper; reti.
    # helper@10: ret.  _main@11: ret.
    Content: '9A000000329A000000322222'
  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000100180101010100010001000000000000000000000000000100180201010100010001000000000000000000000000000100180101010100020001000000000000000000000000000100180201010100020001000000000000000000000000'
  - Name: .rela.text
    Type: SHT_RELA
    Flags: [ ]
    AddressAlign: 4
    Link: .symtab
