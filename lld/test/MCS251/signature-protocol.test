#
# P-4 (freeze 2026-09-14): the function-signature reader rules that lld
# enforces over the whole input set.  v2-object-identity.test covers the
# carrier codec and the happy path; this file pins the object-internal
# association and the per-object coverage rule, which need more than one
# object or a non-function symbol to exercise.
#
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: yaml2obj defrec.yaml -o defrec.o
# RUN: yaml2obj noproto.yaml -o noproto.o
# RUN: yaml2obj noun.yaml -o noun.o
# RUN: yaml2obj producer.yaml -o producer.o
# RUN: yaml2obj consumer.yaml -o consumer.o
# RUN: yaml2obj user.yaml -o user.o
# RUN: yaml2obj dotl.yaml -o dotl.o
# RUN: yaml2obj notype-data.yaml -o notype-data.o
# RUN: yaml2obj def-compatible.yaml -o def-compatible.o
# RUN: yaml2obj caller-compatible.yaml -o caller-compatible.o
# RUN: yaml2obj producer-bit.yaml -o producer-bit.o
# RUN: yaml2obj producer-byte.yaml -o producer-byte.o
# RUN: yaml2obj obj-decl.yaml -o obj-decl.o
# RUN: yaml2obj func-def.yaml -o func-def.o
# RUN: yaml2obj kr-old-def.yaml -o kr-old-def.o
# RUN: yaml2obj kr-new-def.yaml -o kr-new-def.o
# RUN: yaml2obj kr-old-decl.yaml -o kr-old-decl.o
# RUN: yaml2obj crt-decl.yaml -o crt-decl.o
# RUN: yaml2obj neg-old-def.yaml -o neg-old-def.o
# RUN: yaml2obj neg-1param-decl.yaml -o neg-1param-decl.o
# RUN: %python setflags.py defrec.o noproto.o noun.o producer.o consumer.o user.o dotl.o notype-data.o def-compatible.o caller-compatible.o producer-bit.o producer-byte.o obj-decl.o func-def.o kr-old-def.o kr-new-def.o kr-old-decl.o crt-decl.o neg-old-def.o neg-1param-decl.o
#
# --- a definition record must name a function definition in its own object
# --- (a non-function NOTYPE symbol cannot carry a definition signature) ---
# RUN: not mcs251-lld notype-data.o --area-start=CSEG=0xff0200 -o %t/nd.elf 2>&1 | FileCheck %s --check-prefix=NOTFUNC
# NOTFUNC: claims a definition, but the symbol is not a function definition in this object
# RUN: test ! -e %t/nd.elf
#
# --- a .L-prefixed GLOBAL STT_FUNC is still an external function and must
# --- carry a record; the prefix is not an exemption --------------------
# RUN: not mcs251-lld dotl.o --area-start=CSEG=0xff0200 -o %t/dl.elf 2>&1 | FileCheck %s --check-prefix=DOTL
# DOTL: external function '.Lgf' with no function-signature record
# RUN: test ! -e %t/dl.elf
#
# --- a definition record must name a real in-object symbol, not invent one ---
# RUN: not mcs251-lld defrec.o --area-start=CSEG=0xff0200 -o %t/dr.elf 2>&1 | FileCheck %s --check-prefix=NOSYM
# NOSYM: claims a definition, but this object has no such symbol
# RUN: test ! -e %t/dr.elf
#
# --- a declaration record may have no symbol entry (unused/optimised-away),
# --- and links when nothing else objects ------------------------------
# RUN: mcs251-lld noun.o --area-start=CSEG=0xff0200 -o %t/noun.elf
# RUN: test -f %t/noun.elf
#
# --- the per-object coverage rule: the consumer defines nothing and calls
# --- _user, which its own Tag 28 does not record; the producer's record for
# --- _user must not stand in, so the link fails on the consumer ---------
# RUN: not mcs251-lld producer.o consumer.o --area-start=CSEG=0xff0200 -o %t/miss.elf 2>&1 | FileCheck %s --check-prefix=COVER
# COVER: consumer.o: MCS251 v2 object has an external function '_user' with no function-signature record
# RUN: test ! -e %t/miss.elf
#
# --- the same pair links once the consumer records what it references ---
# RUN: mcs251-lld producer.o user.o --area-start=CSEG=0xff0200 -o %t/ok.elf
# RUN: test -f %t/ok.elf
#
# --- cross-object bit/non-bit conflict on a name both sides record ---
# RUN: not mcs251-lld producer-bit.o producer-byte.o --area-start=CSEG=0xff0200 -o %t/bc.elf 2>&1 | FileCheck %s --check-prefix=BITCONF
# BITCONF: records '_probe' disagree on source parameter 0 bit-ness
# RUN: test ! -e %t/bc.elf
#
# --- K&R no-prototype vs prototyped: definition and caller agree on ret ---
# RUN: mcs251-lld def-compatible.o caller-compatible.o --area-start=CSEG=0xff0200 -o %t/kr.elf
# RUN: test -f %t/kr.elf
#
# --- zero-parameter prototype-ness compatibility (demo-76 shape, PM ruling
# --- 2026-09-15, revised after review): the writer records bit2 verbatim, so
# --- a K&R `void main()` definition carries (bit2=1, param_count=0) and the
# --- CRT's `void main(void)` declaration (bit2=0, param_count=0) differs on
# --- bit2 -- but the two have the identical runtime ABI, so a bit2
# --- difference with BOTH sides at param_count 0 links -- old objects
# --- (bit2 set) against prototyped-written ones and vice versa ---
# RUN: yaml2obj kr-old-def.yaml -o kr-old-def.o
# RUN: yaml2obj kr-new-def.yaml -o kr-new-def.o
# RUN: yaml2obj kr-old-decl.yaml -o kr-old-decl.o
# RUN: yaml2obj crt-decl.yaml -o crt-decl.o
# RUN: %python setflags.py kr-old-def.o kr-new-def.o kr-old-decl.o crt-decl.o
# the demo-76 link: K&R `void main()` definition (role 0x05, any writer
# vintage) vs the CRT's prototyped `_main` declaration (role 0x02)
# RUN: mcs251-lld kr-old-def.o crt-decl.o --area-start=CSEG=0xff0200 -o %t/z1.elf
# RUN: test -f %t/z1.elf
# a prototyped-written zero-param definition (role 0x01: `void main(void)`
# defined, or a 方案B-era object) vs the CRT: bit2 equal, plain compare
# RUN: mcs251-lld kr-new-def.o crt-decl.o --area-start=CSEG=0xff0200 -o %t/z2.elf
# RUN: test -f %t/z2.elf
# prototyped-written definition vs an OLD K&R declaration still carrying bit2
# RUN: mcs251-lld kr-new-def.o kr-old-decl.o --area-start=CSEG=0xff0200 -o %t/z3.elf
# RUN: test -f %t/z3.elf
#
# --- the zero-parameter tolerance is exactly zero parameters: a bit2
# --- difference next to a real parameter list is still a conflict -------
# RUN: yaml2obj neg-old-def.yaml -o neg-old-def.o
# RUN: yaml2obj neg-1param-decl.yaml -o neg-1param-decl.o
# RUN: %python setflags.py neg-old-def.o neg-1param-decl.o
# RUN: not mcs251-lld neg-old-def.o neg-1param-decl.o --area-start=CSEG=0xff0200 -o %t/z4.elf 2>&1 | FileCheck %s --check-prefix=ZEROPARAM-WIDE
# ZEROPARAM-WIDE: records '_f' disagree on prototype-ness
# RUN: test ! -e %t/z4.elf
#
# --- P1 closure (review round 3): compareRecords is deliberately NOT
# --- transitive, so the same-name record set is checked pairwise over ALL
# --- records.  Three legal records for _f --
# ---   A  `int f();`                       role 6, param_count 0
# ---   B  K&R definition, real parameters role 5, param_count 1
# ---   C  `int f(void);`                   role 2, param_count 0
# --- satisfy A-B (both bit2=1) and A-C (zero-parameter exemption) while
# --- B-C is a genuine conflict (bit2 differs, B has parameters).  A's
# --- presence does not exempt the B-C pair: B and C are simultaneously in
# --- the link in every order, so ALL six command-line permutations must be
# --- rejected.
# RUN: yaml2obj tri-kr-decl.yaml -o tri-kr-decl.o
# RUN: yaml2obj tri-kr-def.yaml -o tri-kr-def.o
# RUN: yaml2obj tri-proto-decl.yaml -o tri-proto-decl.o
# RUN: %python setflags.py tri-kr-decl.o tri-kr-def.o tri-proto-decl.o
# RUN: not mcs251-lld tri-kr-decl.o tri-kr-def.o tri-proto-decl.o --area-start=CSEG=0xff0200 -o %t/perm1.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm1.elf
# RUN: not mcs251-lld tri-kr-decl.o tri-proto-decl.o tri-kr-def.o --area-start=CSEG=0xff0200 -o %t/perm2.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm2.elf
# RUN: not mcs251-lld tri-kr-def.o tri-kr-decl.o tri-proto-decl.o --area-start=CSEG=0xff0200 -o %t/perm3.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm3.elf
# RUN: not mcs251-lld tri-kr-def.o tri-proto-decl.o tri-kr-decl.o --area-start=CSEG=0xff0200 -o %t/perm4.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm4.elf
# RUN: not mcs251-lld tri-proto-decl.o tri-kr-decl.o tri-kr-def.o --area-start=CSEG=0xff0200 -o %t/perm5.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm5.elf
# RUN: not mcs251-lld tri-proto-decl.o tri-kr-def.o tri-kr-decl.o --area-start=CSEG=0xff0200 -o %t/perm6.elf 2>&1 | FileCheck %s --check-prefix=TRIPLE-CONFLICT
# RUN: test ! -e %t/perm6.elf
# TRIPLE-CONFLICT: records '_f' disagree on prototype-ness
#
# --- pairwise all-compatible control 1: A + C + a prototyped zero-parameter
# --- definition (role 1, count 0).  Every pair is compatible (the two
# --- bit2-differing pairs fall under the zero-parameter exemption), so the
# --- pairwise sweep must not reject this triple.
# RUN: yaml2obj tri-proto-def.yaml -o tri-proto-def.o
# RUN: %python setflags.py tri-proto-def.o
# RUN: mcs251-lld tri-kr-decl.o tri-proto-decl.o tri-proto-def.o --area-start=CSEG=0xff0200 -o %t/pc1.elf
# RUN: test -f %t/pc1.elf
#
# --- pairwise all-compatible control 2: the demo-76 trio extended with the
# --- old-style declaration -- K&R definition (role 5, count 0), K&R
# --- declaration (role 6, count 0) and the prototyped CRT declaration
# --- (role 2, count 0).  bit2=1 pairs compare (ret, call_abi) only and the
# --- bit2-differing pairs fall under the zero-parameter exemption, so all
# --- three pairs are compatible and the triple links.
# RUN: mcs251-lld kr-old-def.o kr-old-decl.o crt-decl.o --area-start=CSEG=0xff0200 -o %t/pc2.elf
# RUN: test -f %t/pc2.elf
#
# --- a declaration record must name a FUNCTION symbol: an undefined
# --- STT_OBJECT symbol is valid object input but is DATA, so a signature
# --- that declares it as a function is refused even when another object
# --- provides a matching function definition -------------------------
# RUN: not mcs251-lld obj-decl.o func-def.o --area-start=CSEG=0xff0200 -o %t/obj.elf 2>&1 | FileCheck %s --check-prefix=OBJDECL
# OBJDECL: signature '_foo' is declared as a function, but its symbol is not a function type in this object
# RUN: test ! -e %t/obj.elf
#

#--- setflags.py
#!/usr/bin/env python3
"""Rewrite e_flags to the v2 word (yaml2obj only registers the v1 enum)."""
import pathlib, sys
OFF = 36
for name in sys.argv[1:]:
    p = pathlib.Path(name)
    b = bytearray(p.read_bytes())
    assert len(b) >= OFF + 4, name
    b[OFF:OFF + 4] = bytes.fromhex("00000102")
    p.write_bytes(bytes(b))
    print(f"{name}: e_flags -> 0x102")

#--- defrec.yaml

--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  []

