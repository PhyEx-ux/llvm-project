#--- names-note.yaml
# A synthetic `.mcs251.placement.names` carrier (design section 4.2 layout):
# SHT_NOTE, flags 0, align 4, name MCS251, type 2, desc =
#   u32 association_version=1, u32 entry_count=1,
#   u32 record_index=0, u32 name_len=2, "aa", pad to 4.
# The object carries ONE real placement record, so the carrier structure parses
# cleanly; it exists so the association-carrier STRUCTURE checks are executable
# even though the emitter increment for the carrier is a later slice and
# today's lld refuses such an input (registered cross-slice blocker).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .mcu.fixed.aa
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C0100000000020000000000040000000100000000A744B62D02616100'
  - Name: .mcs251.placement.names
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 2
        Desc: '0000000100000001000000000000000261610000'
Symbols:
  - Name: aa
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.aa
    Value: 0
    Size: 4

#--- names-dup.yaml
# Two association entries naming the SAME placement record index: the reader
# must reject the duplicate rather than keeping the last one.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .mcu.fixed.aa
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C0100000000020000000000040000000100000000A744B62D02616100'
  - Name: .mcs251.placement.names
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 2
        Desc: '000000010000000200000000000000026161000000000000000000027A7A0000'
Symbols:
  - Name: aa
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.aa
    Value: 0
    Size: 4

#--- plain.ll

; A v1 object with NO placement at all: the empty contract.
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

define dso_local void @plain() addrspace(4) #0 {
  ret void
}

attributes #0 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0}
!mcs251.signatures = !{!1}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{!"_plain", i32 1, i32 0}

#--- oseg.yaml
# G11-D R2-2: a writable NOBITS AS0 OVERLAY slice (`.mcs251.OSEG.*`), the
# producer's overlay storage per LinkerCore's classifySection.  The dynamic
# ledger must class it AS0-DATA so a fixed AS0 entity placed over it collides.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .mcs251.OSEG.test
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE, SHF_MCS251_OVERLAY ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  - Name: osegobj
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.OSEG.test
    Size: 4

#--- j16.yaml
# G11-D R2-4: the owned CODE source (`.mcu.fixed.fn` @0xfc1000) relocates a
# NORMAL CODE target: `ghost`, defined in this object's own dynamically
# allocated `.text` (CSEG), so the final target address is 0xff0200.  An
# R_MCS251_24 mother first; the test then rewrites the channel to J16 and
# the final encoding to the byte-correct low half `02 00` -- cross-bank.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcu.fixed.fn
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .mcu.fixed.fn
    AddressAlign: 1
    Relocations:
      - Offset: 0
        Type: R_MCS251_24
        Symbol: ghost
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c0102000000fc10000000000300000001000000004ca5579302666e00'
Symbols:
  - Name: fn
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fn
    Size: 3
  - Name: ghost
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .text
    Size: 1

#--- xdata-j16.yaml
# G11-D R3-3: j16.yaml with the target section turned into a dynamically
# allocated `.mcs251.XSEG` (writable NOBITS, XDATA).  Linked with
# --area-start=XSEG=0xfc0200 the target sits in the SAME 64K bank as fn
# (0xfc1000): the J16 bank condition is satisfied and only the storage-space
# channel rule can catch the 16-bit relocation the producer refuses.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .mcs251.XSEG
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 1
  - Name: .mcu.fixed.fn
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .mcu.fixed.fn
    AddressAlign: 1
    Relocations:
      - Offset: 0
        Type: R_MCS251_24
        Symbol: ghost
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c0102000000fc10000000000300000001000000004ca5579302666e00'
Symbols:
  - Name: fn
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fn
    Size: 3
  - Name: ghost
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG
    Size: 1

#--- samej16.yaml
# G11-D R3-3 positive: j16.yaml with the channel already J16 and the CSEG
# area pinned at 0xfc0200, so the CODE target (0xfc0200) shares fn's bank
# (0xfc1000).  The link and the verification must both succeed: a legal
# same-bank control transfer, kept as the channel rule's counterpart.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcu.fixed.fn
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .mcu.fixed.fn
    AddressAlign: 1
    Relocations:
      - Offset: 0
        Type: R_MCS251_J16
        Symbol: ghost
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c0102000000fc10000000000300000001000000004ca5579302666e00'
Symbols:
  - Name: fn
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fn
    Size: 3
  - Name: ghost
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .text
    Size: 1

#--- own2.yaml
# G11-D R2-3: stable `aa` owned by an EXTERNAL entity symbol `_aa`
# (STB_GLOBAL), at 0x20000.  Same record bytes as scoped-a.yaml.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcu.fixed.aa
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c010100000002000000000004000000010000000052a5bdf002616100'
Symbols:
  - Name: _aa
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.aa
    Value: 0
    Size: 4

#--- bind-id-nocarrier.yaml
# G11-D R2-3: the LEGACY bind object the link consumes (no `.names`
# carrier; the linker associates it through the undefined global `_aa`).
# One bind NOTE record for stable `aa`, XDATA object at 0x20000 size 4.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c010100010002000000000004000000010000000000d4ad0f02616100'
Symbols:
  - Name: _aa
    Binding: STB_GLOBAL
    Type: STT_OBJECT

#--- bind-id-assoc.yaml
# G11-D R2-3: the carrier-backed version of the SAME object (record 0 is
# associated with `_aa`): the verifier's associating POSITIVE.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c010100010002000000000004000000010000000000d4ad0f02616100'
  - Name: .mcs251.placement.names
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 2
        Desc: '000000010000000100000000000000035f616100'
Symbols:
  - Name: _aa
    Binding: STB_GLOBAL
    Type: STT_OBJECT

#--- bind-id-diff.yaml
# G11-D R2-3: the MISMATCH carrier -- record 0 is associated with `diff`
# while the owned record of the group names `_aa`.  The layout fields are
# identical, so only the NAME agreement rule can catch it.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001c010100010002000000000004000000010000000000d4ad0f02616100'
  - Name: .mcs251.placement.names
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 2
        Desc: '0000000100000001000000000000000464696666'
Symbols:
  - Name: diff
    Binding: STB_GLOBAL
    Type: STT_OBJECT
