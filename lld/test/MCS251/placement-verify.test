# =====================================================================
# rule R2-2 (B3) - `.mcs251.OSEG.*` is writable NOBITS AS0 OVERLAY storage,
# never CODE.  The positive links a real OSEG slice next to p.o; the fixed
# AS0 object `dv` is then moved CONSISTENTLY (NOTE + hash + report +
# st_value + map row) onto the slice's bytes.  The old dynamic-class table
# called OSEG CODE, so the AS0 entity never collided with it (pre-fix rc=0).
# =====================================================================
# RUN: yaml2obj oseg.yaml -o oseg-v1.o && %python seteflags.py oseg-v1.o && mv oseg-v1.o oseg.o
# RUN: mcs251-lld p.o oseg.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=oseg.placement --verify-placement --map=oseg.map -o oseg.elf
# RUN: mcs251-placement-verify --elf=oseg.elf --report=oseg.placement --object=p.o --object=oseg.o --link-map=oseg.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# RUN: %python %S/Inputs/audit-mutate.py note-addr p.o p.o dv 0x8
# RUN: %python %S/Inputs/audit-mutate.py report-field oseg.placement mut.placement dv address 0x8
# RUN: %python %S/Inputs/audit-mutate.py elf-stvalue oseg.elf mut.elf _dv 0x8
# RUN: %python %S/Inputs/audit-mutate.py map-section oseg.map mut.map p.o:.mcu.fixed.dv 0x8
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr mut.elf mut.elf 0 p.o .mcu.fixed.dv 0x8
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=mut.elf --report=mut.placement --object=p.o --object=oseg.o --link-map=mut.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=R22
# R22: VERIFY FAIL: dv overlaps .mcs251.OSEG.test
# RUN: cp .p.o.pristine p.o

# =====================================================================
# rule B4-related - the empty contract is a real case in every CLI cell: a
# zero-byte report must never crash the verifier, and verify-only must clean up
# its private report.  (The link half lives in placement-report.test.)
# =====================================================================
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf plain.ll -o empty.o
# RUN: mcs251-lld empty.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=empty.placement --verify-placement --map=empty.map -o empty.elf
# RUN: mcs251-lld empty.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --map=empty2.map -o empty2.elf
# RUN: test ! -f empty2.elf.placement
# RUN: mcs251-placement-verify --elf=empty.elf --report=empty.placement --object=empty.o --link-map=empty.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff

# =====================================================================
# rule B6 - two file-scoped (STB_LOCAL) entities with the SAME bare ELF name but
# different stables and addresses are a LEGAL combination: the name is
# file-scoped, and only the address disambiguates the output symbol.
# =====================================================================
# RUN: yaml2obj scoped-a.yaml -o scoped-a-v1.o && %python seteflags.py scoped-a-v1.o && mv scoped-a-v1.o scoped-a.o
# RUN: yaml2obj scoped-b.yaml -o scoped-b-v1.o && %python seteflags.py scoped-b-v1.o && mv scoped-b-v1.o scoped-b.o
# RUN: mcs251-lld scoped-a.o scoped-b.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=scoped.placement --map=scoped.map -o scoped.elf
# --- R8 §13.1 item 8: the owned B6 positive now carries an explicit rc=0 check.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=scoped.elf --report=scoped.placement --object=scoped-a.o --object=scoped-b.o --link-map=scoped.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# --- R8 §13.2 item 12 resident negative: both entities' carrier records and
# --- map rows are moved onto each other's address while the final symbol table
# --- is untouched, so each record no longer agrees with its entity.  (This
# --- construction previously existed only in an out-of-tree history script.)
# RUN: cp scoped.elf sw.elf && cp scoped.map sw.map
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr sw.elf sw.elf 0 scoped-a.o .mcu.fixed.aa 0x30000
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr sw.elf sw.elf 1 scoped-b.o .mcu.fixed.bb 0x20000
# RUN: %python %S/Inputs/audit-mutate.py map-section sw.map sw.map scoped-a.o:.mcu.fixed.aa 0x30000
# RUN: %python %S/Inputs/audit-mutate.py map-section sw.map sw.map scoped-b.o:.mcu.fixed.bb 0x20000
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=sw.elf --report=scoped.placement --object=scoped-a.o --object=scoped-b.o --link-map=sw.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=B6SWAP
# B6SWAP: the positioning record for .mcu.fixed.aa of scoped-a.o disagrees with the placement entity aa

# =====================================================================
# rule R2-3 (B6) - the owned/bind ELF-name agreement is ORDER INDEPENDENT.
# `own2.o` owns stable `aa` whose ELF entity is `_aa` (STB_GLOBAL).  The link
# now CONSUMES the association carrier (post-C2 an object without one is
# refused), so `bind-id-assoc.o` -- carrier associating `_aa` -- is the link
# input.  When the association names a DIFFERENT entity (`diff`) with
# identical layout fields, the group's records name two ELF entities -- in
# EITHER input order.  The old loop skipped the owned record's name, so the
# bind-first order passed (pre-fix rc=0) while the owned-first order failed.
# =====================================================================
# RUN: yaml2obj own2.yaml -o own2-v1.o && %python seteflags.py own2-v1.o && mv own2-v1.o own2.o
# RUN: yaml2obj bind-id-assoc.yaml -o bind-id.o && %python seteflags.py bind-id.o
# RUN: mcs251-lld own2.o bind-id.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=id.placement --map=id.map -o id.elf
# --- the associating positive: the carrier names the SAME entity `_aa`.
# RUN: %python %S/Inputs/audit-mutate.py carrier-digest id.elf id.elf 1 bind-id.o
# RUN: mcs251-placement-verify --elf=id.elf --report=id.placement --object=own2.o --object=bind-id.o --link-map=id.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# --- the mismatch: the carrier names `diff`; the report's bind-source row
# --- follows it so the failure can only come from the NAME agreement.
# RUN: yaml2obj bind-id-diff.yaml -o bind-id.o && %python seteflags.py bind-id.o
# RUN: %python %S/Inputs/audit-mutate.py carrier-digest id.elf id.elf 1 bind-id.o
# RUN: sed 's/^\(aa | \)_aa\(.*bind-id\.o\)/\1diff\2/' id.placement > id-mut.placement
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=id.elf --report=id-mut.placement --object=bind-id.o --object=own2.o --link-map=id.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=R23B
# R23B: VERIFY FAIL: conflicting placement for aa: the group's records name different ELF entities
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=id.elf --report=id-mut.placement --object=own2.o --object=bind-id.o --link-map=id.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=R23O
# R23O: VERIFY FAIL: conflicting placement for aa: the group's records name different ELF entities

# =====================================================================
# rule V3/B2 - the `.mcs251.placement.names` association carrier is parsed
# independently and its STRUCTURE fails closed.  The carrier-backed bind
# POSITIVE is now a real B+C product (C2-positive (a) above); these cases keep
# the verifier's own structural decoder executable on synthetic variants,
# including the ones the real writer cannot produce.
# =====================================================================
# RUN: yaml2obj names-note.yaml -o names-v1.o && %python seteflags.py names-v1.o && mv names-v1.o names.o
# --- the carrier STRUCTURE itself parses cleanly (no names-NOTE diagnostic).
