# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=p.elf --report=p.placement --object=p.o --object=mut.o --link-map=p.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=NTRUNC
# NTRUNC: VERIFY FAIL: malformed placement names NOTE in mut.o: entry 0 name out of bounds
# RUN: yaml2obj names-dup.yaml -o names-dup-v1.o && %python seteflags.py names-dup-v1.o && mv names-dup-v1.o names-dup.o
