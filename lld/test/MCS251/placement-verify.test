Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    AddressAlign: 1
    Relocations:
      - Offset: 0
        Type: R_MCS251_24
        Symbol: ghost
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  - Name: ghost
    Binding: STB_GLOBAL
    Type: STT_OBJECT

