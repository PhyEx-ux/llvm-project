# =====================================================================
# rule B8 - the Driver's own path/rollback behavior: a report that resolves to
# the OUTPUT path is rejected even through a `./` alias, and a failed report
# publication must not leave a brand-new ELF behind.
# =====================================================================
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=./alias.elf -o alias.elf 2>&1 | FileCheck %s --check-prefix=B8C
# B8C: placement report path conflicts with another input or output
# RUN: test ! -f alias.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=missing/dir/out.placement -o fresh.elf 2>&1 | FileCheck %s --check-prefix=B8R
# B8R: cannot open temporary placement report
# RUN: test ! -f fresh.elf

# =====================================================================
# rule R2-6 (B8) - the `./` input spelling is one object with `r.o`: the
# report's provenance uses the same lexical normalization the Driver hands
# the verifier.  Pre-fix behavior: rc=1 (no placement report row for cl).
# =====================================================================
# RUN: mcs251-lld ./p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=dot.placement --verify-placement --map=dot.map -o dot.elf
# RUN: mcs251-placement-verify --elf=dot.elf --report=dot.placement --object=./p.o --link-map=dot.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# RUN: FileCheck --input-file=dot.placement %s --check-prefix=R26
# R26-NOT: /./

# =====================================================================
# rule R2-7 (B8) - the publication preflight is side-effect free on files
# this run did not create, the temp paths are part of the conflict matrix,
# and a report target that is an existing DIRECTORY is refused BEFORE the
# ELF is replaced.  Pre-fix behavior: (1) the probe truncated+deleted the
# pre-existing map temp; (2) `-o product.tmp --placement-report=product`
# returned 0 and the ELF silently vanished under the report rename;
# (3) the old ELF at the output path was replaced before the report's
# rename failed.
# =====================================================================
# --- (1) a failing run must not destroy a pre-existing <target>.tmp.
# RUN: mkdir -p target-dir && printf 'PRESERVE ME\n' > prot.map.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --map=prot.map -o target-dir 2>&1 | FileCheck %s --check-prefix=R27D
# R27D: cannot replace output
# RUN: test -f prot.map.tmp
# RUN: printf 'PRESERVE ME\n' | cmp - prot.map.tmp
# --- (2) an artifact whose final path is another artifact's TEMP path.
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement -o product.tmp --placement-report=product 2>&1 | FileCheck %s --check-prefix=R27T
# R27T: placement report path conflicts with another input or output
# RUN: test ! -f product.tmp
# --- (3) a report target that is an existing directory: the old ELF at
# --- the output path must survive byte-for-byte.
# RUN: mkdir -p report-dir && printf 'OLD ELF CONTENT\n' > keep.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=report-dir -o keep.elf 2>&1 | FileCheck %s --check-prefix=R27R
# R27R: cannot replace placement report
# RUN: printf 'OLD ELF CONTENT\n' | cmp - keep.elf
# --- (4) R3-4: the REAL staging path is pre-flighted, and the ELF lands
# --- LAST.  The unique-name writability probe only proved the parent
# --- directory could hold a new file; a DIRECTORY parked at `<map>.tmp` or
# --- `<report>.tmp` was discovered only inside the publication write, after
# --- the already-published ELF had replaced the old product (pre-fix: old
# --- ELF's content destroyed while the run still returned 1).
# RUN: mkdir -p mt && printf 'OLD ELF\n' > mt/old.elf && mkdir -p mt/map.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=mt/report --map=mt/map -o mt/old.elf 2>&1 | FileCheck %s --check-prefix=R34M
# R34M: cannot open temporary map {{.*}}mt/map.tmp
# RUN: printf 'OLD ELF\n' | cmp - mt/old.elf
# RUN: not ls mt/*.probe.*
# RUN: mkdir -p rt && printf 'OLD ELF\n' > rt/old.elf && mkdir -p rt/report.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=rt/report -o rt/old.elf 2>&1 | FileCheck %s --check-prefix=R34R
# R34R: cannot open temporary placement report {{.*}}rt/report.tmp
# RUN: printf 'OLD ELF\n' | cmp - rt/old.elf
# RUN: not ls rt/*.probe.*
# --- the ELF did not pre-exist: the failed run leaves no new ELF behind.
# RUN: mkdir -p mt2 && mkdir -p mt2/map.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=mt2/report --map=mt2/map -o mt2/new.elf 2>&1 | FileCheck %s --check-prefix=R34M2
# R34M2: cannot open temporary map {{.*}}mt2/map.tmp
# RUN: test ! -f mt2/new.elf
# --- (5) R3-5: a publication STAGING path that IS an input file.  The
# --- report's temp used to be written through the input `source.tmp` and
# --- renamed over `source`, silently consuming the input (pre-fix: rc=0,
# --- input gone).
# RUN: cp p.o source.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld source.tmp --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --placement-report=source -o r35.elf 2>&1 | FileCheck %s --check-prefix=R35
# R35: placement report path conflicts with another input or output
# RUN: cmp p.o source.tmp
# RUN: test ! -f source
# RUN: test ! -f r35.elf
# --- the ELF's own staging path gets the same treatment.
# RUN: cp p.o e.tmp
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld e.tmp --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement -o e 2>&1 | FileCheck %s --check-prefix=R35E
# R35E: placement audit publication paths conflict: an output temporary path collides with an input file
# RUN: cmp p.o e.tmp
# RUN: test ! -f e

#--- v.sh
#!/bin/sh
# The standard independent-verifier invocation: complete object list, the link
# map and the board-level window numbers are passed explicitly; nothing is
# taken from the map's own "already placed here" claim.
exec mcs251-placement-verify \
  --elf="${ELF:-p.elf}" --report="${REPORT:-p.placement}" \
  --object="${OBJ:-p.o}" --link-map="${MAP:-p.map}" \
  --flash-base=0xfc0000 --flash-size=0x40000 \
  --area-start=XSEG=0x010000 --edata-end=0x3fff "$@"

#--- vm.sh
#!/bin/sh
# Mutate p.o IN PLACE and verify: the object's path is part of the report's
# `file` column, so a case that must land on a MERGE/SPAN/WINDOW rule cannot
# simply rename its input.  Usage:vm.sh <cmd> <args...> -- <verify-args...>
# G11-D2: the mutation also updates the final ELF's positioning carrier
# (the object fingerprint, and for note-addr the fixed section's record), so
# the case still reaches the layer it was written for instead of stopping at
# the carrier's ordered-digest check (design section 11.2 fixture rule).
set -e
cmd="$1"
shift
marg1="$1"
marg2="$2"
args=""
while [ "$1" != "--" ]; do
  args="$args $1"
  shift
done
shift
elf="${ELF:-p.elf}"
for a in "$@"; do
  case "$a" in
    --elf=*) elf="${a#--elf=}" ;;
  esac
done
cp p.o .p.pristine
cp "$elf" .vm.elf.pristine
python3 "$MUT" "$cmd" p.o p.o $args
if [ "$cmd" = note-addr ]; then
  python3 "$MUT" carrier-addr "$elf" "$elf" 0 p.o ".mcu.fixed.$marg1" "$marg2"
else
  python3 "$MUT" carrier-digest "$elf" "$elf" 0 p.o
fi
set +e
mcs251-placement-verify --elf="${ELF:-p.elf}" --report="${REPORT:-p.placement}" \
  --object=p.o --link-map="${MAP:-p.map}" --flash-base=0xfc0000 \
  --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff "$@"
rc=$?
cp .p.pristine p.o
cp .vm.elf.pristine "$elf"
exit $rc

#--- names.ll
; One owned entity whose object therefore carries the emitter's
; `.mcs251.placement.names` association NOTE (two records: the owned entity and
; the section anchor that is itself placed).
source_filename = "names.c"
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

@a = dso_local global i32 1, align 1 #0

define dso_local void @use_a() addrspace(4) #1 {
  %1 = load i32, ptr @a, align 1
  ret void
}

attributes #0 = { "mcs251-place"="0x40,data,object,owned,0" "mcs251-stable-symbol"="a" }
attributes #1 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0}
!mcs251.signatures = !{!1}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{!"_use_a", i32 1, i32 0}

#--- p.ll
; Verbatim `clang --target=mcs251 -O0 -S -emit-llvm` output for a program
; using every placement shape (AS0 object, CODE const object, CODE function,
; retain, noinit, XDATA object).  llc materializes it in the test, so the
; positive is a real B+C product with reproducible provenance.
source_filename = "p.c"
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

@dv = dso_local global i32 7, align 1 #0
@cl = dso_local addrspace(4) constant i32 42, align 1 #1
@rv = dso_local global i32 3, align 1 #2
@xv = dso_local addrspace(3) global i32 11, align 1 #3
@nv = dso_local global i32 0, align 1 #4
@llvm.used = appending global [1 x ptr] [ptr @rv], section "llvm.metadata"

define dso_local void @entryf() addrspace(4) #5 align 4 {
  ret void
}

define dso_local i32 @use() addrspace(4) #6 {
  %1 = load i32, ptr @dv, align 1
  %2 = load i32, ptr @rv, align 1
  %3 = add nsw i32 %1, %2
  %4 = load i32, ptr @nv, align 1
  %5 = add nsw i32 %3, %4
  %6 = load i32, ptr addrspace(3) @xv, align 1
  %7 = add nsw i32 %5, %6
  ret i32 %7
}

attributes #0 = { "mcs251-place"="0x40,data,object,owned,0" "mcs251-stable-symbol"="dv" }
attributes #1 = { "mcs251-place"="0xFC0000,code,object,owned,0" "mcs251-stable-symbol"="cl" }
attributes #2 = { "mcs251-place"="0x50,data,object,owned,1" "mcs251-stable-symbol"="rv" }
attributes #3 = { "mcs251-place"="0x20000,xdata,object,owned,0" "mcs251-stable-symbol"="xv" }
attributes #4 = { "mcs251-place"="0x60,data,object,owned,2" "mcs251-stable-symbol"="nv" }
attributes #5 = { noinline nounwind optnone "mcs251-place"="0xFC4000,code,function,owned,0" "mcs251-stable-symbol"="entryf" "no-builtins" }
attributes #6 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0, !1}
!mcs251.signatures = !{!2, !3}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{i32 7, !"frame-pointer", i32 2}
!2 = !{!"_entryf", i32 1, i32 0}
!3 = !{!"_use", i32 1, i32 0}

#--- bind.ll
; A bind-only object that the frozen HEAD emitter turns into a REAL
; carrier-backed product: the record is associated through the emitted
; `.mcs251.placement.names` entry with the undefined external `_ghostx`
; (the ELF name, NOT the stable `ghostx`), which is exactly the mapping the
; C2 consumer must use.  The address sits in the AS0-DATA space so the
; product also satisfies the verifier's V12 range rule.
source_filename = "bind.c"
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

@ghostx = external global i32, align 1 #0

define dso_local i32 @use_bind() addrspace(4) #1 {
  %1 = load i32, ptr @ghostx, align 1
  ret i32 %1
}

attributes #0 = { "mcs251-place"="0x80,data,object,bind,0" "mcs251-stable-symbol"="ghostx" }
attributes #1 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0}
!mcs251.signatures = !{!1}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{!"_use_bind", i32 1, i32 0}

#--- seteflags.py

# Rewrite e_flags to the v2 word (yaml2obj only registers the v1 enum).
import sys
OFF = 36
for name in sys.argv[1:]:
    b = bytearray(open(name, 'rb').read())
    assert len(b) >= OFF + 4, name
    b[OFF:OFF + 4] = bytes.fromhex("00000102")
    open(name, 'wb').write(bytes(b))

#--- pnt.txt
place ghost 0x10000 xdata size=4 bind

#--- pointer.yaml
