#--- nocase2.yaml
# ROUND-5: the two-ISR SLOTLESS contrast.  Two registered ISRs call 0-arg
# leaves and _main only loops: no static parameter slot exists anywhere, so
# a VALID contract of two DISTINCT ISR names links successfully (rc=0) --
# the success control for the path regressions, which must not lean on the
# rejected same-name pair handling.
#
# .text layout (0x0D bytes):
#   0x00 _irq1 (size 5): ecall _isr_leaf (reloc @0x01); reti.
#   0x05 _isr_leaf (size 1): eret.
#   0x06 _irq2 (size 5): ecall _isr_leaf (reloc @0x07); reti.
#   0x0B _main (size 1): eret.
#   0x0C helper (size 1): eret (signature-protocol name).
