# RUN:   --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 \
# RUN:   --isr-preemption-config=A.txt --isr-preemption-config=B.txt \
# RUN:   --link-facts=A.txt -o d1.elf > d1.err
# RUN: FileCheck %s --check-prefix=DUP-CFG < d1.err
# RUN: cmp A.txt A.orig
# RUN: not test -e d1.elf
