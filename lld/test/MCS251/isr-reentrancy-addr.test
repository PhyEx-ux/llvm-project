# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --link-facts=%t.m.facts -o %t.m.elf 2> %t.m.err
# RUN: FileCheck %s --check-prefix=MULTI-LOG < %t.m.err
# MULTI-LOG: warning: ISR reentrancy: conditional slot overlap: parameter slots are shared across two registered ISRs
# MULTI-LOG: warning: ISR reentrancy:   slot _s1_PARM_2
# MULTI-LOG: warning: ISR reentrancy:   slot _s2_PARM_2
# MULTI-LOG: warning: ISR reentrancy:   slot _s3_PARM_2
# MULTI-LOG: warning: ISR reentrancy: proven static parameter-slot contract violation: parameter slots are shared across the ISR and foreground execution contexts
# MULTI-LOG: warning: ISR reentrancy:   slot _fg_PARM_2
# MULTI-LOG: warning: ISR reentrancy:   slot _s1_PARM_2
# MULTI-LOG: warning: ISR reentrancy:   slot _s2_PARM_2
# MULTI-LOG: warning: ISR reentrancy:   slot _s3_PARM_2
# RUN: FileCheck %s --check-prefix=MULTI-FACTS < %t.m.facts
# MULTI-FACTS: conflict kind=0 proven=1 same_slot=0 range=[0x0,0x2) exact=1 slots={{.*}} members=4
# MULTI-FACTS: conflict_slot group=[0x0,0x2) {{.*}}name _fg_PARM_2
# MULTI-FACTS: conflict_slot group=[0x0,0x2) {{.*}}name _s1_PARM_2
# MULTI-FACTS: conflict_slot group=[0x0,0x2) {{.*}}name _s2_PARM_2
# MULTI-FACTS: conflict_slot group=[0x0,0x2) {{.*}}name _s3_PARM_2
# MULTI-FACTS: conflict_access group=[0x0,0x2) slot={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} by={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} role=1 evidence=3 edge_evidence={{[0-9]+}}
# MULTI-FACTS: conflict_access {{.*}} role=2 evidence=3

# --- (o) the versioned facts interface: version header, object identity,
# --- section/symbol records keyed by numeric identity, ISR registration, the
# --- direct call graph, per-function contexts, capacities and the reentrancy
# --- report.  No warning text is parsed.
# RUN: mcs251-lld %t.crt.o %t.c.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --link-facts=%t.c2.facts -o %t.c2.elf 2> %t.c2.err
# RUN: FileCheck %s --check-prefix=FACTS < %t.c2.facts
# FACTS: MCS251-LINK-FACTS 1
# FACTS: format text 1
# FACTS: obj {{[0-9]+}} sha256={{[0-9a-f]+}} path
# FACTS: sec {{[0-9]+}} {{[0-9]+}} region=OSEG space=0 addr=0x0 size=0x2 flags=0x10000003 name .mcs251.OSEG.1
# FACTS: sym {{[0-9]+}} {{[0-9]+}} addr=0x0 size=0x2 type=1 bind=0 name _isr_scale_PARM_2
# FACTS: isr slot=1 entry={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} name _irq1
# FACTS: edge {{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} -> {{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} evidence={{[0-9]+}}
# FACTS: contract version=1 kind=0 site={{[0-9]+}}:{{[0-9]+}}:0x1 target={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} name __mcs251_selfstart_boot
# FACTS: contract version=1 kind=1 site={{[0-9]+}}:{{[0-9]+}}:0x3d target={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} name __mcs251_globals_init
# FACTS: contract version=1 kind=1 site={{[0-9]+}}:{{[0-9]+}}:0x41 target={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} name __mcs251_xdata_init
# FACTS: contract version=1 kind=1 site={{[0-9]+}}:{{[0-9]+}}:0x45 target={{[0-9]+}}:{{[0-9]+}}:{{[0-9]+}} name _main
# FACTS: ctx {{.*}} fg=0 fg_contract={{[0-9]+}} isr=_irq1
# FACTS: ctx {{.*}} fg=1 fg_contract=1 isr=
# FACTS: cap spx=
# FACTS: reentrancy version=1 coverage=open isrs=1 functions={{[0-9]+}} slots=2
# FACTS: unknown kind=3 count=
# FACTS: conflict kind=0 proven=1 same_slot=0 range=[0x0,0x2) exact=1
# The address-taken-only link records NO indirect call site.
# RUN: mcs251-lld %t.crt.o %t.n.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --link-facts=%t.n.facts -o %t.n2.elf
# RUN: FileCheck %s --check-prefix=NOICALL < %t.n.facts
# NOICALL-NOT: icall
# NOICALL: reentrancy version=1 coverage=

# --- (p) facts publication is independent of the output mode: plain, with the
# --- placement report, and with the verifier all publish the facts file; the
# --- facts path is validated against the other outputs and inputs.
