# Three further alias spellings, each in all four output modes (plain, audit,
# verify, off): an absolute occurrence against a lexically different RELATIVE
# spelling of the same file, a spelling reached through a SYMLINKED DIRECTORY,
# and an INHERITED FILE DESCRIPTOR (/proc/self/fd/<n>).  The reject is on the
# OPTION, so it must fire before any path identity is consulted -- these
# spellings have nothing in common to compare.  The helper asserts rc==1, the
# duplicate diagnostic, byte-identical A and no ELF/report for every
# combination; it exits 3 when the descriptor spelling had to be skipped
# (non-Linux), which lit reports as a failure so the gap is visible rather
# than silently read as a pass.
# RUN: %python %S/Inputs/config-alias-check.py mcs251-lld %t.crt.o %t.n2.o %t-z10-alias
# DUP-CFG: duplicate --isr-preemption-config: the preemption contract is a single input file, so repeated occurrences are rejected (the declared pairs are not merged across files)
# The name-validation diagnostic also carries the contract line, so a
# multi-line contract points at the offending row instead of only naming
# the two symbols.
# RUN: printf '# board: two rows\npreempt _irq1 _irq2\npreempt _irq1 no_such_isr\n' > multi.txt
# RUN: not mcs251-lld %t.crt.o %t.n2.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-preemption-config=multi.txt \
# RUN:   -o d9.elf 2> d9.err
# RUN: FileCheck %s --check-prefix=CFG-LINE < d9.err
# RUN: not test -e d9.elf
# CFG-LINE: ISR preemption contract names 'no_such_isr', which is not a registered ISR entry of this link (at {{.*}}multi.txt:3 (from '_irq1 no_such_isr'))

# --- (z11) ROUND-6 item (7): the candidate EVALUATION ORDER, not the input
# --- object ORDER, decides which proven candidate is serialized.  Two input
# --- objects each carry two registered ISRs whose leaves own separate OSEG
# --- slots overlaid on one address, so the same-slot group has six ordered
# --- (writer root, user root) candidates.  The contract declares
# --- `_irq2/_irq3` and `_irq2/_irq4`, which in the A-B order in force are
# --- the 4th and 5th of the six candidates; the 6th (`_irq3/_irq4`) is NOT
# --- declared, and the first three are not either.  So several candidates
# --- that do NOT establish the group precede the ones that do.  With the
# --- objects in one order the FIRST established candidate is
# --- (_irq2,_irq3) -- the 4th candidate, with three established-as-missing
# --- candidates before it; swapped, it is (_irq3,_irq2), the 3rd.
# --- What is pinned here is NOT that both orders pick the same pair (they do
# --- not and need not).  It is, for EACH order:
# ---   * the COMPLETE candidate sequence is asserted as ONE CONTIGUOUS BLOCK
# ---     of `CHECK-NEXT' lines: the group record, then exactly six
# ---     `conflict_pair' records, each required to be on the line
# ---     immediately after the previous match, each with its own `proven'
# ---     value.  `CHECK-NEXT' is what makes "nothing else sits between two
# ---     of these" part of the check -- a plain ordered `CHECK' list does
# ---     not constrain what appears between two matches, so a REPEATED or
# ---     extra candidate still satisfied it.  A LEADING `-NOT' asserts that
# ---     no `conflict_pair' record precedes the group record and a TRAILING
# ---     `-NOT' asserts that none follows the sixth, so the block is closed
# ---     at both ends.  The six-record total is pinned by the parser's
# ---     `--expect-sequence' below, NOT by a FileCheck `COUNT' directive:
# ---     `COUNT' is a lower bound counted from its position, not an
# ---     exactness test, so no `COUNT' line appears here;
# ---   * the group's `slots=' equals the a=/b= of the FIRST proven pair
# ---     (tied by the FileCheck variable [[SA]]/[[SB]]);
# ---   * that `roots_a='/`roots_b=' are EXACTLY the first proven pair's root
# ---     lists, checked with `{{$}}' end-of-line anchors and by
# ---     `Inputs/facts-deciding-pair.py --expect-roots-a/--expect-roots-b',
# ---     which compares whole comma-separated TOKEN LISTS -- so an appended
# ---     root (`_irq3,_irq4' for `_irq3') is REJECTED rather than prefix-
# ---     matched;
# ---   * `Inputs/facts-deciding-pair.py --expect-sequence' re-derives the
# ---     SAME six-candidate sequence from the parsed records, comparing the
# ---     count, the order, each candidate's root lists as token lists and
# ---     each candidate's `proven' state -- so the assertion does not rest
# ---     on the FileCheck pattern list alone.
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf %S/Inputs/reentrancy-order-a.ll -o %t.oa.o
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf %S/Inputs/reentrancy-order-b.ll -o %t.ob.o
# RUN: mcs251-lld %t.crt.o %t.oa.o %t.ob.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-order.txt \
# RUN:   --link-facts=%t.ordab.facts -o %t.ordab.elf 2> %t.ordab.err
# The complete candidate sequence of the A-B order, as ONE CONTIGUOUS BLOCK:
# three candidates that do NOT establish the group, then the deciding pair,
# then the second declared pair, then the undeclared 6th.  Every line after
# the first is `-NEXT', so each record must be the very next input line: the
# six records are pinned as the block, with nothing interleaved.  Each
# `proven' value is asserted at its own position.
# No `conflict_pair' record sits before the group record, and none follows
# the sixth candidate: the block is exactly the group's six candidates.
# ORDER-AB-NOT: conflict_pair
# ORDER-AB: conflict kind=1 proven=1 same_slot=0 range={{[^ ]*}} exact=1 slots=[[SA:[0-9]+:[0-9]+:[0-9]+]],[[SB:[0-9]+:[0-9]+:[0-9]+]] members=4 roots_a=_irq2 roots_b=_irq3{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq1 roots_b=_irq2 missing={{.*}}{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq1 roots_b=_irq3 missing={{.*}}{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq1 roots_b=_irq4 missing={{.*}}{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a=[[SA]] b=[[SB]] proven=1 roots_a=_irq2 roots_b=_irq3{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=1 roots_a=_irq2 roots_b=_irq4{{$}}
# ORDER-AB-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq3 roots_b=_irq4 missing={{.*}}{{$}}
# No seventh candidate follows the block.  (FileCheck's `COUNT' directive is
# a lower bound counted from its position, not an exactness test, so the
# six-record total is pinned by the parser's `--expect-sequence' below
# rather than by a COUNT line here.)
# ORDER-AB-NOT: conflict_pair
# RUN: FileCheck %s --check-prefix=ORDER-AB < %t.ordab.facts
# The same invariant, re-derived from the parsed facts rather than from a
# pattern list: the group's candidate list is EXACTLY the six-candidate
# sequence above (count, order, each candidate's root token lists and its
# `proven' state), the candidate identities are pairwise distinct, the first
# `proven=1' candidate is the group's deciding pair with at least three
# explicitly `proven=0' candidates before it, and the root lists are EXACTLY
# one token each -- `_irq3' and not `_irq3,<anything>'.
# RUN: %python %S/Inputs/facts-deciding-pair.py --min-before 3 \
# RUN:   --expect-roots-a _irq2 --expect-roots-b _irq3 \
# RUN:   --expect-sequence '_irq1|_irq2|0;_irq1|_irq3|0;_irq1|_irq4|0;_irq2|_irq3|1;_irq2|_irq4|1;_irq3|_irq4|0' \
# RUN:   %t.ordab.facts
# NEGATIVE HALF.  An ordered `CHECK' list admits a REPEATED candidate in the
# middle of the sequence -- the expected records still appear in order, only
# with one duplicated.  Both layers must reject that input: the FileCheck
# block above because every line after the first is `-NEXT' (a duplicate
# makes the following record no longer the immediately next line), and the
# parser because `--expect-sequence' pins the candidate COUNT and every
# position.  The file is derived here from the real output, so the negative
# case is regenerated with the facts rather than frozen by hand.
# RUN: %python %S/Inputs/facts-deciding-pair.py --inject-repeat %t.ordab.facts %t.ordab-dup.facts
# RUN: not FileCheck %s --check-prefix=ORDER-AB < %t.ordab-dup.facts
# RUN: not %python %S/Inputs/facts-deciding-pair.py --min-before 3 \
# RUN:   --expect-roots-a _irq2 --expect-roots-b _irq3 \
# RUN:   --expect-sequence '_irq1|_irq2|0;_irq1|_irq3|0;_irq1|_irq4|0;_irq2|_irq3|1;_irq2|_irq4|1;_irq3|_irq4|0' \
# RUN:   %t.ordab-dup.facts
# Round 9 item (6), second negative: a candidate record placed BEFORE the
# group record.  The block asserts "the group record, then exactly these six
# candidates, contiguous"; a candidate ahead of the group record is outside
# that block, so it is caught only if the block is closed at its FRONT too.
# Both layers must reject it independently -- the leading `-NOT' because a
# `conflict_pair' record now precedes the first match, and the parser because
# it scans every `conflict_pair' record of the group in file order.
# RUN: %python %S/Inputs/facts-deciding-pair.py --inject-before-group %t.ordab.facts %t.ordab-pre.facts
# RUN: not FileCheck %s --check-prefix=ORDER-AB < %t.ordab-pre.facts
# RUN: not %python %S/Inputs/facts-deciding-pair.py --min-before 3 \
# RUN:   --expect-roots-a _irq2 --expect-roots-b _irq3 \
# RUN:   --expect-sequence '_irq1|_irq2|0;_irq1|_irq3|0;_irq1|_irq4|0;_irq2|_irq3|1;_irq2|_irq4|1;_irq3|_irq4|0' \
# RUN:   %t.ordab-pre.facts
# The A side/B side diagnostic lines name the SAME deciding pair.
# RUN: FileCheck %s --check-prefix=ORDER-AB-ERR < %t.ordab.err
# ORDER-AB-ERR: proven pair: {{0x[0-9a-f]+}}:{{0x[0-9a-f]+}}:{{0x[0-9a-f]+}} / {{0x[0-9a-f]+}}:{{0x[0-9a-f]+}}:{{0x[0-9a-f]+}}
# ORDER-AB-ERR: A side ISR roots: _irq2{{$}}
# ORDER-AB-ERR: B side ISR roots: _irq3{{$}}
# The SAME objects, the other order: the first established candidate of the
# new order is (_irq3,_irq2), the 3rd of the six.  The pair itself is
# deliberately NOT asserted to be order-independent.
# RUN: mcs251-lld %t.crt.o %t.ob.o %t.oa.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-order.txt \
# RUN:   --link-facts=%t.ordba.facts -o %t.ordba.elf 2> %t.ordba.err
# Both ends of this block are closed, exactly as for the A-B order above: no
# `conflict_pair` record sits BEFORE the group record and none follows the
# sixth candidate.  (Round 9 item (6): this side previously carried only the
# trailing `-NOT`, so a candidate inserted before the group record was
# rejected by the parser layer alone -- the claim "each of the two orders is
# closed at both ends and rejected by both layers" was not yet true here.)
# ORDER-BA-NOT: conflict_pair
# ORDER-BA: conflict kind=1 proven=1 same_slot=0 range={{[^ ]*}} exact=1 slots=[[SA2:[0-9]+:[0-9]+:[0-9]+]],[[SB2:[0-9]+:[0-9]+:[0-9]+]] members=4 roots_a=_irq3 roots_b=_irq2{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq3 roots_b=_irq4 missing={{.*}}{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq3 roots_b=_irq1 missing={{.*}}{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a=[[SA2]] b=[[SB2]] proven=1 roots_a=_irq3 roots_b=_irq2{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq4 roots_b=_irq1 missing={{.*}}{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=1 roots_a=_irq4 roots_b=_irq2{{$}}
# ORDER-BA-NEXT: conflict_pair group={{[^ ]*}} a={{[0-9]+:[0-9]+:[0-9]+}} b={{[0-9]+:[0-9]+:[0-9]+}} proven=0 roots_a=_irq1 roots_b=_irq2 missing={{.*}}{{$}}
# ORDER-BA-NOT: conflict_pair
# RUN: FileCheck %s --check-prefix=ORDER-BA < %t.ordba.facts
# RUN: %python %S/Inputs/facts-deciding-pair.py --min-before 2 \
# RUN:   --expect-roots-a _irq3 --expect-roots-b _irq2 \
# RUN:   --expect-sequence '_irq3|_irq4|0;_irq3|_irq1|0;_irq3|_irq2|1;_irq4|_irq1|0;_irq4|_irq2|1;_irq1|_irq2|0' \
# RUN:   %t.ordba.facts
# The same negative half for the B-A order.
# RUN: %python %S/Inputs/facts-deciding-pair.py --inject-repeat %t.ordba.facts %t.ordba-dup.facts
# RUN: not FileCheck %s --check-prefix=ORDER-BA < %t.ordba-dup.facts
# RUN: not %python %S/Inputs/facts-deciding-pair.py --min-before 2 \
# RUN:   --expect-roots-a _irq3 --expect-roots-b _irq2 \
# RUN:   --expect-sequence '_irq3|_irq4|0;_irq3|_irq1|0;_irq3|_irq2|1;_irq4|_irq1|0;_irq4|_irq2|1;_irq1|_irq2|0' \
# RUN:   %t.ordba-dup.facts
# Round 9 item (6), same second negative on the B-A side, so that BOTH
# orders are demonstrably closed at both ends and rejected by BOTH layers.
# RUN: %python %S/Inputs/facts-deciding-pair.py --inject-before-group %t.ordba.facts %t.ordba-pre.facts
# RUN: not FileCheck %s --check-prefix=ORDER-BA < %t.ordba-pre.facts
# RUN: not %python %S/Inputs/facts-deciding-pair.py --min-before 2 \
# RUN:   --expect-roots-a _irq3 --expect-roots-b _irq2 \
# RUN:   --expect-sequence '_irq3|_irq4|0;_irq3|_irq1|0;_irq3|_irq2|1;_irq4|_irq1|0;_irq4|_irq2|1;_irq1|_irq2|0' \
# RUN:   %t.ordba-pre.facts
# RUN: FileCheck %s --check-prefix=ORDER-BA-ERR < %t.ordba.err
# ORDER-BA-ERR: A side ISR roots: _irq3{{$}}
# ORDER-BA-ERR: B side ISR roots: _irq2{{$}}
# Repeats of one fixed order must be byte-stable: the choice is a selection
# from the order in force, not a nondeterministic pick.
# RUN: mcs251-lld %t.crt.o %t.oa.o %t.ob.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-order.txt \
# RUN:   --link-facts=%t.ordab2.facts -o %t.ordab2.elf 2> %t.ordab2.err
# RUN: cmp %t.ordab.facts %t.ordab2.facts
# RUN: cmp %t.ordab.err %t.ordab2.err
# Default severity on the same input is the same verdict as an rc=1 failure
# with no artifact, so the regression is not an artifact of warn mode.
# RUN: not mcs251-lld %t.crt.o %t.oa.o %t.ob.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 \
# RUN:   --isr-preemption-config=%t-seed/preempt-order.txt -o %t.ordab3.elf
# RUN: not test -e %t.ordab3.elf

# --- (z12) ROUND-6 item (7), second half: the ISR REGISTRATION RECORD order
# --- must not be read as the candidate evaluation order either.  The same
# --- object is emitted twice: once as compiled, once with ONLY its
# --- `.mcs251.isr` section body permuted in units of the ENTRY+REGISTER pair
# --- and the type9 association relocations remapped to the moved records --
# --- the code sections, symbol table, string table and every other section
# --- stay byte-identical.  Both must produce the same ISR table, the same
# --- deciding candidate and the same facts records: registration order is
# --- not evidence.
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf %S/Inputs/reentrancy-three-isr.ll -o %t.ordobj.o
# RUN: %python %S/Inputs/isr-record-reverse.py %t.ordobj.o %t.ordobj-rev.o
# The helper rewrote ONLY the metadata section and its association offsets:
# the two objects must still differ somewhere (the permutation happened) and
# the original must be untouched.
# RUN: not cmp %t.ordobj.o %t.ordobj-rev.o
# A difference SOMEWHERE is not the same claim as "the difference is confined
# to the metadata section and the association r_offset fields".  The audit
# recomputes the two allowed regions from the object layout and fails if any
# differing byte falls outside them, so "only the metadata section changed"
# is checked rather than assumed.
# RUN: %python %S/Inputs/isr-record-reverse.py --audit %t.ordobj.o %t.ordobj-rev.o > %t.rev.audit
# Every numeric assertion is anchored to end of line, so a value with the
# expected text as a PREFIX (8 accepting 80, 0 accepting 0x...) does not
# satisfy the check.
# REV-BYTES: AUDIT total_bytes_differ=8{{$}}
# REV-BYTES: AUDIT region isr_body differing_bytes=4 {{.*}}{{$}}
# REV-BYTES: AUDIT region rela_r_offset differing_bytes=4 {{.*}}{{$}}
# The r_offset changes sit in the field's byte 3 (zero-based), i.e. its
# LOWEST byte -- the record index only ever shifts the low byte for these
# small sections.
# REV-BYTES: AUDIT rela_r_offset field_internal_bytes=3{{$}}
# REV-BYTES: AUDIT outside_allowed=0{{$}}
# RUN: FileCheck %s --check-prefix=REV-BYTES < %t.rev.audit
# RUN: mcs251-lld %t.crt.o %t.ordobj.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-123.txt \
# RUN:   --link-facts=%t.reg.facts -o %t.reg.elf 2> %t.reg.err
# RUN: mcs251-lld %t.crt.o %t.ordobj-rev.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-123.txt \
# RUN:   --link-facts=%t.regrev.facts -o %t.regrev.elf 2> %t.regrev.err
# The ISR table is keyed by SLOT, so it is identical; the conflict records
# are identical too.  (The whole files cannot be compared: the `obj ...
# sha256=' line legitimately differs between the two objects.)
# RUN: grep '^isr ' %t.reg.facts > %t.reg.isrs
# RUN: grep '^isr ' %t.regrev.facts > %t.regrev.isrs
# RUN: cmp %t.reg.isrs %t.regrev.isrs
# RUN: grep '^conflict' %t.reg.facts > %t.reg.conf
# RUN: grep '^conflict' %t.regrev.facts > %t.regrev.conf
# RUN: cmp %t.reg.conf %t.regrev.conf
# RUN: FileCheck %s --check-prefix=REV-ISRS < %t.reg.isrs
# REV-ISRS: isr slot=1 {{.*}} name _irq1
# REV-ISRS: isr slot=2 {{.*}} name _irq2
# REV-ISRS: isr slot=3 {{.*}} name _irq3
# The baseline is the shape already pinned in (z7): the same-slot group of
# three roots proves via the first established candidate, never by the
# metadata record order.
# RUN: FileCheck %s --check-prefix=REV-CONF < %t.reg.conf
# REV-CONF: conflict kind=1 proven=1 same_slot=1 {{.*}} roots_a=_irq1 roots_b=_irq2
# --- A3.3 tells TWO shapes apart here, and both are pinned.
# --- (i) LEGAL PHYSICAL REORDER.  The contract
# --- (validation/mcs251-models/proposals/ISR-TASK-BREAKDOWN.md, A3.3) pairs
# --- an ENTRY with its REGISTER by "the same exact function symbol and the
# --- same slot"; it does NOT require the two records to be physically
# --- ADJACENT.  The linker pairs them by slot in two per-slot maps
# --- (LinkerCore.cpp, EntryBySlot/RegBySlot), then compares the symbol.  So
# --- interleaving the records (E1,E2,E3,R1,R2,R3 instead of E1,R1,E2,R2,E3,
# --- R3) while remapping each record's association relocation to where that
# --- record moved is a LEGAL object and must LINK SUCCESSFULLY with the same
# --- ISR table and the same conflict records.
# RUN: %python %S/Inputs/isr-record-reverse.py --permute 0,2,4,1,3,5 %t.ordobj.o %t.ordobj-il.o
# RUN: mcs251-lld %t.crt.o %t.ordobj-il.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-123.txt \
# RUN:   --link-facts=%t.regil.facts -o %t.regil.elf 2> %t.regil.err
# RUN: grep '^isr ' %t.regil.facts > %t.regil.isrs
# RUN: grep '^conflict' %t.regil.facts > %t.regil.conf
# RUN: cmp %t.reg.isrs %t.regil.isrs
# RUN: cmp %t.reg.conf %t.regil.conf
# The permute is still confined to the metadata section and its association
# offsets, so it is the record ORDER and nothing else that changed.
# RUN: %python %S/Inputs/isr-record-reverse.py --audit %t.ordobj.o %t.ordobj-il.o > %t.revil.audit
# REV-IL-BYTES: AUDIT outside_allowed=0
# RUN: FileCheck %s --check-prefix=REV-IL-BYTES < %t.revil.audit
# --- (ii) IDENTITY MISMATCH.  The SAME interleaving but WITHOUT remapping
# --- the associations leaves each record's symbol where it was, so slot 1's
# --- ENTRY and REGISTER now name different functions.  That is what A3.3
# --- rejects, and the reject is the exact-symbol rule -- not adjacency.
# RUN: %python %S/Inputs/isr-record-reverse.py --permute 0,3,2,1,4,5 --no-remap %t.ordobj.o %t.ordobj-un.o
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld %t.crt.o %t.ordobj-un.o \
# RUN:   --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 \
# RUN:   --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 \
# RUN:   --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-123.txt \
# RUN:   -o %t.regun.elf > %t.regun.err
# RUN: FileCheck %s --check-prefix=REV-UNMAPPED < %t.regun.err
# REV-UNMAPPED: MCS251 ISR: ENTRY and REGISTER must reference the same exact function for slot 1
# RUN: not test -e %t.regun.elf
# --- (iii) DUPLICATE-SLOT SHAPE.  `--set-all-slots 1' moves every
# --- ENTRY/REGISTER record of the six onto slot 1 without touching the
# --- symbol associations, so the section carries three ENTRY and three
# --- REGISTER records on one slot.  The LINKER refuses that shape (two
# --- ENTRY records for slot 1).  The fixture's own premise validation must
# --- refuse it too: a `dict[slot][kind] = i' assignment would silently keep
# --- only the LAST record per (slot, kind), leaving the
# --- one-ENTRY-one-REGISTER check satisfied and letting the helper hand on
# --- an object the linker then rejects.  Both sides are pinned here.
# RUN: %python %S/Inputs/isr-record-reverse.py --set-all-slots 1 %t.ordobj.o %t.ordobj-dup.o
# RUN: not %python %S/Inputs/isr-record-reverse.py %t.ordobj-dup.o %t.ordobj-dup-out.o
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld %t.crt.o %t.ordobj-dup.o \
# RUN:   --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 \
# RUN:   --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 \
# RUN:   --isr-reentrancy=warn \
# RUN:   --isr-preemption-config=%t-seed/preempt-123.txt \
# RUN:   -o %t.regdup.elf > %t.regdup.err
# RUN: FileCheck %s --check-prefix=REV-DUP-SLOT < %t.regdup.err
# REV-DUP-SLOT: MCS251 ISR: two ENTRY records for slot 1
# RUN: not test -e %t.regdup.elf


#--- preempt.txt
preempt _irq1 _irq2

#--- preempt-2.txt
preempt _irq1 _irq2

#--- preempt-order.txt
# ROUND-6 (z11) / ROUND-7 corrected: this contract declares two of the six
# ordered (writer root, user root) candidates of the four-ISR same-slot
# shape, so candidates that do NOT establish the group precede the ones that
# do.  In the A-B input order the six candidates are
#   (_irq1,_irq2) (_irq1,_irq3) (_irq1,_irq4) (_irq2,_irq3) (_irq2,_irq4)
#   (_irq3,_irq4);
# the declared pairs are the 4th and 5th, and the 6th does NOT establish.
# The first established candidate is therefore the 4th -- with three
# candidates before it that establish nothing, which is what makes the
# "first established candidate" claim non-vacuous.  (Round-6 wording said
# only "the LAST two", which read as if the declared pairs were the two
# final candidates; the last one is in fact undeclared.)
preempt _irq2 _irq3
preempt _irq2 _irq4

#--- preempt-123.txt
# ROUND-6 (z12): the three-ISR single-slot shape.  `_irq1`/`_irq2` and
# `_irq2`/`_irq3` are declared, so the first established candidate is
# (`_irq1`,`_irq2`) while (`_irq1`,`_irq3`) is not declared.
preempt _irq1 _irq2
preempt _irq2 _irq3

#--- bad-preempt.txt
preempt _irq1 no_such_isr

#--- conflict.yaml
# The repro/case.o shape, reconstructed as a self-contained fixture: two
# DIFFERENT leaf functions, each with a 2-byte static parameter slot in its own
# OSEG section (overlaid on one another by the linker), one reached only from a
# registered ISR and one only from the foreground.  `_irq1` and `_fg_scale` are
# small decodable bodies whose slot accesses are section-symbol relocations
# (the producer's real encoding), and the calls are ordinary R_MCS251_24
# control relocations.
#
# .text layout (0x24 bytes):
#   0x00 _irq1 (size 0x0B): LO8/MID8/HI8 relocs to .mcs251.OSEGEG + 0 at
#        0x01/0x03/0x05; ecall _isr_scale at 0x06; reti at 0x0A.
#   0x0B _isr_scale (size 0x07): LO8/MID8/HI8 to .mcs251.OSEG.1 + 0 at
#        0x0C/0x0E/0x10; ret at 0x11.
#   0x12 _main (size 0x0B): LO8/MID8/HI8 to .mcs251.OSEG.3 + 0 at
#        0x13/0x15/0x17; ecall _fg_scale at 0x18; ret at 0x1C.
#   0x1D _fg_scale (size 0x07): LO8/MID8/HI8 to .mcs251.OSEG.3 + 0 at
#        0x1E/0x20/0x22; ret at 0x23.
--- !ELF
