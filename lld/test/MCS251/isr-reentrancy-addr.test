#--- nocase.yaml
# Only the foreground side touches a slot: _irq1 calls a slotless helper.
#
# .text layout (0x1D bytes):
#   0x00 _irq1 (size 5): ecall _isr_leaf (reloc @0x01); reti.
#   0x05 _isr_leaf (size 1): ret.
#   0x06 _main (size 0x0C): LO8/MID8/HI8 to .mcs251.OSEG.3 + 0 at
#        0x07/0x09/0x0B; ecall _fg_scale at 0x0D; ret at 0x11.
#   0x12 _fg_scale (size 0xA): LO8/MID8/HI8 to .mcs251.OSEG.3 + 0 at
#        0x13/0x15/0x17; ret at 0x1B... (trailing imm carrier for the
#        address-taken relocation).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
