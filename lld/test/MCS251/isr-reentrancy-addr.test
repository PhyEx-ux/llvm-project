# ADDEND: proven static parameter-slot contract violation: parameter slots are shared across the ISR and foreground execution contexts at [0x0002,0x0004)
# ADDEND: slot _fg_scale_PARM_3
# ADDEND: slot _isr_scale_PARM_3

