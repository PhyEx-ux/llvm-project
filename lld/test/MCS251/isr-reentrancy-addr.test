# --- (q) ROUND-3: ONE two-argument function called from two registered ISRs.
# --- The same-slot ISR/ISR shape must be detected: with the preemption pair
# --- declared the slot's shared writer contexts are a PROVEN default failure;
# --- without a declaration it stays conditional.
# RUN: yaml2obj %t-seed/twoshared.yaml -o %t.ts.o
# RUN: %python %S/Inputs/isr-v2flags.py %t.ts.o
# RUN: mcs251-lld %t.crt.o %t.ts.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 -o %t.ts.elf 2> %t.ts.err
