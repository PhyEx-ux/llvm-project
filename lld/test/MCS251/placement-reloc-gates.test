    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C0101000000FFFFFC000000040000000100000000D9C81FF802686900'
Symbols:
  - Name: _hi
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.hi
    Value: 0
    Size: 4

#--- dyn-only.yaml
