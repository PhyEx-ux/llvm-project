#--- bindonly-fn.yaml
# J16 call to a bind-only function at 0xff2000.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00000000'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    AddressAlign: 1
    Relocations:
      - Offset: 0x1
        Type: R_MCS251_J16
        Symbol: bind_fn
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000200102010100FF20000000000000000001000000003F706EC20762696E645F666E'
# PM ruling (rev 2, kept): a bind function enters as a NOTYPE entry.
Symbols:
  - Name: bind_fn
    Binding: STB_GLOBAL
    Type: STT_NOTYPE

