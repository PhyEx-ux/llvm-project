#--- rel16.yaml
# R_MCS251_16 against the owned FIXED-XDATA symbol.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00000000'
    ShSize: 4
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    AddressAlign: 1
    Relocations:
      - Offset: 0x1
        Type: R_MCS251_16
        Symbol: _fx
        Addend: 0
  - Name: .mcu.fixed.fx
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C010100000002000000000004000000010000000052A5BDF002667800'
Symbols:
  - Name: _fx
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fx
    Value: 0
    Size: 4

#--- rel16-band.yaml
# Same, with addend 0x1000000: the value leaves the 24-bit band, so if the
# band check ran first the message would be "relocation overflow" -- the
# F9 wording proves the gate order (P-6b).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00000000'
    ShSize: 4
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    AddressAlign: 1
    Relocations:
      - Offset: 0x1
        Type: R_MCS251_16
        Symbol: _fx
        Addend: 0x1000000
  - Name: .mcu.fixed.fx
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C010100000002000000000004000000010000000052A5BDF002667800'
Symbols:
  - Name: _fx
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fx
    Value: 0
    Size: 4

#--- ptr-oob.yaml
