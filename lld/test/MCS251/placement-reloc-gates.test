#--- boundary-lo8.yaml
# B6 (review 2026-09-17): a width-1 (LO8) field at the LAST byte of .text,
# with .rodata placed immediately after it in the same CSEG run.  The P-6
# sentinel must occupy exactly one byte, so the trace cannot touch .rodata's
# first byte and the traced image equals the untraced one.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .rodata
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '11223344'
  - Name: .rela.text
    Type: SHT_RELA
    Info: .text
    AddressAlign: 1
    Relocations:
      - Offset: 0x3
        Type: R_MCS251_LO8
        Symbol: _fx
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcu.fixed.fx
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C010100000002000000000004000000010000000052A5BDF002667800'
Symbols:
  - Name: _fx
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.fx
    Value: 0
    Size: 4
