# RUN: grep 'mcu.fixed.fx 0x20000' fx-dyn.map
# RUN: grep 'XSEG._d 0x10000' fx-dyn.map
# --- (2) F13 freeze: the pin does not change s_XSEG/l_XSEG at all.
# RUN: mcs251-lld dyn.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 --map=no-pin.map -o no-pin.elf
# RUN: grep -E '^[sl]_XSEG = ' fx-dyn.map > xseg-pin.txt
# RUN: grep -E '^[sl]_XSEG = ' no-pin.map > xseg-nopin.txt
# RUN: cmp xseg-pin.txt xseg-nopin.txt
# --- (3) FIXED-XDATA pin ON the dynamic cursor position: the slice must fail
# --- closed -- proof the fixed interval is in the dynamic overlap ledger
# --- (without it the slice would land at 0x20000 and silently overlap).
# RUN: not mcs251-lld base.o dyn.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x20000 -o fx-ov.elf 2>&1 | FileCheck %s --check-prefix=FXOCC
# FXOCC: XDATA overlap for .mcs251.XSEG._d
# RUN: test ! -f fx-ov.elf
# --- (4) FIXED-XDATA + a 64K split XSEG section in one link: the split range
# --- [0x10000,0x20000) ends exactly where the pin begins -- adjacent and
# --- overlap-free (shared ledger, no silent straddle over the pin).
# RUN: yaml2obj split-after-pin.yaml -o sap-v1.o
# RUN: %python seteflags.py sap-v1.o && mv sap-v1.o sap.o
# RUN: mcs251-lld base.o sap.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x010000 --area-start=XDATA_INIT=0xff9000 --map=split.map -o split.elf
# RUN: grep 'mcu.fixed.fx 0x20000' split.map
# RUN: grep 'XSEG._big 0x10000' split.map
# RUN: grep 's_XSEG = 0x10000' split.map
# RUN: grep 'l_XSEG = 0x10000' split.map
# --- (5) ... and when the split section's contiguous range CONTAINS the pin,
# --- the shared ledger must reject it (no silent straddle).
# RUN: not mcs251-lld base.o sap.o --area-start=CSEG=0xff0200 --area-start=XSEG=0x1fff0 --area-start=XDATA_INIT=0xff9000 -o split-ov.elf 2>&1 | FileCheck %s --check-prefix=FXOCCBIG
# FXOCCBIG: XDATA overlap for .mcs251.XSEG._big
# RUN: test ! -f split-ov.elf
# --- (6) FIXED-AS0 pin and the G8 seed: layoutFixedData() runs before the
# --- seed snapshot, so the failure-fallback re-layout restores the pin.
# --- (6a) positive: the movable 256B DSEG slice cannot fit the low window,
