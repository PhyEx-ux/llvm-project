#--- seteflags.py
#!/usr/bin/env python3
"""Rewrite e_flags to the v2 word (yaml2obj only registers the v1 enum)."""
import pathlib, sys
OFF = 36
for name in sys.argv[1:]:
    p = pathlib.Path(name)
    b = bytearray(p.read_bytes())
    assert len(b) >= OFF + 4, name
    b[OFF:OFF + 4] = bytes.fromhex("00000102")
    p.write_bytes(bytes(b))

#--- note-mutate.py
#!/usr/bin/env python3
"""B1 mutations of a legal v2 object, computed from the ELF structure (no
hardcoded offsets).

  pad <src> <dst>  -- set the last NOTE storage byte to 0x42 (non-zero pad)
  cut <src> <dst>  -- shrink sh_size and descsz by one so the record's last
                      storage byte exits the section (the exact
                      truncated-padding shape the review used; the physical
                      byte stays in the file as inter-section padding, so no
                      other offset moves)
"""
import pathlib, struct, sys
mode, src, dst = sys.argv[1], sys.argv[2], sys.argv[3]
b = bytearray(pathlib.Path(src).read_bytes())
Shoff, = struct.unpack_from('>I', b, 32)
Shentsize, Shnum, Shstrndx = struct.unpack_from('>HHH', b, 46)
def sec_at(i):
    return struct.unpack_from('>IIIIIIIIII', b, Shoff + i * Shentsize)
strtab = sec_at(Shstrndx)
def name(off):
    e = b.index(b'\0', strtab[4] + off)
    return b[strtab[4] + off:e].decode()
idx = None
for i in range(Shnum):
    if name(sec_at(i)[0]) == '.mcs251.placement':
        idx = i
        break
assert idx is not None
ShOff, ShSize = sec_at(idx)[4], sec_at(idx)[5]
if mode == 'pad':
    b[ShOff + ShSize - 1] = 0x42
elif mode == 'cut':
    struct.pack_into('>I', b, Shoff + idx * Shentsize + 20, ShSize - 1)
    struct.pack_into('>I', b, ShOff + 4, ShSize - 1 - 20)
else:
    raise SystemExit('mode?')
pathlib.Path(dst).write_bytes(bytes(b))

#--- base.yaml
# One owned FIXED-XDATA entity (stable "fx", A=0x20000, size 4, align 1).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcu.fixed.fx
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C010100000002000000000004000000010000000052A5BDF002667800'
