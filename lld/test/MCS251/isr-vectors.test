# A duplicated RELA section header (both under the frozen name, both
# targeting the metadata section) is rejected by the object-level count.
# The fixture layout is deterministic: .rela.mcs251.isr is section 3.
# RUN: %python %S/Inputs/isr-fixture.py --out %t.drbase.yaml --slots 1
# RUN: yaml2obj %t.drbase.yaml -o %t.dr.o
# RUN: %python -c "import struct; p='%t.dr.o'; b=bytearray(open(p,'rb').read()); old=struct.unpack_from('>I',b,32)[0]; n=struct.unpack_from('>H',b,48)[0]; tbl=b[old:old+n*40]+b[old+3*40:old+4*40]; new=len(b); b+=tbl; struct.pack_into('>I',b,32,new); struct.pack_into('>H',b,48,n+1); open(p,'wb').write(b)"
# RUN: not mcs251-lld --print-input %t.dr.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=DUPRELA
# DUPRELA: more than one RELA targets .mcs251.isr

# -------------------------------------------------------------------------
# R2: the reset is validated by final landing address and HOME placement,
