  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000200180101010100010001000000000000000000000000000200180201010100010001000000000000000000000000'
  - Name: .rela.other
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.isr
    Relocations:
      - Offset: 0xC
        Type: R_MCS251_ISR_REF
        Symbol: _irq1
        Addend: 0
      - Offset: 0x24
        Type: R_MCS251_ISR_REF
        Symbol: _irq1
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: _irq1
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x0
    Size: 2
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2


#--- no-carrier.yaml
# A minimal v1-shaped object with no identity carrier: rewriting its header
# e_flags to 0x102 selects the v2 branch, which is then refused for the
# missing `.mcs251.attributes`.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
Symbols:
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2
