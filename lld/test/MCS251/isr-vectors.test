# RUN: yaml2obj %t-seed/vecs-zero.yaml -o %t.zv.o
# RUN: not mcs251-lld %t.crt.o %t.zv.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.zv.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=OLDVECS

# -------------------------------------------------------------------------
# Matrix: BOOT conflicts. FF0100 collides with the reserved holes; a
# non-colliding floor violation (FF01B0) hits the explicit BOOT check.
# -------------------------------------------------------------------------
# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0400 \
# RUN:   -o %t.bootold.elf 2>&1 | FileCheck %s --check-prefix=BOOTOLD
# BOOTOLD: CODE overlap for .mcs251.VECS

# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
