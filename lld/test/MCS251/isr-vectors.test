# RUN: not mcs251-lld %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.nocrt.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NOCRT
# NOCRT: IRQ mode requires exactly one IRQ_DEFAULT

# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 --area-start=VECS=0xff0004 \
# RUN:   -o %t.pin.elf 2>&1 | FileCheck %s --check-prefix=VECSPIN
# VECSPIN: --area-start=VECS must be 0xff0003

# RUN: cp %t.p01.o %t.v2reg.o
# RUN: %python -c "p='%t.v2reg.o'; b=bytearray(open(p,'rb').read()); b[36:40]=bytes.fromhex('00000102'); open(p,'wb').write(b)"
# RUN: not mcs251-lld --print-input %t.v2reg.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=V2REG
# V2REG: invalid MCS251 ELF header

# -------------------------------------------------------------------------
# T07 step 20: explicit initial values may target the allocated CRT
# BSEG_BYTES slice (16 bytes at 0x20); anything beyond the slice end still
# fails the existing slice containment check. No new bit allocator.
# -------------------------------------------------------------------------
# RUN: yaml2obj %t-seed/xinit-bseg.yaml -o %t.xb.o
# RUN: mcs251-lld %t.crt.o %t.xb.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.xb.elf && test -f %t.xb.elf
# RUN: yaml2obj %t-seed/xinit-beyond-bseg.yaml -o %t.xbb.o
# RUN: not mcs251-lld %t.crt.o %t.xbb.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.xbb.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=XBBAD
# XBBAD: XINIT destination is not within one DSEG slice

#--- forged.yaml
# A plain CSEG function carrying the CRT default's name. The ordinary
# duplicate-definition rule rejects it; no name-based authentication of the
# default entry exists.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: __mcs251_isr_unhandled
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- vecs-zero.yaml
# A zero-size legacy VECS section next to ISR metadata: IRQ mode must reject
# the input VECS even at size zero (it must not pass as a companion CRT).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.VECS
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Size: 0
  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000100180101010100010001000000000000000000000000000100180201010100010001000000000000000000000000'
  - Name: .rela.mcs251.isr
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.isr
    Relocations:
      - Offset: 0xC
        Type: R_MCS251_ISR_REF
        Symbol: _irq0
        Addend: 0
      - Offset: 0x24
        Type: R_MCS251_ISR_REF
        Symbol: _irq0
        Addend: 0
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _irq0
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x0
    Size: 2

#--- xinit-bseg.yaml
# One 16-byte explicit-initial-value record whose destination is exactly the
# CRT-owned allocated BSEG_BYTES slice [0x20,0x30).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.xinit
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '002000100010AABBCCDDEEFF00112233445566778899'
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '000000010000000100000000000000020000F3FF000000070000000000000000'
Symbols:
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- xinit-beyond-bseg.yaml
