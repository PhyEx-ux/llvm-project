# RUN: not mcs251-lld %t.rstins.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.rstins.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=RSTINS
# RSTINS: reset J16 must carry a zero addend, got 1

# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff01a3 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.homeaddr.elf 2>&1 | FileCheck %s --check-prefix=HOMEADDR
# HOMEADDR: HOME must sit at 0xff0000 abutting the vector base

# -------------------------------------------------------------------------
# R3: the default entry is protected against ordinary references, and
# zero-width relocations inside its range violate the frozen rule.
# -------------------------------------------------------------------------
# RUN: %python -c "import pathlib; s=pathlib.Path('%S/../../../validation/mcs251-elf/runtime/crt-irq.yaml').read_text(); old='        Symbol: _main\n        Addend: 0'; assert s.count(old)==1; pathlib.Path('%t.dftcall.yaml').write_text(s.replace(old,'        Symbol: __mcs251_isr_unhandled\n        Addend: 0'))"
# RUN: yaml2obj %t.dftcall.yaml -o %t.dftcall.o
# RUN: not mcs251-lld %t.dftcall.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0210 --area-start=CSEG=0xff0400 --area-start=XINIT=0xff8000 -o %t.dftcall.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=DFTCALL
# DFTCALL: uses the default entry __mcs251_isr_unhandled as a plain address

# A section symbol plus addend must not bypass DEFAULT reference protection.
# Keep the ECALL field outside the default body so this tests the target rule.
# RUN: %python -c "import pathlib; s=pathlib.Path('%S/../../../validation/mcs251-elf/runtime/crt-irq.yaml').read_text(); old='        Symbol: _main\n        Addend: 0'; assert s.count(old)==1; extra='  - Name: boot_section\n    Type: STT_SECTION\n    Binding: STB_LOCAL\n    Section: .mcs251.BOOT\n    Value: 0\n'; pathlib.Path('%t.dftsection.yaml').write_text(s.replace(old,'        Symbol: boot_section\n        Addend: 156')+extra)"
# RUN: yaml2obj %t.dftsection.yaml -o %t.dftsection.o
