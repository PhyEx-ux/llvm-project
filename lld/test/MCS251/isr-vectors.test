    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '002F00020002AABB'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- isr-no-rela.yaml
# R1: metadata records without any association RELA section must be rejected
# at the input-structure stage, never deferred to the vector stage.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000200180101010100010001000000000000000000000000000200180201010100010001000000000000000000000000'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: _irq1
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x0
    Size: 2
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- isr-empty-meta.yaml
