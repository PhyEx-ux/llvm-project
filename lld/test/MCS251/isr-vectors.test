# RUN:   --flash-base=0xff0000 --flash-size=0x42b -o %t.romok.elf
# RUN: test -f %t.romok.elf

# -------------------------------------------------------------------------
# Matrix: GC/LTO options keep being rejected; no CRT is a hard error; the
# vector area cannot be moved; v2 objects keep being rejected.
# -------------------------------------------------------------------------
# RUN: not mcs251-lld --gc-sections %t.crt.o %t.p01.o -o %t.gc.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=GCOPT
# GCOPT: unknown option --gc-sections

# RUN: not mcs251-lld --lto-O2 %t.crt.o %t.p01.o -o %t.lto.elf 2>&1 | \
