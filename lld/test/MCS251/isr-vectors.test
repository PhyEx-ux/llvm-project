# -------------------------------------------------------------------------
# R3: the default entry is protected against ordinary references, and
# zero-width relocations inside its range violate the frozen rule.
# -------------------------------------------------------------------------
# The mutation retargets the only `_main` code reference at the default
# entry.  Under P-4 the CRT's Tag 28 must follow, so this also swaps the
# carrier for one that declares `__mcs251_isr_unhandled` (the symbol the
# relocation now references) instead of `_main`.
# RUN: %python -c "import pathlib; p='%S/../../../validation/mcs251-elf/runtime/crt-irq-v2.yaml'; s=pathlib.Path(p).read_text(); o='        Symbol: _main\n        Addend: 0'; assert s.count(o)==1; s=s.replace(o,'        Symbol: __mcs251_isr_unhandled\n        Addend: 0'); oc=''; nc=''; assert s.count(oc)==1, 'old carrier'; s=s.replace(oc,nc); pathlib.Path('%t.dftcall.yaml').write_text(s)"
# RUN: yaml2obj %t.dftcall.yaml -o %t.dftcall.o
# RUN: %python -c "import pathlib; p='%t.dftcall.o'; b=bytearray(pathlib.Path(p).read_bytes()); b[36:40]=bytes.fromhex('00000102'); pathlib.Path(p).write_bytes(bytes(b))"
# RUN: not mcs251-lld %t.dftcall.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.dftcall.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=DFTCALL
# DFTCALL: uses the default entry __mcs251_isr_unhandled as a plain address

# A section symbol plus addend must not bypass DEFAULT reference protection.
# Keep the ECALL field outside the default body so this tests the target rule.
# RUN: %python -c "import pathlib; p='%S/../../../validation/mcs251-elf/runtime/crt-irq-v2.yaml'; s=pathlib.Path(p).read_text(); o='        Symbol: _main\n        Addend: 0'; assert s.count(o)==1; s=s.replace(o,'        Symbol: boot_section\n        Addend: 258'); oc=''; nc=''; assert s.count(oc)==1; s=s.replace(oc,nc); extra='  - Name: boot_section\n    Type: STT_SECTION\n    Binding: STB_LOCAL\n    Section: .mcs251.BOOT\n    Value: 0\n'; pathlib.Path('%t.dftsection.yaml').write_text(s+extra)"
# RUN: yaml2obj %t.dftsection.yaml -o %t.dftsection.o
# RUN: %python -c "import pathlib; p='%t.dftsection.o'; b=bytearray(pathlib.Path(p).read_bytes()); b[36:40]=bytes.fromhex('00000102'); pathlib.Path(p).write_bytes(bytes(b))"
# RUN: not mcs251-lld %t.dftsection.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.dftsection.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=DFTSECTION
# DFTSECTION: section+addend relocation in .mcs251.BOOT lands inside the default entry

# RUN: %python -c "import pathlib; s=pathlib.Path('%S/../../../validation/mcs251-elf/runtime/crt-irq-v2.yaml').read_text(); old='        Symbol: _main'+chr(10)+'        Addend: 0'+chr(10); assert s.count(old)==1; add='      - Offset: 0x102'+chr(10)+'        Type: R_MCS251_NONE'+chr(10)+'        Symbol: _main'+chr(10)+'        Addend: 0'+chr(10); pathlib.Path('%t.dftnone.yaml').write_text(s.replace(old, old+add))"
