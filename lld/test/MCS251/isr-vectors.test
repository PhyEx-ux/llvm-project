# RUN: not mcs251-lld %t.crt.o %t.zv.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.zv.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=OLDVECS

# -------------------------------------------------------------------------
# Matrix: BOOT conflicts. FF0100 collides with the reserved holes; a
# non-colliding floor violation (FF01B0) hits the explicit BOOT check.
# -------------------------------------------------------------------------
# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0400 \
# RUN:   -o %t.bootold.elf 2>&1 | FileCheck %s --check-prefix=BOOTOLD
# BOOTOLD: CODE overlap for .mcs251.VECS

# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0430 --area-start=CSEG=0xff0700 \
# RUN:   --area-start=XINIT=0xff8000 -o %t.bootfloor.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=BOOTFLOOR
# BOOTFLOOR: MCS251 ISR: CRT BOOT must start at or above 0xff0500

# CSEG is not secretly pinned to the published 0xFF0700 recipe: a 2-byte CSEG
# that ends exactly at the BOOT end (0xFF0606) is accepted, while one that
# overlaps the last BOOT byte (0xFF0605) is rejected.
# RUN: not mcs251-lld %t.crt.o %t.small.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0605 \
# RUN:   --area-start=XINIT=0xff8000 -o %t.csegov.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=CSEGOV
# CSEGOV: CODE overlap
# RUN: mcs251-lld %t.crt.o %t.small.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0606 \
# RUN:   --area-start=XINIT=0xff8000 -o %t.csegok.elf
# RUN: test -f %t.csegok.elf

# -------------------------------------------------------------------------
# Matrix: ordinary CSEG spanning reserved payload and holes; the whole
# reserved range conflicts, not just already-written image bytes.
# -------------------------------------------------------------------------
# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=XINIT=0xff8000 \
# RUN:   --area-start=CSEG=0xff00f0 -o %t.hole.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=HOLE
# HOLE: CODE overlap for .mcs251.VECS

# -------------------------------------------------------------------------
# Matrix: ROM window boundary, exact pass and one byte short.
# -------------------------------------------------------------------------
# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --flash-base=0xff0000 --flash-size=0x72a -o %t.rom1.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=ROM1
# ROM1: CODE ROM overflow

# RUN: mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 \
# RUN:   --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 \
# RUN:   --flash-base=0xff0000 --flash-size=0x72b -o %t.romok.elf
# RUN: test -f %t.romok.elf

# -------------------------------------------------------------------------
# Matrix: GC/LTO options keep being rejected; no CRT is a hard error; the
# vector area cannot be moved; a v2 header word on an object with no
# `.mcs251.attributes` carrier is rejected (W4: e_flags=0x102 selects the v2
# identity branch, which requires the carrier; there is no fallback to the
# v1 note that this object still carries).
# -------------------------------------------------------------------------
# RUN: not mcs251-lld --gc-sections %t.crt.o %t.p01.o -o %t.gc.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=GCOPT
# GCOPT: unknown option --gc-sections

# RUN: not mcs251-lld --lto-O2 %t.crt.o %t.p01.o -o %t.lto.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=LTOOPT
# LTOOPT: unknown option --lto-O2

# RUN: not mcs251-lld %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.nocrt.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=NOCRT
# NOCRT: IRQ mode requires exactly one IRQ_DEFAULT

# RUN: not mcs251-lld %t.crt.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 --area-start=VECS=0xff0004 \
# RUN:   -o %t.pin.elf 2>&1 | FileCheck %s --check-prefix=VECSPIN
# VECSPIN: --area-start=VECS must be 0xff0003

# A v1 object (no carrier) whose header is rewritten to the v2 e_flags word is
# refused for the missing carrier: the fixture generator emits v2 objects now,
# so this negative builds a v1-shaped seed without `.mcs251.attributes`.
# RUN: yaml2obj %t-seed/no-carrier.yaml -o %t.v2reg.o
# RUN: %python %S/Inputs/isr-v2flags.py %t.v2reg.o
# RUN: not mcs251-lld --print-input %t.v2reg.o 2>&1 | \
# RUN:   FileCheck %s --check-prefix=V2REG
# V2REG: MCS251 v2 object requires exactly one .mcs251.attributes

# -------------------------------------------------------------------------
# T07 step 20: explicit initial values may target the allocated CRT
# BSEG_BYTES slice (16 bytes at 0x20); anything beyond the slice end still
# fails the existing slice containment check. No new bit allocator.
# -------------------------------------------------------------------------
# RUN: yaml2obj %t-seed/xinit-bseg.yaml -o %t.xb.o
# RUN: %python %S/Inputs/isr-v2flags.py %t.xb.o
# RUN: mcs251-lld %t.crt.o %t.xb.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.xb.elf && test -f %t.xb.elf
# RUN: yaml2obj %t-seed/xinit-beyond-bseg.yaml -o %t.xbb.o
# RUN: %python %S/Inputs/isr-v2flags.py %t.xbb.o
# RUN: not mcs251-lld %t.crt.o %t.xbb.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.xbb.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=XBBAD
# XBBAD: XINIT destination is not within one DSEG slice

#--- forged.yaml
# A plain CSEG function carrying the CRT default's name. The ordinary
# duplicate-definition rule rejects it; no name-based authentication of the
# default entry exists.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: __mcs251_isr_unhandled
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- vecs-zero.yaml
# A zero-size legacy VECS section next to ISR metadata: IRQ mode must reject
# the input VECS even at size zero (it must not pass as a companion CRT).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.VECS
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Size: 0
  - Name: .mcs251.isr
    Type: SHT_PROGBITS
    Flags: [ ]
    AddressAlign: 4
    Content: '000200180101010100010001000000000000000000000000000200180201010100010001000000000000000000000000'
  - Name: .rela.mcs251.isr
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.isr
    Relocations:
      - Offset: 0xC
        Type: R_MCS251_ISR_REF
        Symbol: _irq0
        Addend: 0
      - Offset: 0x24
        Type: R_MCS251_ISR_REF
        Symbol: _irq0
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: _irq0
    Type: STT_FUNC
    Binding: STB_LOCAL
    Section: .text
    Value: 0x0
    Size: 2

#--- xinit-bseg.yaml
# One 16-byte explicit-initial-value record whose destination is exactly the
# CRT-owned allocated BSEG_BYTES slice [0x20,0x30).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '80FE'
  - Name: .mcs251.xinit
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '002000100010AABBCCDDEEFF00112233445566778899'
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ''
Symbols:
  - Name: _main
    Type: STT_FUNC
    Binding: STB_GLOBAL
    Section: .text
    Value: 0x0
    Size: 2

#--- xinit-beyond-bseg.yaml
