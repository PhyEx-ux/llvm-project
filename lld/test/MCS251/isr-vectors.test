# -------------------------------------------------------------------------
# Matrix: legacy CRT in the same link; zero-size legacy VECS input.
# -------------------------------------------------------------------------
# The frozen v1 self-start CRT carries VECS sections but no ISR metadata; IRQ
# mode must reject its input VECS regardless.
# RUN: yaml2obj %S/../../../validation/mcs251-elf/runtime/crt-selfstart.yaml -o %t.oldcrt.o
# RUN: not mcs251-lld %t.crt.o %t.oldcrt.o %t.p01.o --area-start=HOME=0xff0000 --area-start=BOOT=0xff0500 --area-start=CSEG=0xff0700 --area-start=XINIT=0xff8000 -o %t.old.elf 2>&1 | \
# RUN:   FileCheck %s --check-prefix=OLDVECS
# OLDVECS: MCS251 ISR: input VECS section

# RUN: yaml2obj %t-seed/vecs-zero.yaml -o %t.zv.o
