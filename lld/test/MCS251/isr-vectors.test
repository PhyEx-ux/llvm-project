# -------------------------------------------------------------------------
# R5: isolated reserved-range probes. A 2-byte CSEG dropped entirely into
# the slot-31 hole, and one dropped entirely into the slot-0 tail, must
# each be rejected with no other payload present.
# -------------------------------------------------------------------------
# RUN: %python %S/Inputs/isr-fixture.py --out %t.small.yaml --slots 1
# RUN: %python -c "import pathlib; p='%t.small.yaml'; s=pathlib.Path(p).read_text(); k=s.index('Content:'); q1=s.index(chr(39),k); q2=s.index(chr(39),q1+1); s=s[:q1+1]+'80FE'+s[q2:]; s=s.replace('Size: 41','Size: 2'); s=s.replace('Value: 0x29','Value: 0x0'); pathlib.Path(p).write_text(s)"
# RUN: yaml2obj %t.small.yaml -o %t.small.o
