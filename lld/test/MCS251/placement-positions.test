# G11-D2 (design section 11.1/11.2): the versioned positioning carrier.
# Positives freeze the byte-level schema with the INDEPENDENT checker
# Inputs/placement-positions.py (it re-implements the frozen section-3 layout
# and never calls the producer's serializer; expected values are literals of
# this test).  Negatives are fixed-point byte mutations made by
# Inputs/audit-mutate.py pos-* modes, each asserted with the EXACT exit
# status 1 and the target diagnostic.
#
# Class 9 note: HOME/VECS/BOOT sections that are themselves SHT_NOBITS are
# refused by the input validator ("invalid HOME section"), so the frozen
# class is covered by a zero-length pinned VECS input member plus the
# preserved inter-area holes of the same link.
#
# Every link below uses explicit board-level window numbers so the verifier's
# windows are independent of the map.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: %python attr.py && mkdir -p other-dir
# RUN: yaml2obj split.yaml -o t.o && %python v2flags.py t.o && mv t.o split.o
# RUN: yaml2obj emptyiseg.yaml -o t.o && %python v2flags.py t.o && mv t.o emptyiseg.o
# RUN: yaml2obj datapt.yaml -o t.o && %python v2flags.py t.o && mv t.o datapt.o
# RUN: yaml2obj datapt-sym.yaml -o t.o && %python v2flags.py t.o && mv t.o datapt-sym.o
# RUN: yaml2obj g8.yaml -o t.o && %python v2flags.py t.o && mv t.o g8.o
# RUN: yaml2obj vecs0.yaml -o t.o && %python v2flags.py t.o && mv t.o vecs0.o
# RUN: yaml2obj noalloc.yaml -o t.o && %python v2flags.py t.o && mv t.o noalloc.o
# RUN: yaml2obj samename.yaml -o t.o && %python v2flags.py t.o && mv t.o samename.o
# RUN: yaml2obj ovl.yaml -o t.o && %python v2flags.py t.o && mv t.o ovl.o
# RUN: yaml2obj dsegn.yaml -o t.o && %python v2flags.py t.o && mv t.o dsegn.o
# RUN: yaml2obj twox.yaml -o t.o && %python v2flags.py t.o && mv t.o twox.o
# RUN: yaml2obj fixed.yaml -o t.o && %python v2flags.py t.o && mv t.o fixed.o
# RUN: yaml2obj xinitin.yaml -o t.o && %python v2flags.py t.o && mv t.o xinitin.o
# RUN: yaml2obj dabs.yaml -o t.o && %python v2flags.py t.o && mv t.o dabs.o

# =====================================================================
# M: the structure mother -- two objects, four records including the
# canonical XSEG split and a zero-length ISEG.
# =====================================================================
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 split.o emptyiseg.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=m.placement --map=m.map -o m.elf
# RUN: %python %S/Inputs/placement-positions.py check m.elf --object split.o emptyiseg.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 1 0x10000 slice 0 0x010000 0xffff slice 0xffff 0x01ffff 0x1 rec 1 1 2 0x1 slice 0 0xff0201 0x1 rec 1 2 0 0x0 slice 0 0x0 0x0 | FileCheck %s --check-prefix=MREC
# MREC: pos: objects=2 records=4
# MREC: pos: rec object=0 shndx=2 space=1 size=0x10000 slices=0,0x10000,0xffff 65535,0x1ffff,0x1
# MREC: pos: rec object=1 shndx=2 space=0 size=0x0 slices=0,0x0,0x0
# --- the canonical split record's frozen 48-byte body (design 11.1):
# RUN: llvm-readelf -x .mcs251.placement.positions m.elf | FileCheck %s --check-prefix=MHEX
# MHEX-NOT: foobar
# MHEX: 0x00000000 00000007 000000ec 00000003 4d435332
# MHEX-NEXT: 0x00000010 35310000 00000001 00000002 00000004
# MHEX: 0x00000080 00ff0200 00000001 00000030 00000000
# MHEX-NEXT: 0x00000090 00000002 01000000 00010000 00000002
# MHEX-NEXT: 0x000000a0 00000000 00010000 0000ffff 0000ffff
# MHEX-NEXT: 0x000000b0 0001ffff 00000001

# Determinism + the three audit-mode cells produce ONE carrier.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 split.o emptyiseg.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement --map=m2.map -o other-dir/m2.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 split.o emptyiseg.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=m3.placement --verify-placement --map=m3.map -o m3.elf
# RUN: %python %S/Inputs/placement-positions.py same-carrier m.elf other-dir/m2.elf | FileCheck %s --check-prefix=SAME
# RUN: %python %S/Inputs/placement-positions.py same-carrier m.elf m3.elf
# SAME: same-carrier: {{[0-9]+}} bytes identical

# =====================================================================
# The twelve frozen positive classes (design 11.1).
# =====================================================================
# Class C1 -- plain single-slice CODE + DSEG NOBITS + an owned fixed entity.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 dsegn.o fixed.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c1.placement --map=c1.map -o c1.elf
# RUN: %python %S/Inputs/placement-positions.py check c1.elf --object dsegn.o fixed.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 0 0x8 slice 0 0x0 0x8 rec 1 1 2 0x1 slice 0 0xff0201 0x1 rec 1 2 0 0x4 slice 0 0x40 0x4 | FileCheck %s --check-prefix=C1
# C1: pos: objects=2 records=4
# C1: pos: rec object=1 shndx=2 space=0 size=0x4 slices=0,0x40,0x4
# Class C2 -- two anonymous unmarked XSEG inputs, same region, different shndx.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 twox.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c2.placement --map=c2.map -o c2.elf
# RUN: %python %S/Inputs/placement-positions.py check c2.elf --object twox.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 1 0x4 slice 0 0x010000 0x4 rec 0 3 1 0x4 slice 0 0x010004 0x4 | FileCheck %s --check-prefix=C2
# C2: pos: rec object=0 shndx=2 space=1 size=0x4 slices=0,0x10000,0x4
# C2: pos: rec object=0 shndx=3 space=1 size=0x4 slices=0,0x10004,0x4
# Class C3 -- the canonical G13b split itself is frozen by MHEX above (0xffff + 1).
# Class C4 -- two same-name input sections merged into ONE PT_LOAD (duplicate
# object occurrence also covers C11).
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 samename.o samename.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c4.placement --map=c4.map -o c4.elf
# RUN: llvm-readelf -l c4.elf | FileCheck %s --check-prefix=C4L
# C4L: LOAD {{0x[0-9a-f]+}} 0x00ff0200 0x00ff0200 0x00004
# C4L-NOT: LOAD
# RUN: %python %S/Inputs/placement-positions.py check c4.elf --object samename.o samename.o --expect rec 0 1 2 0x2 slice 0 0xff0200 0x2 rec 1 1 2 0x2 slice 0 0xff0202 0x2 | FileCheck %s --check-prefix=C4
# C4: pos: objects=2 records=2
# C4: pos: digest[0]={{[0-9a-f]+}}
# C4: pos: digest[1]={{[0-9a-f]+}}
# Class C5 -- overlay members share the group base with different lengths.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ovl.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c5.placement --map=c5.map -o c5.elf
# RUN: %python %S/Inputs/placement-positions.py check c5.elf --object ovl.o --expect rec 0 2 0 0x8 slice 0 0x0 0x8 rec 0 3 0 0x4 slice 0 0x0 0x4 | FileCheck %s --check-prefix=C5
# C5: pos: rec object=0 shndx=2 space=0 size=0x8 slices=0,0x0,0x8
# C5: pos: rec object=0 shndx=3 space=0 size=0x4 slices=0,0x0,0x4
# Classes C6 and C9 -- the empty ISEG record is MREC's (1,2); a zero-length pinned VECS
# input member keeps the HOME..VECS..BOOT holes.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 vecs0.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c6.placement --map=c6.map -o c6.elf
# RUN: %python %S/Inputs/placement-positions.py check c6.elf --object vecs0.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 2 0x0 slice 0 0xff0003 0x0 | FileCheck %s --check-prefix=C6
# C6: pos: rec object=0 shndx=2 space=2 size=0x0 slices=0,0xff0003,0x0
# Class C7 -- the sole ALLOC exemption (empty ALLOC|WRITE PROGBITS .data with no
# symbol has NO record; every other section is still covered.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 datapt.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c7.placement --map=c7.map -o c7.elf
# RUN: %python %S/Inputs/placement-positions.py check c7.elf --object datapt.o --expect no-record 0 3 rec 0 1 2 0x1 slice 0 0xff0200 0x1 | FileCheck %s --check-prefix=C7
# C7: pos: objects=1 records=1
# Class C8 -- the G8-migrated dseg carries its POST-migration address in the EDATA
# window and stays storage space 0.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 g8.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c8.placement --map=c8.map -o c8.elf
# RUN: %python %S/Inputs/placement-positions.py check c8.elf --object g8.o --expect rec 0 2 0 0x100 slice 0 0x100 0x100 | FileCheck %s --check-prefix=C8
# C8: pos: rec object=0 shndx=2 space=0 size=0x100 slices=0,0x100,0x100
# Class C10 -- an object with no ALLOC section still occupies the fingerprint table.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 emptyiseg.o noalloc.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c10.placement --map=c10.map -o c10.elf
# RUN: %python %S/Inputs/placement-positions.py check c10.elf --object emptyiseg.o noalloc.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 0 0x0 slice 0 0x0 0x0 | FileCheck %s --check-prefix=C10
# C10: pos: objects=2 records=2
# C10: pos: digest[1]={{[0-9a-f]+}}
# Class C12 -- the three audit cells share one carrier (SAME above).

# =====================================================================
# The structural negative set (design 11.2).  Mother = m.elf; every
# variant is a fixed-point byte mutation; rc must be EXACTLY 1.
# =====================================================================
# V: the helper runs the verifier on a mutated ELF with the mother's own
# report/map/objects.
# RUN: true

# --- carrier: missing (a plain, non-audit ELF has none).
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 split.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --keep-symbols --map=plain.map -o plain.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=plain.elf --report=m.placement --link-map=m.map --object=split.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NMISS
# NMISS: carries no .mcs251.placement.positions positioning carrier

# --- carrier: duplicate section / header shape / offset / reuse / bounds.
# RUN: %python %S/Inputs/audit-mutate.py pos-dup-sec m.elf n1.elf && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n1.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NDUP
# NDUP: the section appears 2 times
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n2.elf type 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n2.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE
# NSHAPE: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n3.elf flags 2 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n3.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE2
# NSHAPE2: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n4.elf align 0 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n4.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE3
# NSHAPE3: raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n5.elf addr 0x100 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n5.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE4
# NSHAPE4: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n6.elf offset 0x31 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n6.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NOFF
# NOFF: is not at a 4-byte file offset
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n7.elf offset 0x30 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n7.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NREUSE1
# NREUSE1: reuses the ELF header's file bytes
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n8.elf size 0x7fffffff && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n8.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NBOUND
# NBOUND: out of file bounds

# --- envelope.
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n9.elf namesz 8 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n9.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNAMESZ
# NNAMESZ: namesz 8 != 7
# RUN: %python %S/Inputs/audit-mutate.py pos-name m.elf n10.elf 0 0x4e && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n10.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNAME
# NNAME: the note name is not MCS251
# RUN: %python %S/Inputs/audit-mutate.py pos-name m.elf n11.elf 7 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n11.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNAMESZ2
# NNAMESZ2: the note name is not MCS251
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n12.elf type 4 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n12.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNTYPE
# NNTYPE: note type 4 != 3
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n13.elf descsz 0x50 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n13.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NDESC
# NDESC: descsz does not cover the section
# RUN: %python %S/Inputs/audit-mutate.py pos-move m.elf n14.elf 00 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n14.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NTAIL
# NTAIL: descsz does not cover the section

# --- descriptor header.
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n15.elf version 0 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n15.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NVER
# NVER: position_version 0 != 1
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n16.elf version 2 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n16.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NVER2
# NVER2: position_version 2 != 1
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n17.elf reserved 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n17.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NRES
# NRES: the descriptor reserved field is not zero
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n18.elf objects 0x10000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n18.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NOBJT
# NOBJT: the object fingerprint table is truncated
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n19.elf records 3 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n19.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NUNC
# NUNC: unconsumed bytes after the record table
