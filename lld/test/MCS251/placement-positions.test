# NSLCOV: record 0: slice_count is not a legal count
# --- object association: MORE --object inputs than the carrier lists.
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=m.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NOBJS2
# NOBJS2: lists 2 objects but 3 --object inputs were given
