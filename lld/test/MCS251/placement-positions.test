# RUN: %python %S/Inputs/audit-mutate.py pos-record c1.elf n57.elf field 1 space8 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n57.elf --report=c1.placement --link-map=c1.map --object=dsegn.o --object=fixed.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSPD
