# --- exemption misuse: the producer refuses to LINK an empty .data that
# carries a symbol (its own keep-item); the verifier's independent
# exemption conditions are reached by re-pointing the link's object at a
# variant input whose fingerprint the carrier records (design 11.2's
# fixture-tool note).
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 datapt-sym.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c7s.placement --map=c7s.map -o c7s.elf | FileCheck %s --check-prefix=NPROD
# NPROD: empty PROGBITS .data with defined symbol is not supported
# RUN: %python %S/Inputs/audit-mutate.py carrier-digest c7.elf c7x.elf 0 datapt-sym.o && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=c7x.elf --report=c7.placement --link-map=c7.map --object=datapt-sym.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NEXEM
# NEXEM: carries a defined symbol; the .data exemption does not apply

# =====================================================================
# Coverage completions for the design-11.2 matrix (second audit): the
# remaining per-field shape/envelope/space/mirror variants, each still a
# fixed-point mutation with the EXACT exit code 1.  The "a legal key
# replaced by another legal key" cell is covered by the union of NDUPK
# (duplicate key), NORD (reorder), NSHN3 (re-targeted key) and NDROP (the
# orphaned section): a complete mother leaves no unused legal key, so every
# replacement lands in one of those four verdicts.
# =====================================================================
# --- carrier shape: link / info / entsize.
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n42.elf link 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n42.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE5
# NSHAPE5: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n43.elf info 1 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n43.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE6
# NSHAPE6: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# RUN: %python %S/Inputs/audit-mutate.py pos-sec m.elf n44.elf entsize 4 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n44.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSHAPE7
# NSHAPE7: is not a non-ALLOC flags=0 link=0 info=0 raw-align=4 entsize=0 SHT_NOTE
# --- envelope: the name's own NUL, a LONG descsz, a second NOTE.
# RUN: %python %S/Inputs/audit-mutate.py pos-name m.elf n45.elf 6 0x41 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n45.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNUL
# NNUL: the note name is not MCS251
# RUN: %python %S/Inputs/audit-mutate.py pos-note m.elf n46.elf descsz 0x100 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n46.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NDESCL
# NDESCL: descsz does not cover the section
# RUN: %python %S/Inputs/audit-mutate.py pos-move m.elf n47.elf 0000000700000000000000034d4353323531000000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n47.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NNOTE2
# NNOTE2: descsz does not cover the section
# --- descriptor: a slice count whose 12x product leaves the u32 range.
