# NREUSE2: the section reuses the file bytes of .mcs251.load.0

# =====================================================================
# R5 fix round (design §7.4/§7.5 + review R5-1..R5-9).  Every negative is
# asserted with the EXACT exit code 1 and the target diagnostic; every legal
# control is asserted 0 on the same artifact family.
# =====================================================================
# --- R5-1: the frozen split regeneration can legally yield ONE slice.
# --- Control A: a 4-byte marked XSEG at 0x010000 canonicalises to one slice.
# RUN: yaml2obj split4.yaml -o t.o && %python v2flags.py t.o && mv t.o split4.o
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 split4.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=s4.placement --map=s4.map -o s4.elf
# RUN: %python %S/Inputs/placement-positions.py check s4.elf --object split4.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 1 0x4 slice 0 0x010000 0x4 | FileCheck %s --check-prefix=SPLONE
# SPLONE: pos: rec object=0 shndx=2 space=1 size=0x4 slices=0,0x10000,0x4
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=s4.elf --report=s4.placement --link-map=s4.map --object=split4.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# --- the same record re-tiled to 2 bytes is still non-canonical (rc 1).
# RUN: %python %S/Inputs/audit-mutate.py pos-slice s4.elf n68.elf 1 0 length 2 && %python %S/Inputs/audit-mutate.py pos-slice-op n68.elf n68.elf 1 dup 0 && %python %S/Inputs/audit-mutate.py pos-slice n68.elf n68.elf 1 1 offset 2 && %python %S/Inputs/audit-mutate.py pos-slice n68.elf n68.elf 1 1 addr 0x010002 && %python %S/Inputs/audit-mutate.py pos-slice n68.elf n68.elf 1 1 length 2 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n68.elf --report=s4.placement --link-map=s4.map --object=split4.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=SPLBAD
# SPLBAD: does not carry the canonical XSEG-split tiling
# --- Control B: exactly 0xffff bytes canonicalise to one slice too.
# RUN: yaml2obj splitexact.yaml -o t.o && %python v2flags.py t.o && mv t.o splitexact.o
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 splitexact.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=se.placement --map=se.map -o se.elf
# RUN: %python %S/Inputs/placement-positions.py check se.elf --object splitexact.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 1 0xffff slice 0 0x010000 0xffff | FileCheck %s --check-prefix=SPLEX
# SPLEX: pos: rec object=0 shndx=2 space=1 size=0xffff slices=0,0x10000,0xffff
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=se.elf --report=se.placement --link-map=se.map --object=splitexact.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# --- Control C: the multi-window tiling (0xffff + 1) is the M mother's
# --- frozen record, and the mother itself verifies.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=m.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff

# --- R5-3: the raw 32-bit sh_type decides ALLOC classification and the
# --- empty-.data exemption; the producer rejects the same object.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 datapt.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=d2.placement --map=d2.map -o d2.elf
# RUN: %python %S/Inputs/audit-mutate.py sec-type datapt.o raw.o .data 0x10001
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 raw.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 -o raw.elf 2>&1 | FileCheck %s --check-prefix=RAWPROD
# RAWPROD: DSEG sections must be writable NOBITS: .data
# RUN: %python %S/Inputs/audit-mutate.py carrier-digest d2.elf n69.elf 0 raw.o && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n69.elf --report=d2.placement --link-map=d2.map --object=raw.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=RAWDATA
# RAWDATA: the section .data of raw.o cannot be classified into a storage space
# RUN: %python %S/Inputs/audit-mutate.py sec-type datapt.o raw.o .text 0x10001 && %python %S/Inputs/audit-mutate.py carrier-digest d2.elf n70.elf 0 raw.o && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n70.elf --report=d2.placement --link-map=d2.map --object=raw.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=RAWTEXT
# RAWTEXT: the section .text of raw.o cannot be classified into a storage space
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld -flavor mcs251 raw.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 -o raw.elf 2>&1 | FileCheck %s --check-prefix=RAWTEXTP
# RAWTEXTP: invalid flags or type for .text
# --- Control: the unmutated empty .data exemption still verifies.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=d2.elf --report=d2.placement --link-map=d2.map --object=datapt.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff

# --- R5-4: a zero-length record still honours an EXPLICIT per-section pin.
# RUN: yaml2obj dabs0.yaml -o t.o && %python v2flags.py t.o && mv t.o dabs0.o
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 dabs0.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --area-start=.mcs251.DATA.d=0x30 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=z.placement --map=z.map -o z.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=z.elf --report=z.placement --link-map=z.map --object=dabs0.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --area-start=.mcs251.DATA.d=0x30 --edata-end=0x3fff
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr z.elf z-move.elf 0 dabs0.o .mcs251.DATA.d 0x40 && %python %S/Inputs/audit-mutate.py map-section z.map z-move.map dabs0.o:.mcs251.DATA.d 0x40 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=z-move.elf --report=z.placement --link-map=z-move.map --object=dabs0.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --area-start=.mcs251.DATA.d=0x30 --edata-end=0x3fff | FileCheck %s --check-prefix=ZPIN
# ZPIN: is placed at 0x40 but the pinned --area-start value is 0x30

# --- R5-9: the final ELF never establishes a PT_NOTE over the carrier.
# RUN: %python %S/Inputs/audit-mutate.py elf-add-carrier-ptnote m.elf n71.elf && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n71.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NPTNOTE
# NPTNOTE: unexpected PT_NOTE in the final ELF

# --- PT_LOAD memory span: the widened end p_vaddr+p_memsz must stay in space.
# RUN: %python %S/Inputs/audit-mutate.py elf-phdr m.elf n72.elf 0 memsz 0xffffffff && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n72.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NMEMEND
# NMEMEND: (vaddr + memsz, widened) leaves its address space

# --- R5-2: same-name file-scoped definitions must have a unique source.  Two
# --- objects each define a dynamic local `dyn`; the merged table carries two
# --- output locals, so no per-input source is established (R5 fail-closed).
# RUN: yaml2obj localdyn.yaml -o ldy-v1.o && %python v2flags.py ldy-v1.o && mv ldy-v1.o ldy.o
# RUN: yaml2obj localdyn2.yaml -o ldy2-v1.o && %python v2flags.py ldy2-v1.o && mv ldy2-v1.o ldy2.o
# RUN: yaml2obj localdyn3.yaml -o ldy3-v1.o && %python v2flags.py ldy3-v1.o && mv ldy3-v1.o ldy3.o
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldy2.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=ldy.placement --map=ldy.map -o ldy.elf
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=ldy.elf --report=ldy.placement --link-map=ldy.map --object=ldy.o --object=ldy2.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NLOCAL
# NLOCAL: file-scoped symbol dyn is not uniquely identifiable in the final symbol table
# --- an exact duplicate output local row: two symbols share the value.
# RUN: %python %S/Inputs/audit-mutate.py elf-dup-sym ldy.elf ldy-dup.elf dyn && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=ldy-dup.elf --report=ldy.placement --link-map=ldy.map --object=ldy.o --object=ldy2.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NDUPL
# NDUPL: share the expected value
# --- the swapped locations with the symbol table held fixed: the same-name
# --- borrow is refused instead of using the other object's symbol.
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr ldy.elf ldy-sw.elf 0 ldy.o .mcs251.XSEG 0x010004 && %python %S/Inputs/audit-mutate.py carrier-addr ldy-sw.elf ldy-sw.elf 1 ldy2.o .mcs251.XSEG 0x010000 && %python %S/Inputs/audit-mutate.py map-section ldy.map ldy-sw.map ldy.o:.mcs251.XSEG 0x010004 && %python %S/Inputs/audit-mutate.py map-section ldy-sw.map ldy-sw.map ldy2.o:.mcs251.XSEG 0x010000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=ldy-sw.elf --report=ldy.placement --link-map=ldy-sw.map --object=ldy.o --object=ldy2.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSWAP
# NSWAP: is not uniquely identifiable in the final symbol table
# --- Control: DISTINCT dynamic local names still verify (no over-rejection).
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldy3.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=ld3.placement --map=ld3.map -o ld3.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=ld3.elf --report=ld3.placement --link-map=ld3.map --object=ldy.o --object=ldy3.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff

# =====================================================================
# R6 fix round (review R6-1/R6-2).  R6-1: a same-name file-scoped set is
# only un-disambiguable when the retained output fields (TYPE, SIZE) and an
# applicable independent address anchor (per-section pin / owned entity) all
# fail to single out one source.  The positives below are legal inputs that
# must verify; the negatives keep the R5-2 fail-closed core (identical
# definitions keep rc1, and a swap that contradicts the retained shape is
# refused too -- a naive "drop the same-name rejection" fix would accept it).
# R6-2: a PT_LOAD's storage space comes from the classified input sections it
# loads, never from the numeric p_vaddr; CODE may legally span 0x10000.
# =====================================================================
# RUN: yaml2obj localdyn-size8.yaml -o t.o && %python v2flags.py t.o && mv t.o ldy8.o
# RUN: yaml2obj localdyn-notype.yaml -o t.o && %python v2flags.py t.o && mv t.o ldyn.o
# RUN: yaml2obj localdyn-func.yaml -o t.o && %python v2flags.py t.o && mv t.o ldyf.o
# RUN: yaml2obj localdyn-pina.yaml -o t.o && %python v2flags.py t.o && mv t.o ldpa.o
# RUN: yaml2obj localdyn-pinb.yaml -o t.o && %python v2flags.py t.o && mv t.o ldpb.o
# RUN: yaml2obj lowcode.yaml -o t.o && %python v2flags.py t.o && mv t.o lowcode.o

# --- R6-1 (1/4): two OBJECT locals `dyn` with st_size 4 and 8.  The retained
# --- size singles out each source, so both inputs verify.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldy8.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=r6s.placement --map=r6s.map -o r6s.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=r6s.elf --report=r6s.placement --link-map=r6s.map --object=ldy.o --object=ldy8.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# RUN: llvm-readelf -s r6s.elf | FileCheck %s --check-prefix=R6SIZE
# R6SIZE: 00010000 4 OBJECT LOCAL DEFAULT ABS dyn
# R6SIZE: 00010004 8 OBJECT LOCAL DEFAULT ABS dyn

# --- R6-1 (2/4): OBJECT and NOTYPE locals with the same name.  The retained
# --- type singles out each source.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldyn.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=r6t.placement --map=r6t.map -o r6t.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=r6t.elf --report=r6t.placement --link-map=r6t.map --object=ldy.o --object=ldyn.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# RUN: llvm-readelf -s r6t.elf | FileCheck %s --check-prefix=R6TYPE
# R6TYPE: 00010000 4 OBJECT LOCAL DEFAULT ABS dyn
# R6TYPE: 00010004 4 NOTYPE LOCAL DEFAULT ABS dyn

# --- R6-1 (3/4): an OBJECT `dyn` in XSEG and a FUNC `dyn` in .text: the
# --- retained type (and their separate address spaces) single out each source.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldyf.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=r6c.placement --map=r6c.map -o r6c.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=r6c.elf --report=r6c.placement --link-map=r6c.map --object=ldy.o --object=ldyf.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# RUN: llvm-readelf -s r6c.elf | FileCheck %s --check-prefix=R6SEC
# R6SEC: 00010000 4 OBJECT LOCAL DEFAULT ABS dyn
# R6SEC: 00ff0203 4 FUNC LOCAL DEFAULT 1 dyn

# --- R6-1 (4/4): identical OBJECT locals in two DIFFERENT XSEG sections, each
# --- explicitly pinned to its own address.  The independent pin is the source
# --- witness, so this legal input verifies.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldpa.o ldpb.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --area-start=.mcs251.XSEG.a=0x10020 --area-start=.mcs251.XSEG.b=0x10040 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=r6p.placement --map=r6p.map -o r6p.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=r6p.elf --report=r6p.placement --link-map=r6p.map --object=ldpa.o --object=ldpb.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --area-start=.mcs251.XSEG.a=0x10020 --area-start=.mcs251.XSEG.b=0x10040 --edata-end=0x3fff
# RUN: llvm-readelf -s r6p.elf | FileCheck %s --check-prefix=R6PIN
# R6PIN: 00010020 4 OBJECT LOCAL DEFAULT ABS dyn
# R6PIN: 00010040 4 OBJECT LOCAL DEFAULT ABS dyn

# --- R6-1 guard: swapping the two locations while the output table keeps the
# --- distinct shapes.  The input's shape no longer matches the symbol at its
# --- recorded value, so the source is not established (rc1).  A fix that
# --- merely dropped the same-name rejection would wrongly accept this.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 ldy.o ldyn.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=r6t.placement --map=r6t.map -o r6t.elf
# RUN: %python %S/Inputs/audit-mutate.py carrier-addr r6t.elf n74.elf 0 ldy.o .mcs251.XSEG 0x010004 && %python %S/Inputs/audit-mutate.py carrier-addr n74.elf n74.elf 1 ldyn.o .mcs251.XSEG 0x010000 && %python %S/Inputs/audit-mutate.py map-section r6t.map n74.map ldy.o:.mcs251.XSEG 0x010004 && %python %S/Inputs/audit-mutate.py map-section n74.map n74.map ldyn.o:.mcs251.XSEG 0x010000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n74.elf --report=r6t.placement --link-map=n74.map --object=ldy.o --object=ldyn.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSWAP

# --- R6-2: a legal low-address CODE image crossing 64K.  CSEG at 0xfffe makes
# --- .text span [0xfffe,0x10002); it is CODE ([0,0x1000000)), not AS0-DATA.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 lowcode.o --area-start=CSEG=0xfffe --flash-base=0 --flash-size=0x20000 --placement-report=lc.placement --map=lc.map -o lc.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=lc.elf --report=lc.placement --link-map=lc.map --object=lowcode.o --area-start=CSEG=0xfffe --flash-base=0 --flash-size=0x20000
# RUN: llvm-readelf -l lc.elf | FileCheck %s --check-prefix=R6LOW
# R6LOW: LOAD {{0x[0-9a-f]+}} 0x0000fffe 0x0000fffe 0x00004 0x00004
# --- the producer's own integrated --verify-placement must accept the same
# --- image (the R6 finding was a producer/verifier disagreement).
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 lowcode.o --area-start=CSEG=0xfffe --flash-base=0 --flash-size=0x20000 --verify-placement -o lc-int.elf
# --- boundary controls: the same memory end on either side of 0x10000.
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 lowcode.o --area-start=CSEG=0xfffc --flash-base=0 --flash-size=0x20000 --placement-report=lf.placement --map=lf.map -o lf.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=lf.elf --report=lf.placement --link-map=lf.map --object=lowcode.o --area-start=CSEG=0xfffc --flash-base=0 --flash-size=0x20000
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-lld -flavor mcs251 lowcode.o --area-start=CSEG=0x10000 --flash-base=0 --flash-size=0x20000 --placement-report=lg.placement --map=lg.map -o lg.elf
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=lg.elf --report=lg.placement --link-map=lg.map --object=lowcode.o --area-start=CSEG=0x10000 --flash-base=0 --flash-size=0x20000

# --- n73 (matrix §11 diagnostic migration): the segment is moved to 0 and
# --- widened, but the ORIGINAL CODE record at 0xff0200 still demands file
# --- coverage.  The rejection is now produced by the CODE byte-coverage rule
# --- (B-COVER), NOT by any "real AS0 segment overflow" attribution: NOBITS
# --- never constrains the segment's space, so the same rc=1 rests on correct
# --- evidence.  NMEMEND stays owned by n72's genuine 24-bit overflow above.
# RUN: %python %S/Inputs/audit-mutate.py elf-phdr c1.elf n73.elf 0 vaddr 0x0 && %python %S/Inputs/audit-mutate.py elf-phdr n73.elf n73.elf 0 memsz 0x10001 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n73.elf --report=c1.placement --link-map=c1.map --object=dsegn.o --object=fixed.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=N73COVER
# N73COVER: its PROGBITS range has no PT_LOAD file coverage at 0xff0200

#--- attr.py
# Fill the ATTRHEX placeholder in every fixture with the frozen ABI blob.
import glob
ATTR = ''
for f in glob.glob('*.yaml'):
    t = open(f).read()
    if 'ATTRHEX' in t:
        open(f, 'w').write(t.replace('ATTRHEX', ATTR))

#--- v2flags.py
# yaml2obj only registers the v1 enum; rewrite e_flags to the v2 ABI word.
import sys
for name in sys.argv[1:]:
    try:
        b = bytearray(open(name, 'rb').read())
    except FileNotFoundError:
        continue
    assert len(b) >= 40, name
    b[36:40] = bytes.fromhex('00000102')
    open(name, 'wb').write(bytes(b))

#--- split.yaml
# One CODE byte + a G13b split XSEG of exactly 0x10000 bytes at 0x010000:
# the canonical tiling is 0xffff + 1 across the 64K boundary.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcs251.XSEG
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE, SHF_MCS251_XSEG_SPLIT ]
    AddressAlign: 1
    Size: 0x10000
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ATTRHEX
Symbols:
  - Name: big
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG
    Size: 0x10000

