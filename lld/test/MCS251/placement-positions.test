#--- localdyn.yaml
# R5-2: a dynamic (non-owned) XSEG section with a file-scoped `dyn`.  Two
# objects of this shape merge into one output with two locals of that name,
# which no output-symbol association protocol can tell apart.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '000000'
  - Name: .mcs251.XSEG
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ATTRHEX
Symbols:
  - Name: dyn
    Binding: STB_LOCAL
    Type: STT_OBJECT
    Section: .mcs251.XSEG
    Size: 4

