# RUN: %python %S/Inputs/audit-mutate.py pos-record c5.elf n58.elf field 1 space8 2 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n58.elf --report=c5.placement --link-map=c5.map --object=ovl.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSPO
