# RUN: %python %S/Inputs/audit-mutate.py pos-record cx.elf n59.elf field 2 space8 0 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n59.elf --report=cx.placement --link-map=cx.map --object=xinitin.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NSPX
