# RUN: %python %S/Inputs/audit-mutate.py pos-record c7.elf n53.elf append 0 && %python %S/Inputs/audit-mutate.py pos-record n53.elf n53.elf field 1 shndx 2 && %python %S/Inputs/audit-mutate.py pos-record n53.elf n53.elf field 1 input 0 && %python %S/Inputs/audit-mutate.py pos-slice n53.elf n53.elf 1 0 length 0 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n53.elf --report=c7.placement --link-map=c7.map --object=datapt.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NEXTRA
