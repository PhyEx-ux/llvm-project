# NINP: records 2 bytes but the input section is 1 bytes
# --- slice canon: a re-tiling of the same range; a plain section re-sliced.
# RUN: %python %S/Inputs/audit-mutate.py pos-slice m.elf n55.elf 1 0 length 0x8000 && %python %S/Inputs/audit-mutate.py pos-slice n55.elf n55.elf 1 1 offset 0x8000 && %python %S/Inputs/audit-mutate.py pos-slice n55.elf n55.elf 1 1 addr 0x018000 && %python %S/Inputs/audit-mutate.py pos-slice n55.elf n55.elf 1 1 length 0x8000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n55.elf --report=m.placement --link-map=m.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NTILE
# NTILE: does not carry the canonical XSEG-split tiling
