# RUN: %python %S/Inputs/audit-mutate.py pos-slice c8.elf n61.elf 1 0 addr 0x8000 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n61.elf --report=c8.placement --link-map=c8.map --object=g8.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NWIN
# NWIN: outside its allocation window (the DSEG low window)
# --- position: region membership, symbol, per-section pin.
# RUN: %python %S/Inputs/audit-mutate.py pos-slice m.elf n62.elf 1 0 addr 0x010001 && %python %S/Inputs/audit-mutate.py pos-slice n62.elf n62.elf 1 0 length 0xffff && %python %S/Inputs/audit-mutate.py pos-slice n62.elf n62.elf 1 1 offset 0xffff && %python %S/Inputs/audit-mutate.py pos-slice n62.elf n62.elf 1 1 addr 0x020000 && %python %S/Inputs/audit-mutate.py pos-slice n62.elf n62.elf 1 1 length 1 && %python %S/Inputs/audit-mutate.py map-section m.map n62.map split.o:.mcs251.XSEG 0x010001 && %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=n62.elf --report=m.placement --link-map=n62.map --object=split.o --object=emptyiseg.o --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff | FileCheck %s --check-prefix=NREG
# NREG: outside the final ELF's XSEG region
