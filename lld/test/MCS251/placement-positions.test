# RUN: %python %S/Inputs/placement-positions.py check cx.elf --object xinitin.o --expect rec 0 1 2 0x1 slice 0 0xff0200 0x1 rec 0 2 0 0x4 slice 0 0x0 0x4 rec 0 3 2 0xa slice 0 0xff8000 0xa | FileCheck %s --check-prefix=CXI
