#--- xinit-past.yaml
# Object size 0x00FA (250) at destination 0x0100 runs past the migrated
# 200-byte slice (end 0x01c8): the destination whitelist must still reject it.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
