#--- xinit-clear.yaml
# The clear-only record (payload 0, object size 200) targets a marked slice
# that must migrate.  The object also DEFINES __mcs251_globals_init so the
# linker actually runs the destination whitelist this record exercises.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcs251.dseg
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE, SHF_MCS251_EDATA_MOVABLE ]
    AddressAlign: 1
    Size: 200
  - Name: .mcs251.xinit
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC ]
    AddressAlign: 1
    Content: '000000C80000'
  - Name: .rela.mcs251.xinit
    Type: SHT_RELA
    Link: .symtab
    Info: .mcs251.xinit
    Relocations:
      - Offset: 0
        Type: R_MCS251_16
        Symbol: _xclear
        Addend: 0
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  - Name: _xclear
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.dseg
  - Name: __mcs251_globals_init
    Binding: STB_GLOBAL
    Type: STT_FUNC
    Section: .text

