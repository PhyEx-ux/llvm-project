#--- osegfail.yaml
# OSEG (leaf parameter-slot overlay group) placement failure: the UNMARKED
# 100-byte global leaves 28 bytes in the low window, less than the 40-byte
# leaf overlay.  No candidate can free the window, so the overlay must fail
# closed instead of being laid over the global it does not fit beside.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: 'C0D00000'
  - Name: .mcs251.dseg
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 100
  - Name: .mcs251.OSEG.0
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE, SHF_MCS251_OVERLAY ]
    AddressAlign: 1
    Size: 40
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: 
Symbols:
  - Name: __u100
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.dseg
  - Name: _leaf_PARM_1
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.OSEG.0

#--- migratex.yaml
# Candidate exhaustion AFTER a successful migration: the marked 80-byte slice
# is migrated to EDATA (freeing the low window), but the remaining UNMARKED
# 100-byte + 30-byte slices still do not fit together.  With no candidate left
# the link must fail closed on the ledger that holds the migrated 80B in EDATA
# and the 100B in the low window.
--- !ELF
FileHeader:
