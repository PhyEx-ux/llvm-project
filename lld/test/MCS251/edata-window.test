    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.dseg
  - Name: _wide_PARM_2
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcs251.DSEG.1

#--- unmarked100.yaml
