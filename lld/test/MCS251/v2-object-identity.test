#--- nullcarrier.py
#!/usr/bin/env python3
"""Build the A4W4-R1 regression inputs from a yaml2obj v2 object.

The ELF index-0 section header cannot be named by yaml2obj, so this script
edits the section header table directly: the carrier's header (located by its
registered type 0x70000003) moves into slot 0 with sh_type zeroed to SHT_NULL
and sh_flags set from the command line; the vacated slot receives a copy of
the first SHT_STRTAB header, so the only section carrying the carrier *name*
is the null section.  Usage: nullcarrier.py <in.o> <out.o> <flags>."""
import pathlib
import struct
import sys

src, dst, flags = sys.argv[1], sys.argv[2], int(sys.argv[3])
b = bytearray(pathlib.Path(src).read_bytes())
shoff = int.from_bytes(b[32:36], 'big')
shnum = int.from_bytes(b[48:50], 'big')
headers = [struct.unpack_from('>10I', b, shoff + 40 * i) for i in range(shnum)]
carrier = next(i for i, h in enumerate(headers) if h[1] == 0x70000003)
strtab = next(i for i, h in enumerate(headers) if h[1] == 3)  # SHT_STRTAB
# Slot 0 becomes the carrier header: name offset, offset and size survive,
# but the type is SHT_NULL and the flags word is the variant under test.
b[shoff:shoff + 40] = b[shoff + 40 * carrier:shoff + 40 * (carrier + 1)]
b[shoff + 4:shoff + 8] = bytes(4)
b[shoff + 8:shoff + 12] = flags.to_bytes(4, 'big')
# The vacated slot becomes an ordinary duplicate string-table header.
b[shoff + 40 * carrier:shoff + 40 * (carrier + 1)] = \
    b[shoff + 40 * strtab:shoff + 40 * (strtab + 1)]
pathlib.Path(dst).write_bytes(bytes(b))


