#--- dupcarrier.py
#!/usr/bin/env python3
"""Build the duplicate-carrier regression input from a yaml2obj v2 object.

yaml2obj refuses two sections with the same name, so the second carrier is
created by copying the carrier's whole section header over the .text header
slot (the mutation the W4 review reproduced with): the object then carries
two same-named, carrier-shaped sections and must be refused by the carrier
cardinality rule, not by a shape accident.  Usage: dupcarrier.py <in> <out>."""
import pathlib
import struct
import sys

src, dst = sys.argv[1], sys.argv[2]
b = bytearray(pathlib.Path(src).read_bytes())
shoff = int.from_bytes(b[32:36], 'big')
shnum = int.from_bytes(b[48:50], 'big')
headers = [struct.unpack_from('>10I', b, shoff + 40 * i) for i in range(shnum)]
carrier = next(i for i, h in enumerate(headers) if h[1] == 0x70000003)
text = next(i for i, h in enumerate(headers) if h[1] == 1)  # SHT_PROGBITS
b[shoff + 40 * text:shoff + 40 * (text + 1)] = \
    b[shoff + 40 * carrier:shoff + 40 * (carrier + 1)]
pathlib.Path(dst).write_bytes(bytes(b))

