  - Name: .mcs251.DSEG.aligned
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 2
    Size: 4
  - Name: .note.mcs251.abi
    Type: SHT_NOTE
    AddressAlign: 4
