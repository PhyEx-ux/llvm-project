#
# G2/B-S3 (design R3 4.7, "P-4 interaction positive/negative examples"): the
# variadic interaction matrix of the P-4 function-signature cross-object
# comparison.  Every object below is the yaml twin of a real clang -cc1 + llc
# product (v2 contract 1,2,32,8,1, Tag 28 emitted by the B-S2 toolchain), so
# the attribute bytes are the wire truth, not hand-crafted values.  The C
# source of each twin is quoted above its yaml block together with the
# `!mcs251.signatures` nodes clang actually produced.
#
# Matrix (record fields in play: role bit3 = variadic, param_count = fixed
# parameters only, compareRecords order = no-proto bit, THEN param_count,
# THEN bitmap, THEN ret, THEN bit3, THEN call_abi):
#   P1 pass    variadic definition (role 9, count 1) x variadic caller
#              declaration (role 10, count 1) - bit3=1 on both sides;
#   P2 reject  variadic definition (count 1) x fixed 7-param declaration
#              (role 2, count 7): the COUNT arm fires first (1 vs 7);
#   P3 reject-a fixed 7-param definition ("forgot to rebuild the pre-P-4
#              runtime", role 1/count 7) x variadic caller (count 1): count
#              arm again, 7 vs 1;
#   P3 reject-b a v2 object whose .mcs251.attributes carries no Tag 28 at all
#              (strip28.py removes the record and fixes both envelope size
#              fields): the strict attribute decoder's own "required
#              function_signatures(28) is missing" - the pre-P-4 v2-object
#              rejection path, which variadic does not change;
#   P4 pass    fixed `long mix(long,char,long)` definition x same-proto
#              caller (count 3, bitmap all-zero both sides);
#   P5 reject  fixed definition count 3 x fixed declaration count 2;
#   P6 reject  same fixed count (1), same bitmap, ONLY bit3 differs
#              (variadic declaration TU x fixed declaration TU): the bit3 arm
#              alone - proof the P2/P3 count rejections are not the only
#              variadic-ness defense.
#
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: yaml2obj vdef.yaml -o vdef.o
# RUN: yaml2obj vuse.yaml -o vuse.o
# RUN: yaml2obj fixed7call.yaml -o fixed7call.o
# RUN: yaml2obj fixed7def.yaml -o fixed7def.o
# RUN: yaml2obj mixdef.yaml -o mixdef.o
# RUN: yaml2obj mix3call.yaml -o mix3call.o
# RUN: yaml2obj mix2call.yaml -o mix2call.o
# RUN: yaml2obj vdecl.yaml -o vdecl.o
# RUN: yaml2obj fdecl.yaml -o fdecl.o
# RUN: %python setflags.py vdef.o vuse.o fixed7call.o fixed7def.o mixdef.o mix3call.o mix2call.o vdecl.o fdecl.o
# RUN: cp vuse.yaml vuse-nosig.yaml
# RUN: %python strip28.py vuse-nosig.yaml
# RUN: yaml2obj vuse-nosig.yaml -o vuse-nosig.o
# RUN: %python setflags.py vuse-nosig.o
#
# --- P1 (pass) variadic x variadic links, and the output exists ----------
# RUN: mcs251-lld vdef.o vuse.o --area-start=CSEG=0xff0200 -o %t/p1.elf
# RUN: test -f %t/p1.elf
#
# --- P2 (reject) variadic definition x fixed 7-param declaration --------
# RUN: not mcs251-lld vdef.o fixed7call.o --area-start=CSEG=0xff0200 -o %t/p2.elf 2>&1 | FileCheck %s --check-prefix=P2
# P2: error: fixed7call.o: MCS251 signatures: records '_vsum' have a parameter count conflict (vdef.o vs fixed7call.o): 1 vs 7
# RUN: test ! -e %t/p2.elf
#
# --- P3a (reject) pre-P-4 fixed 7-param definition x variadic caller ----
# RUN: not mcs251-lld fixed7def.o vuse.o --area-start=CSEG=0xff0200 -o %t/p3a.elf 2>&1 | FileCheck %s --check-prefix=P3A
# P3A: error: vuse.o: MCS251 signatures: records '_vsum' have a parameter count conflict (fixed7def.o vs vuse.o): 7 vs 1
# RUN: test ! -e %t/p3a.elf
#
# --- P3b (reject) v2 object with no Tag 28 at all; the strict decoder ----
# --- before any signature comparison could even run ----------------------
# RUN: not mcs251-lld vdef.o vuse-nosig.o --area-start=CSEG=0xff0200 -o %t/p3b.elf 2>&1 | FileCheck %s --check-prefix=P3B
# P3B: error: vuse-nosig.o: MCS251 attributes: required function_signatures(28) is missing
# RUN: test ! -e %t/p3b.elf
#
# --- P4 (pass) fixed signatures agree on count and bitmap, links ---------
# RUN: mcs251-lld mixdef.o mix3call.o --area-start=CSEG=0xff0200 -o %t/p4.elf
# RUN: test -f %t/p4.elf
#
# --- P5 (reject) fixed count disagreement 3 vs 2 -------------------------
# RUN: not mcs251-lld mixdef.o mix2call.o --area-start=CSEG=0xff0200 -o %t/p5.elf 2>&1 | FileCheck %s --check-prefix=P5
# P5: error: mix2call.o: MCS251 signatures: records '_mix' have a parameter count conflict (mixdef.o vs mix2call.o): 3 vs 2
# RUN: test ! -e %t/p5.elf
#
# --- P6 (reject) identical count and bitmap, ONLY role bit3 differs ------
# RUN: not mcs251-lld vdecl.o fdecl.o --area-start=CSEG=0xff0200 -o %t/p6.elf 2>&1 | FileCheck %s --check-prefix=P6
# P6: error: fdecl.o: MCS251 signatures: records '_f' disagree on variadic-ness (bit3 differs) (vdecl.o vs fdecl.o)
# RUN: test ! -e %t/p6.elf
#

#--- setflags.py
#!/usr/bin/env python3
"""Rewrite e_flags to the v2 word (yaml2obj only registers the v1 enum)."""
import pathlib, sys
OFF = 36
for name in sys.argv[1:]:
    p = pathlib.Path(name)
    b = bytearray(p.read_bytes())
    assert len(b) >= OFF + 4, name
    b[OFF:OFF + 4] = bytes.fromhex("00000102")
    p.write_bytes(bytes(b))

#--- strip28.py
#!/usr/bin/env python3
"""Remove the Tag 28 record from .mcs251.attributes in an obj2yaml dump.

Rebuilds the N.3 envelope size fields (VendorSize = sh_size - 1,
ScopeSize = VendorSize - 11) after dropping the record, producing the
byte-exact attributes of a pre-P-4 v2 object.
"""
import pathlib, re, struct, sys
p = pathlib.Path(sys.argv[1])
t = p.read_text()
m = re.search(r'(- Name:\s*\.mcs251\.attributes\n(?:.*\n)*?\s*Content:\s*)([0-9A-F]+)', t)
b = bytes.fromhex(m.group(2))
assert b[0] == 0x41 and b[5:12] == b'MCS251\0' and b[12] == 0x01

def uleb(bb, i):
    v = s = 0
    while True:
        x = bb[i]; i += 1; v |= (x & 0x7f) << s; s += 7
        if not (x & 0x80):
            return v, i

i, out, seen = 17, bytearray(b[:17]), False
while i < len(b):
    tag, i = uleb(b, i); typ = b[i]; i += 1
    ln, i = uleb(b, i); val = b[i:i + ln]; i += ln
    if tag == 28:
        seen = True
        continue
    assert tag < 128 and ln < 128, (tag, ln)
    out += bytes([tag, typ, ln]) + val
assert seen, "no Tag 28 record found"
out[1:5] = struct.pack('>I', len(out) - 1)
out[13:17] = struct.pack('>I', len(out) - 12)
p.write_text(t[:m.start(2)] + out.hex().upper() + t[m.end(2):])

#--- vdef.yaml

