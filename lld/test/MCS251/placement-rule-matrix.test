#--- mxfix.yaml
# An owned fixed DATA entity `dv` at 0x40 (record hash 4ADAFB61).  The B-CLASS
# negative turns its section into PROGBITS + EXECINSTR so the independent
# classifier admits it while its verified space stays AS0.
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcu.fixed.dv
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ATTRHEX
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C01000000000000400000000400000001000000004ADAFB6102647600'
Symbols:
  - Name: _dv
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.dv
    Value: 0
    Size: 4

