#--- mxax.yaml
# R8 §13.2 item 13: an owned fixed DATA entity `ax` at 0x48 whose section
# carries its principal OBJECT `_ax` plus an ADMISSIBLE auxiliary local label
# `ax_aux` (LOCAL NOTYPE, size 0, 0 < value < size).  Producer mergePlacement
# and verifier V11 admit exactly this auxiliary shape; the rule-A shape
# cross-check still applies to it (A-SHAPE on a retained type change).
--- !ELF
FileHeader:
  Class: ELFCLASS32
  Data: ELFDATA2MSB
  Type: ET_REL
  Machine: EM_MCS251
  Flags: [ EF_MCS251_ABI_V1 ]
Sections:
  - Name: .text
    Type: SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    AddressAlign: 1
    Content: '00'
  - Name: .mcu.fixed.ax
    Type: SHT_NOBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    AddressAlign: 1
    Size: 4
  - Name: .mcs251.attributes
    Type: 0x70000003
    AddressAlign: 1
    Content: ATTRHEX
  - Name: .mcs251.placement
    Type: SHT_NOTE
    AddressAlign: 4
    Notes:
      - Name: MCS251
        Type: 1
        Desc: '0000001C01000000000000480000000400000001000000003347B32F02617800'
Symbols:
  - Name: _ax
    Binding: STB_GLOBAL
    Type: STT_OBJECT
    Section: .mcu.fixed.ax
    Value: 0
    Size: 4
  - Name: ax_aux
    Binding: STB_LOCAL
    Type: STT_NOTYPE
    Section: .mcu.fixed.ax
    Value: 1
    Size: 0
