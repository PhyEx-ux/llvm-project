# XDUP: duplicate --placement-report
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=x4.elf -o x4.elf 2>&1 | FileCheck %s --check-prefix=XCONF
# XCONF: placement report path conflicts with another input or output
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=p.o -o x5.elf 2>&1 | FileCheck %s --check-prefix=XCONF
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=x6.map --map=x6.map -o x6.elf 2>&1 | FileCheck %s --check-prefix=XCONF
