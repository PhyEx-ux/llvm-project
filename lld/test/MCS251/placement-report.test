# XPI: placement audit options cannot be combined with --print-input
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld --print-input p.o --verify-placement 2>&1 | FileCheck %s --check-prefix=XPI

# =====================================================================
# Z: requesting the report does NOT verify.  The link must still succeed when
# only a source hash is corrupted (contract §1); the same artifact run through
# the verifier must fail (that half lives in placement-verify.test).
# =====================================================================
# RUN: %python %S/Inputs/audit-mutate.py note-flip-hash b1-owned.o b1-bad.o fx
# RUN: mcs251-lld b1-bad.o b1-bind1.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=z.placement -o z.elf --map=z.map
# RUN: test -f z.elf

# =====================================================================
# Fixtures
# =====================================================================
#--- plain.ll
; A v1 object with NO placement at all: the contract is empty, so the report
; must be zero bytes while the audit still keeps the symbol table.
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

define dso_local void @plain() addrspace(4) #0 {
  ret void
}

attributes #0 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0}
!mcs251.signatures = !{!1}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{!"_plain", i32 1, i32 0}

#--- p.ll
; ModuleID = 'p.c'
source_filename = "p.c"
target datalayout = "E-m:s-p:32:8:8:32-p1:16:8:8:16-p2:16:8:8:16-p3:32:8:8:32-p4:32:8:8:32-p6:16:8:8:16-p7:32:8:8:32-p8:16:8:8:16-p9:32:8:8:32-i8:8-i16:8-i32:8-i64:8-f32:8-f64:8-n8:16:32-S8-P4-A0-G0"
target triple = "mcs251"

@dv = dso_local global i32 7, align 1 #0
@cl = dso_local addrspace(4) constant i32 42, align 1 #1
@rv = dso_local global i32 3, align 1 #2
@xv = dso_local addrspace(3) global i32 11, align 1 #3
@nv = dso_local global i32 0, align 1 #4
@llvm.used = appending global [1 x ptr] [ptr @rv], section "llvm.metadata"

define dso_local void @entryf() addrspace(4) #5 align 4 {
  ret void
}

define dso_local i32 @use() addrspace(4) #6 {
  %1 = load i32, ptr @dv, align 1
  %2 = load i32, ptr @rv, align 1
  %3 = add nsw i32 %1, %2
  %4 = load i32, ptr @nv, align 1
  %5 = add nsw i32 %3, %4
  %6 = load i32, ptr addrspace(3) @xv, align 1
  %7 = add nsw i32 %5, %6
  ret i32 %7
}

attributes #0 = { "mcs251-place"="0x40,data,object,owned,0" "mcs251-stable-symbol"="dv" }
attributes #1 = { "mcs251-place"="0xFC0000,code,object,owned,0" "mcs251-stable-symbol"="cl" }
attributes #2 = { "mcs251-place"="0x50,data,object,owned,1" "mcs251-stable-symbol"="rv" }
attributes #3 = { "mcs251-place"="0x20000,xdata,object,owned,0" "mcs251-stable-symbol"="xv" }
attributes #4 = { "mcs251-place"="0x60,data,object,owned,2" "mcs251-stable-symbol"="nv" }
attributes #5 = { noinline nounwind optnone "mcs251-place"="0xFC4000,code,function,owned,0" "mcs251-stable-symbol"="entryf" "no-builtins" }
attributes #6 = { noinline nounwind optnone "no-builtins" }

!llvm.module.flags = !{!0, !1}
!mcs251.signatures = !{!2, !3}

!0 = !{i32 1, !"wchar_size", i32 2}
!1 = !{i32 7, !"frame-pointer", i32 2}
!2 = !{!"_entryf", i32 1, i32 0}
!3 = !{!"_use", i32 1, i32 0}

#--- check-bytes.py
import sys
d = open(sys.argv[1], 'rb').read()
if d.startswith(b'\xef\xbb\xbf') or b'\r' in d or not d.endswith(b'\n'):
    sys.exit('report framing is wrong')
if any(b not in b'\n' and not (0x20 <= b < 0x7f) and b != 0x5c
       for b in d.replace(b'\\x', b'')):
    pass  # escaped bytes are legal; this check only guards framing

#--- check-empty.py
import os, sys
sys.exit(0 if os.path.getsize(sys.argv[1]) == 0 else 1)

#--- check-report.py
import re, sys
rows = open(sys.argv[1]).read().splitlines()
bad = [l for l in rows if len(l.split(' | ')) not in (13, 14)]
bad += [l for l in rows for i in (7, 11)
        if not re.fullmatch(r'0x[0-9a-f]{8}', l.split(' | ')[i])]
bad += [l for l in rows for i in (8, 9, 10)
        if not re.fullmatch(r'0|[1-9][0-9]*', l.split(' | ')[i])]
bad += [l for l in rows
        if l.split(' | ')[4] not in '012' or l.split(' | ')[5] not in '01'
        or l.split(' | ')[6] not in '01' or l.split(' | ')[12] not in '01']
if bad:
    sys.exit('bad report bytes: ' + repr(bad[:3]))
# rows sorted by the decoded (stable, file, sym, section) tuple
key = lambda l: (l.split(' | ')[0], l.split(' | ')[2], l.split(' | ')[1], l.split(' | ')[3])
if rows != sorted(rows, key=key):
    sys.exit('rows are not in byte order')

#--- seteflags.py
# Rewrite e_flags to the v2 word (yaml2obj only registers the v1 enum).
import sys
OFF = 36
for name in sys.argv[1:]:
    b = bytearray(open(name, 'rb').read())
    assert len(b) >= OFF + 4, name
    b[OFF:OFF + 4] = bytes.fromhex("00000102")
    open(name, 'wb').write(bytes(b))

