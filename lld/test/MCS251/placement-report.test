# G11-D (design §3.4, contract §1/§2, PM ruling R-2026-09-17-3 R1/R2): the
# placement report companion text and its CLI.  Every positive here is a REAL
# B+C product: the embedded IR is verbatim `clang --target=mcs251 -O0 -S
# -emit-llvm` output of a program using the placement attributes, and llc
# materializes the object in the test, so producer provenance is reproducible
# and not hand-patched.
#
# B1 hash fixtures (design §3.4 fixture table, frozen literals): the four
# single-record objects are built from the G11-C yaml fixtures and then
# re-targeted to the design's fixture address A=0x10000 with the record hash
# recomputed, giving exactly H_source 457bdcf1 / e6e499c9 / 396ddf6c /
# 6dd2c36a and H_report 457bdcf1 / 3bfcb603 / 6dd2c36a.  The report-only links
# are the ones the design specifies for B1: they assert the MERGE hash, not the
# verifier.
#
# C2 (PM ruling R-2026-09-18-1 / R-2026-09-18-2): the `.mcs251.placement.names`
# carrier IS consumed today -- an object carrying it is accepted and associated,
# and the bind positives below are asserted, not registered.  A bind record
# WITHOUT the carrier stays refused by the verifier (§3.3/N4) and an object
# without it is refused by the linker ("missing placement name association …
# (recompile placement object)"); the fixtures below therefore all carry the
# association NOTE.
#
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf p.ll -o p.o
# RUN: yaml2obj base.yaml -o b1-owned-v1.o && %python seteflags.py b1-owned-v1.o && mv b1-owned-v1.o b1-owned.o
# RUN: yaml2obj bind-fx.yaml -o b1-bind1-v1.o && %python seteflags.py b1-bind1-v1.o && mv b1-bind1-v1.o b1-bind1.o
# RUN: yaml2obj bind-fx.yaml -o b1-bind4-v1.o && %python seteflags.py b1-bind4-v1.o && mv b1-bind4-v1.o b1-bind4.o
# RUN: yaml2obj retain-gnu.yaml -o b1-retain-v1.o && %python seteflags.py b1-retain-v1.o && mv b1-retain-v1.o b1-retain.o
# RUN: %python %S/Inputs/audit-mutate.py note-addr b1-owned.o b1-owned.o fx 0x10000
# RUN: %python %S/Inputs/audit-mutate.py note-addr b1-retain.o b1-retain.o fx 0x10000
# RUN: %python %S/Inputs/audit-mutate.py note-align b1-bind4.o b1-bind4.o fx 0x4
# RUN: %python %S/Inputs/audit-mutate.py print-notes b1-owned.o | FileCheck %s --check-prefix=FXHASH

# =====================================================================
# FX: the design's frozen fixture hashes, asserted on the input records.
# =====================================================================
# FXHASH: 'addr': 65536, 'size': 4, 'align': 1, 'flags': 0, 'hash': 1165745393
# FXHASH-SAME: 'stable': 'fx'

# =====================================================================
# Every link below uses the board-level window numbers explicitly, so the
# verifier's V13 window is independent of the map's "already placed here".
# =====================================================================

# =====================================================================
# C1..C4: the CLI four-grid.  Default (no audit option) stays byte-identical
# to the pre-D behavior and carries NO symtab; each audit grid cell forces
# KeepSymbols and behaves exactly as the contract's table says.
# =====================================================================
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 -o c1.elf --map=c1.map
# RUN: llvm-readelf -S c1.elf | FileCheck %s --check-prefix=NOSYM
# NOSYM-NOT: .symtab
# --- report-only: symtab present, report written, no verification runs.
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c2.placement -o c2.elf --map=c2.map
# RUN: test -s c2.placement
# RUN: llvm-readelf -S c2.elf | FileCheck %s --check-prefix=HASSYM
# HASSYM: .symtab
# --- the ELF with --keep-symbols alone matches the audit ELF except for
# --- the D2 positioning carrier: --keep-symbols alone must NOT emit it
# --- (design §1.3 emission condition = audit options only), while the audit
# --- ELF carries exactly one .mcs251.placement.positions.  The maps stay
# --- byte-identical.
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --keep-symbols -o c2b.elf --map=c2b.map
# RUN: llvm-readelf -S c2b.elf | FileCheck %s --check-prefix=KEEPSYMONLY
# KEEPSYMONLY-NOT: .mcs251.placement.positions
# RUN: llvm-readelf -S c2.elf | FileCheck %s --check-prefix=AUDITPOS
# AUDITPOS: .mcs251.placement.positions
# RUN: cmp c2.map c2b.map
# --- verify-only: no <output>.placement is left behind, the output is
# --- published, and the private report is cleaned up.
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement -o c3.elf --map=c3.map
# RUN: test -f c3.elf
# RUN: test ! -f c3.elf.placement
# RUN: test ! -f c3.placement
# --- report+verify: one report, published to the requested path.
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c4.placement --verify-placement -o c4.elf --map=c4.map
# RUN: cmp c2.placement c4.placement

# =====================================================================
# R: report byte protocol (contract §2).  Column order, `SP PIPE SP`,
# `0x`+eight lowercase hex digits, LF, no BOM, decimal enums, `retained`
# only when the MERGED flags carry bit0, rows in decoded (stable, file,
# sym, section) byte order, empty section for bind/manifest sources.
# =====================================================================
# RUN: cat c2.placement | FileCheck %s --check-prefix=REPORT
# REPORT: cl | _cl | {{.*}}p.o | .mcu.fixed.cl | 2 | 0 | 0 | 0x00fc0000 | 4 | 1 | 0 | 0x{{[0-9a-f]+}} | 0
# REPORT: dv | _dv | {{.*}}p.o | .mcu.fixed.dv | 0 | 0 | 0 | 0x00000040 | 4 | 1 | 0 | 0x{{[0-9a-f]+}} | 0
# REPORT: entryf | _entryf | {{.*}}p.o | .mcu.fixed.entryf | 2 | 1 | 0 | 0x00fc4000 | 1 | 4 | 0 | 0x{{[0-9a-f]+}} | 0
# REPORT: nv | _nv | {{.*}}p.o | .mcu.fixed.nv | 0 | 0 | 0 | 0x00000060 | 4 | 1 | 2 | 0x{{[0-9a-f]+}} | 0
# REPORT: rv | _rv | {{.*}}p.o | .mcu.fixed.rv | 0 | 0 | 0 | 0x00000050 | 4 | 1 | 1 | 0x{{[0-9a-f]+}} | 0 | retained
# REPORT: xv | _xv | {{.*}}p.o | .mcu.fixed.xv | 1 | 0 | 0 | 0x00020000 | 4 | 1 | 0 | 0x{{[0-9a-f]+}} | 0
# --- exactly the thirteen columns plus the optional retained marker, no more;
# --- the address and layout_hash columns are `0x` plus EXACTLY eight lowercase
# --- hex digits; size/align/flags are decimal without leading zeros.
# RUN: %python check-report.py c2.placement
# RUN: cat c2.placement | FileCheck %s --check-prefix=REPORTSORT
# REPORTSORT: cl | _cl
# REPORTSORT: dv | _dv
# REPORTSORT: entryf | _entryf
# REPORTSORT: nv | _nv
# REPORTSORT: rv | _rv
# REPORTSORT: xv | _xv
# --- no BOM, no CR, last line terminated by LF.
# RUN: %python check-bytes.py c2.placement
# --- rows are in byte order of the decoded tuple (sorted by the same rule).

# --- determinism: two links produce identical report bytes.
# RUN: mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=c5.placement -o c5.elf --map=c5.map
# RUN: cmp c2.placement c5.placement

# =====================================================================
# E: escaping and the empty contract.  A byte that is not in the frozen safe
# set is `\xHH` with UPPERCASE hex digits; the report never assumes the path
# or the name is UTF-8/ASCII-clean.
# =====================================================================
# RUN: mkdir -p 'sp ace' && cp p.o 'sp ace/a|b\c.o' && cp 'sp ace/a|b\c.o' 'sp ace/[o].o'
# RUN: mcs251-lld 'sp ace/a|b\c.o' --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=esc.placement -o esc.elf --map=esc.map
# RUN: FileCheck %s --check-prefix=ESC < esc.placement
# ESC: dv | _dv | {{.*}}sp\x20ace/a\x7Cb\x5Cc.o | .mcu.fixed.dv |
# --- an empty contract is a ZERO-BYTE report (not a placeholder line), and
# --- the audit still keeps the symtab.
# RUN: llc -mtriple=mcs251 -O0 -filetype=obj -mcs251-object-format=elf plain.ll -o empty.o
# RUN: mcs251-lld empty.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=empty.placement -o empty.elf --map=empty.map
# RUN: %python check-empty.py empty.placement
# RUN: llvm-readelf -S empty.elf | FileCheck %s --check-prefix=HASSYM
# --- the empty contract in the OTHER two CLI cells.  The verifier must not
# --- crash on a zero-byte report (it used to SIGSEGV at the row-order check),
# --- and verify-only must clean up its private report.  Exact exit status 1 is
# --- asserted for the clearly-broken variants, 0 for the good ones.
# RUN: mcs251-lld empty.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=empty-v.placement --verify-placement -o empty-v.elf --map=empty-v.map
# RUN: %python check-empty.py empty-v.placement
# RUN: mcs251-lld empty.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --verify-placement -o empty-o.elf --map=empty-o.map
# RUN: test ! -f empty-o.elf.placement
# RUN: %python %S/Inputs/expect-rc.py 0 mcs251-placement-verify --elf=empty-v.elf --report=empty-v.placement --object=empty.o --link-map=empty-v.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff
# --- a report that is NOT zero bytes while the contract is empty is rejected.
# RUN: printf 'x\n' > bad-empty.placement
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-placement-verify --elf=empty-v.elf --report=bad-empty.placement --object=empty.o --link-map=empty-v.map --flash-base=0xfc0000 --flash-size=0x40000 --area-start=XSEG=0x010000 --edata-end=0x3fff 2>&1 | FileCheck %s --check-prefix=EMPTYB
# EMPTYB: VERIFY FAIL: malformed placement report at line 1: expected 13 columns plus an optional retained marker, got 1

# =====================================================================
# B1: the design's frozen merge-hash fixtures (report-only links).
# =====================================================================
# --- B1a: owned+bind, same A and align.  H_report equals the owned H_source;
# --- the contract explicitly does NOT require the bind hash to equal it.
# RUN: mcs251-lld b1-owned.o b1-bind1.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=b1a.placement -o b1a.elf --map=b1a.map
# RUN: FileCheck %s --check-prefix=B1A < b1a.placement
# B1A: fx | _fx | {{.*}}b1-bind1.o |  | 1 | 0 | 0 | 0x00010000 | 4 | 1 | 0 | 0x457bdcf1 | 0
# B1A: fx | _fx | {{.*}}b1-owned.o | .mcu.fixed.fx | 1 | 0 | 0 | 0x00010000 | 4 | 1 | 0 | 0x457bdcf1 | 0
# --- B1b: retain is owned-authoritative; the merged report carries bit0 and
# --- the bind row is flagged exactly like the owned row.
# RUN: mcs251-lld b1-retain.o b1-bind1.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=b1b.placement -o b1b.elf --map=b1b.map
# RUN: FileCheck %s --check-prefix=B1B < b1b.placement
# B1B: fx | _fx | {{.*}}b1-bind1.o |  | 1 | 0 | 0 | 0x00010000 | 4 | 1 | 1 | 0x6dd2c36a | 0 | retained
# B1B: fx | _fx | {{.*}}b1-retain.o | .mcu.fixed.fx | 1 | 0 | 0 | 0x00010000 | 4 | 1 | 1 | 0x6dd2c36a | 0 | retained
# --- B1c: the align merge.  The link SUCCEEDS, and the report hash is a THIRD
# --- value different from both source hashes (457bdcf1 owned / 396ddf6c bind).
# RUN: mcs251-lld b1-owned.o b1-bind4.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report=b1c.placement -o b1c.elf --map=b1c.map
# RUN: FileCheck %s --check-prefix=B1C < b1c.placement
# B1C: fx | _fx | {{.*}}b1-bind4.o |  | 1 | 0 | 0 | 0x00010000 | 4 | 4 | 0 | 0x3bfcb603 | 0
# B1C: fx | _fx | {{.*}}b1-owned.o | .mcu.fixed.fx | 1 | 0 | 0 | 0x00010000 | 4 | 4 | 0 | 0x3bfcb603 | 0
# B1C-NOT: 0x457bdcf1
# B1C-NOT: 0x396ddf6c

# =====================================================================
# X: the audit options' own rejection surface (contract §1).
# =====================================================================
# RUN: %python %S/Inputs/expect-rc.py 1 mcs251-lld p.o --area-start=HOME=0xff0000 --area-start=VECS=0xff0003 --area-start=BOOT=0xff0100 --area-start=CSEG=0xff0200 --area-start=XINIT=0xff8000 --area-start=XDATA_INIT=0xff9000 --area-start=XSEG=0x010000 --edata-end=0x3fff --flash-base=0xfc0000 --flash-size=0x40000 --placement-report= -o x1.elf 2>&1 | FileCheck %s --check-prefix=XPATH
